,"result":{"tools":[{"name":"batch_edit","title":"Batch Edit","description":"Apply insert/replace operations (max 50) to one file atomically. Targets are line ids (\"12:a3\") from view or edit output, verified before anything is written; a stale id fails with the current content. All targets refer to the original file and must not overlap. The result diff carries fresh ids for follow-up edits — no re-view needed; removed lines, and the middle of a long added block, show as an id range, and a trailing `shift:` line says how later original line numbers moved. Insert anchors 0 (file start) and -1 (end) are plain integers. Content is raw text without id prefixes.","inputSchema":{"$defs":{"BatchEditOperation":{"properties":{"content":{"description":"Raw text to insert or replace with, no line-id prefixes.","type":"string"},"end":{"anyOf":[{"type":"string"},{"type":"integer"}],"description":"`replace` only: last line to replace (inclusive), as a line id. Default: `start`.","examples":["12:a3",-1]},"operation":{"$ref":"#/$defs/BatchEditOperationType","description":"`insert` (after `start`) or `replace` (`start`..`end`)."},"start":{"anyOf":[{"type":"string"},{"type":"integer"}],"description":"Line id in the ORIGINAL file: first line to replace, or the anchor to insert after\n(for `insert` also the integers 0 = file start, -1 = after the last line).","examples":["12:a3",-1]}},"required":["operation","start","content"],"type":"object"},"BatchEditOperationType":{"enum":["insert","replace"],"type":"string"}},"properties":{"operations":{"description":"Operations on this one file (max 50).","items":{"$ref":"#/$defs/BatchEditOperation"},"maxItems":50,"type":"array"},"path":{"description":"File to edit (ssh://user@host:port/path for remote).","type":"string"}},"required":["path","operations"],"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":false}},{"name":"directory_create","title":"Create Workspace Directory","description":"Create a directory tree only inside the configured controller-local workspace. Existing directories succeed without change, while files or symlink components are refused. No command execution, remote host selection, privilege escalation or overwrite. Linux only.","inputSchema":{"properties":{"path":{"description":"Directory path in the configured local controller workspace. Remote paths are refused.","type":"string"}},"required":["path"],"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"directory_move","title":"Move Workspace Directory Without Overwrite","description":"Atomically rename one existing controller-local directory tree inside configured workspace roots to an absent target path. Existing destination, symlinked parents/source, missing destination parent and cross-device moves are refused. This moves an entire directory tree without traversing its entries and removes the original pathname. No shell, remote host, privilege escalation or copy/delete fallback. Linux only; not a transaction with independent writers.","inputSchema":{"properties":{"destination":{"description":"Absent target directory path with an existing authorized parent.","type":"string"},"source":{"description":"Existing controller-local workspace directory, never a symlink or file.","type":"string"}},"required":["source","destination"],"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":false}},{"name":"effective_config","title":"Read Redacted Effective Configuration","description":"Read bounded effective Hepta capabilities and configured host aliases from a strict allowlist projection. Returns authorization switches and counts, never SSH destinations, private paths, credentials, environment values, privileged commands or raw policy. Does not modify configuration; administrator changes require reviewed version-controlled configuration and rollback.","inputSchema":{"additionalProperties":false,"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"execution_shadow_admit","title":"Execution Shadow Admission","description":"Validate and hash a canonical execution_intent v1 against an allowlisted host. Shadow only: never starts a process, grants FinalUse or acknowledges an effect.","inputSchema":{"$defs":{"CanonicalCurrentnessV1":{"enum":["current","stale","unknown"],"type":"string"},"CanonicalExecutionBindingV1":{"additionalProperties":false,"properties":{"candidate_digest":{"type":"string"},"cell_id":{"type":"string"},"currentness":{"$ref":"#/$defs/CanonicalCurrentnessV1"},"final_use":{"$ref":"#/$defs/ShadowFinalUseV1"},"generation":{"minimum":0,"type":"integer"},"host":{"type":"string"},"idempotency_key":{"type":"string"},"objective_digest":{"type":"string"},"operation_id":{"type":"string"},"organ_id":{"type":"string"},"policy_digest":{"type":"string"},"predecessor":{"type":"string"},"principal":{"type":"string"},"rollback_reference":{"type":"string"},"run_id":{"type":"string"},"schema_version":{"minimum":0,"type":"integer"},"turn_id":{"type":"string"}},"required":["schema_version","run_id","turn_id","operation_id","principal","objective_digest","policy_digest","candidate_digest","host","generation","idempotency_key","currentness","final_use"],"type":"object"},"CanonicalExecutionClassV1":{"enum":["read_only_inspection","file_read","non_destructive_build","restricted_file_write","durable_process","privileged_action","cross_host_device"],"type":"string"},"CanonicalExecutionIntentV1":{"additionalProperties":false,"properties":{"binding":{"$ref":"#/$defs/CanonicalExecutionBindingV1"},"class":{"$ref":"#/$defs/CanonicalExecutionClassV1"},"payload_digest":{"type":"string"}},"required":["binding","class","payload_digest"],"type":"object"},"CanonicalExecutionRecordV1":{"additionalProperties":false,"properties":{"kind":{"const":"execution_intent","type":"string"},"record":{"$ref":"#/$defs/CanonicalExecutionIntentV1"}},"required":["kind","record"],"type":"object"},"ShadowFinalUseV1":{"additionalProperties":false,"properties":{"state":{"const":"not_granted","type":"string"}},"required":["state"],"type":"object"}},"additionalProperties":false,"properties":{"record":{"$ref":"#/$defs/CanonicalExecutionRecordV1"}},"required":["record"],"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"file_move","title":"Move Workspace File Without Overwrite","description":"Move one regular file between two configured controller-local workspace paths. Never overwrite an existing destination or follow source/parent symlinks. Requires an existing destination parent and same-device atomic rename support; no copy/delete fallback. This removes the old filename but retains the file inode. Linux only.","inputSchema":{"properties":{"destination":{"description":"Absent destination path with an existing non-symlink parent directory.","type":"string"},"source":{"description":"Existing local ordinary file to move, never a symlink or directory.","type":"string"}},"required":["source","destination"],"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":false}},{"name":"host_list","title":"Host List","description":"List configured runtime host names and their capability flags. SSH destinations and credentials are never accepted from tool input.","inputSchema":{"additionalProperties":false,"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"text_editor","title":"Text Editor","description":"File operations. create: new file only — fails if it exists, parent directories are made. str_replace: raw file text (real newlines, no `N:hh|` prefixes); old_text must match exactly once, or set replace_all: true — on no or multiple matches the error lists candidate line ids for batch_edit. delete: remove a file (not a directory). undo_edit: revert the last edit to `path` (10 levels, delete included). Prefer batch_edit when you already hold line ids.","inputSchema":{"$defs":{"TextEditorCommand":{"enum":["create","str_replace","delete","undo_edit"],"type":"string"}},"properties":{"command":{"$ref":"#/$defs/TextEditorCommand","description":"Operation to perform."},"content":{"description":"Content for `create`.","type":"string"},"new_text":{"description":"`str_replace`: replacement text (required).","type":"string"},"old_text":{"description":"`str_replace`: exact text to find (required).","type":"string"},"path":{"description":"File path (ssh://user@host:port/path for remote).","type":"string"},"replace_all":{"description":"`str_replace`: replace every occurrence (rename-style). Default: false.","type":"boolean"}},"required":["command","path"],"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":false}},{"name":"view","title":"View","description":"Read files, list directories, search content. Lines render as `N:hh|content`; copy `N:hh` verbatim — it is the line id edit tools target. Listings are recursive and gitignore-aware, one `path\tNL\t~Nt` (lines, ~tokens) per file. Re-viewing a whole file returns only the hunks changed since your last view (or an unchanged marker); ranged reads always return the requested lines. Reuse returned content: read a complete block in one call, combine adjacent windows, never re-read overlapping ranges or narrow one just to pick edit targets; re-read only when the file may have changed or output was truncated.","inputSchema":{"properties":{"content":{"description":"Locate code: searches the whole file/tree (`start`/`end` ignored) for a literal\nsubstring, or a Rust regex with `regex: true` (`(?i)` case-insensitive; alternation for\nrelated terms).","type":"string"},"context":{"description":"Lines around each `content` match. Default: 0.","minimum":0,"type":"integer"},"end":{"anyOf":[{"type":"string"},{"type":"integer"}],"description":"Last line (inclusive): line id or integer (negative counts from the end). Default: end\nof file; omit both `start` and `end` for the whole file.","examples":["12:a3",-1]},"full":{"description":"Force the complete file when re-viewing a whole file (normally only changed hunks),\ne.g. after losing earlier context. No effect on ranges or searches; output limits\nunchanged.","type":"boolean"},"include_hidden":{"description":"Include dotfiles and dot-directories.","type":"boolean"},"max_depth":{"description":"Directory depth bound. Default: unlimited, except a bare remote listing (no\n`pattern`/`content`) stops at the root entries. Searches walk the whole tree.","minimum":0,"type":"integer"},"path":{"description":"File or directory. `a|b` searches several roots with `content` (max 32); several\nfiles take parallel view calls. Remote: ssh://[user@]host[:port]/path (host may be an\n~/.ssh/config alias; `ssh://host` or `ssh://host/~/dir` is the login home).","type":"string"},"pattern":{"description":"Ripgrep -g globs bounding listings and searches: without `/` a name at any depth,\nwith `/` the relative path; `*`, `**`, `?`, `[abc]`, `{rs,toml}`, leading `!`; `|`\njoins ordered globs (later wins), e.g. `**/*.rs|!target/**`. Applied after\ngitignore/hidden filtering; one line, max 4096 bytes, 64 globs.","type":"string"},"regex":{"description":"Treat `content` as a regex. Default: false.","type":"boolean"},"start":{"anyOf":[{"type":"string"},{"type":"integer"}],"description":"First line (inclusive): line id or integer (negative counts from the end, -1 = last).\nDefault: line 1.","examples":["12:a3",-1]}},"required":["path"],"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"weight_bellman_plan","title":"Plan a Bounded Finite-DAG Value Policy","description":"Compute Q values and first-maximum actions for a caller-declared finite DAG in Rust. At most 4096 topologically ordered states, six fixed action slots, two continuing actions per state and three branches per action. Keeps each fee and reward inside the ordered branch multiplication, skips zero probabilities, and never normalizes probabilities. Reports numerical consistency and tie diagnostics, canonical request and implementation identities, and bounded work. No file access, parameter editing, verification of the true environment law or checkpoint, real-arithmetic certificate, held-out task-value claim, or production activation.","inputSchema":{"$defs":{"BellmanAction":{"oneOf":[{"additionalProperties":false,"properties":{"kind":{"const":"terminal","type":"string"},"value":{"description":"Explicit finite terminal value, in the caller's declared value units.","type":"number"}},"required":["kind","value"],"type":"object"},{"additionalProperties":false,"properties":{"branches":{"description":"One to three ordered branches. Nonnegative probabilities must sum to\none within 1e-12 in sequential F64 arithmetic; no renormalization.","items":{"$ref":"#/$defs/BellmanBranch"},"type":"array"},"kind":{"const":"continue","type":"string"}},"required":["kind","branches"],"type":"object"}]},"BellmanBranch":{"additionalProperties":false,"properties":{"fee":{"description":"Finite, nonnegative cost. It stays inside the branch multiplication.","type":"number"},"probability":{"type":"number"},"reward":{"type":"number"},"successor":{"description":"Strictly less than the index of the state containing this action.","minimum":0,"type":"integer"}},"required":["probability","successor","reward","fee"],"type":"object"},"BellmanState":{"additionalProperties":false,"properties":{"actions":{"description":"STOP, WAIT, READ, REPAIR, SUBMIT_0, SUBMIT_1. Null is illegal. At least one\naction is legal; at most two actions may continue to earlier states.","items":{"$ref":"#/$defs/BellmanAction"},"maxItems":6,"minItems":6,"type":"array"}},"required":["actions"],"type":"object"}},"additionalProperties":false,"properties":{"states":{"description":"Nonempty finite DAG, at most 4096 states, with every child before its parent.","items":{"$ref":"#/$defs/BellmanState"},"type":"array"}},"required":["states"],"type":"object"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"workdir","title":"Working Directory","description":"Switch the working directory for later calls (`path`) or revert to the session root (`reset: true`). Every tool resolves relative paths against it; do not call it just to check the directory. A remote (ssh://) workdir disables `shell`.","inputSchema":{"properties":{"path":{"description":"Directory to switch into, absolute or relative to the current workdir; required unless\n`reset`. Not `\".\"` (a no-op). Remote: ssh://user@host:port/path; `ssh://host` or\n`ssh://host/~/dir` is the login home.","type":"string"},"reset":{"description":"Revert to the session root.","type":"boolean"}},"type":"object"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}}]}}