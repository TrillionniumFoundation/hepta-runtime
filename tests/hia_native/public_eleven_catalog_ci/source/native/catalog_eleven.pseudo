def target_size(mode: u64) -> u64:
    if mode == 0: return 15202
    return 15258
def target_literal(out: mutbuf, p: u64, mode: u64, w: mutbuf) -> u64:
    if mode == 0:
        p = prefix0(out, p)
    else:
        p = prefix1(out, p)
    load_table(w)
    return decode(out, p, w)
def decode(out: mutbuf, p: u64, w: mutbuf) -> u64:
    i = 0
    while i < 6956:
        tag = byte(w, i)
        i = i + 1
        if tag < 128:
            count = tag + 1
            j = 0
            while j < count:
                store(out, p, byte(w, i))
                p = p + 1
                i = i + 1
                j = j + 1
        else:
            distance = byte(w, i) | (byte(w, i + 1) << 8)
            i = i + 2
            count = (tag & 127) + 3
            j = 0
            while j < count:
                store(out, p, byte(out, p - distance))
                p = p + 1
                j = j + 1
    return p
def prefix0(w: mutbuf, p: u64) -> u64:
    put(w, p + 0, 8389209344368058924)
    store(w, p + 8, 34)
    store(w, p + 9, 58)
    store(w, p + 10, 123)
    return p + 11
