def get_mut(w:mutbuf, at:u64) -> u64:
    value = 0
    value = value | (byte(w, at + 0) << 0)
    value = value | (byte(w, at + 1) << 8)
    value = value | (byte(w, at + 2) << 16)
    value = value | (byte(w, at + 3) << 24)
    value = value | (byte(w, at + 4) << 32)
    value = value | (byte(w, at + 5) << 40)
    value = value | (byte(w, at + 6) << 48)
    value = value | (byte(w, at + 7) << 56)
    return value

def get_read(w:readbuf, at:u64) -> u64:
    value = 0
    value = value | (byte(w, at + 0) << 0)
    value = value | (byte(w, at + 1) << 8)
    value = value | (byte(w, at + 2) << 16)
    value = value | (byte(w, at + 3) << 24)
    value = value | (byte(w, at + 4) << 32)
    value = value | (byte(w, at + 5) << 40)
    value = value | (byte(w, at + 6) << 48)
    value = value | (byte(w, at + 7) << 56)
    return value

def put_mut(w:mutbuf, at:u64, value:u64) -> u64:
    store(w, at + 0, value & 255)
    value = value >> 8
    store(w, at + 1, value & 255)
    value = value >> 8
    store(w, at + 2, value & 255)
    value = value >> 8
    store(w, at + 3, value & 255)
    value = value >> 8
    store(w, at + 4, value & 255)
    value = value >> 8
    store(w, at + 5, value & 255)
    value = value >> 8
    store(w, at + 6, value & 255)
    value = value >> 8
    store(w, at + 7, value & 255)
    value = value >> 8
    return 0
