def entry(s: readbuf, o: mutbuf, w: mutbuf) -> u32:
    if length(s) < 134:
        return 4294967295
    if load(s, 0) != 3544430008776279368:
        return 4294967295
    index = 0
    total = 0
    while index < 14:
        size = load(s, 8 + index * 8)
        if size == 0 or size > 1048576:
            return 4294967295
        total = total + size
        index = index + 1
    if total != length(s) - 120:
        return 4294967295
    needed = 15264 + total
    if length(o) < needed:
        return 4294967294
    literal_0(o)
    literal_1(o)
    literal_2(o)
    literal_3(o)
    literal_4(o)
    literal_5(o)
    literal_6(o)
    literal_7(o)
    put(o, 96, needed)
    put(o, 104, needed)
    copy_range(o, s, 15152, 8, 112)
    copy_range(o, s, 15264, 120, total)
    return needed

