name: Author typed CustomRequest protocol successor
on:
  workflow_dispatch:
  push:
    branches: ['hia-extract-public-6780-20261116']
    paths: ['tests/hia_native/public118_custom_request_author_ci/**', '.github/workflows/hia-extract-public-custom-author.yml']
permissions:
  contents: read
env:
  PYTHONDONTWRITEBYTECODE: '1'
  PYTHONHASHSEED: '0'
  LC_ALL: C.UTF-8
jobs:
  source:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - name: Checkout exact new author
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          path: package
          ref: ${{ github.sha }}
          persist-credentials: false
          sparse-checkout: tests/hia_native/public118_custom_request_author_ci
      - name: Checkout the complete qualified 432 source baseline
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          path: baseline
          ref: ee25e2eb24553d67d92c285900d1ff2655cd69c1
          persist-credentials: false
          sparse-checkout: tests/hia_native/public118_extract_repaired_ci/graph/source
      - name: Checkout exact Hepta authoring AST support
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          repository: TrillionniumFoundation/Hepta
          path: hepta
          ref: d3e2c90173cf733e42b299d0c4274df4b593a12f
          persist-credentials: false
          sparse-checkout: |
            hepta
            tools
      - name: Author and reproduce the complete source without executing language semantics
        run: |
          python3 -I -S -B "$GITHUB_WORKSPACE/package/tests/hia_native/public118_custom_request_author_ci/run.py" --baseline "$GITHUB_WORKSPACE/baseline/tests/hia_native/public118_extract_repaired_ci/graph/source" --hepta "$GITHUB_WORKSPACE/hepta" --output "$RUNNER_TEMP/typed-custom-source" --profile '@PROFILE@'
      - name: Preserve complete source checkpoint and structural proof
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: extract-typed-custom-source-${{ github.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/typed-custom-source
          if-no-files-found: error
          compression-level: 6
          retention-days: 30
