def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(s)<26:
        return INVALID
    if load(s,0)!=REQUEST or load(s,8)!=length(s)-24 or load(s,16)!=0:
        return INVALID
    if byte(s,24)!=123 or byte(s,length(s)-1)!=125:
        return INVALID
    if length(o)<128:
        return CAPACITY
    if length(s)>MAXIMUM-65536:
        return header(o,4,MAXIMUM,0,0,0,0,0)
    needed=length(s)+65536
    if length(w)<needed:
        return header(o,2,needed,0,0,0,0,0)
    fill_range(w,0,1024,0)
    fill_range(w,META,128,0)
    if skip_value(s,w,24)!=length(s):
        return INVALID
    status=project(s,w)
    if status==MAXIMUM:
        return INVALID
    if status!=0:
        unicode_table(w)
        put(w,48,0)
        put(w,112,0)
        put(w,120,0)
        error(s,w,o,status)
        size=get(w,120)
        if get(w,48)!=0 or size>MAXIMUM-128:
            return header(o,4,MAXIMUM,0,0,0,0,0)
        if size+128>length(o):
            return header(o,3,size+128,0,0,0,0,0)
        header(o,1,0,0,0,0,0,size)
        put(w,112,1)
        put(w,120,128)
        error(s,w,o,status)
        return 128
    path_size=get(w,META+24)
    content_size=get(w,META+56)
    expected_size=get(w,META+72)
    if path_size>MAXIMUM-128:
        return header(o,4,MAXIMUM,0,0,0,0,0)
    total=128+path_size
    if content_size>MAXIMUM-total:
        return header(o,4,MAXIMUM,0,0,0,0,0)
    total=total+content_size
    if expected_size>MAXIMUM-total:
        return header(o,4,MAXIMUM,0,0,0,0,0)
    total=total+expected_size
    if total>length(o):
        return header(o,3,total,0,0,0,0,0)
    header(o,0,0,get(w,800),path_size,content_size,expected_size,0)
    copy_string(s,w,o,get(w,META+16),128)
    copy_string(s,w,o,get(w,META+48),128+path_size)
    copy_string(s,w,o,get(w,META+64),128+path_size+content_size)
    return 128

def project(s:readbuf,w:mutbuf) -> u64:
    at=25
    present=0
    while at<length(s)-1:
        if byte(s,at)!=34:
            return MAXIMUM
        key=at
        end=string_info(s,w,at)
        if end==MAXIMUM or end>=length(s) or byte(s,end)!=58:
            return MAXIMUM
        field=field_key(s,key,end)
        if field==0:
            put(w,88,key)
            return 24
        bit=1<<field
        if (present&bit)!=0:
            return MAXIMUM
        present=present|bit
        start=end+1
        end=skip_value(s,w,start)
        if end==MAXIMUM or end>=length(s):
            return MAXIMUM
        if field==2:
            result=enum_project(s,w,start,end)
            if result!=0:
                return result
        else:
            if byte(s,start)!=34:
                put(w,88,start)
                put(w,96,5)
                return 10
            if string_info(s,w,start)!=end:
                return MAXIMUM
            put(w,META+field*16,start)
            put(w,META+field*16+8,get(w,16))
        if byte(s,end)==125:
            if end!=length(s)-1:
                return MAXIMUM
            at=end
        else:
            if byte(s,end)!=44:
                return MAXIMUM
            at=end+1
            if at>=length(s)-1:
                return MAXIMUM
    if at!=length(s)-1:
        return MAXIMUM
    if (present&2)==0:
        return 20
    if (present&4)==0:
        return 21
    if (present&8)==0:
        return 22
    if (present&16)==0:
        return 23
    return 0

def enum_kind(s:readbuf,w:mutbuf,at:u64) -> u64:
    kind=1
    while kind<=3:
        cursor=at+1
        index=0
        matching=1
        while matching!=0:
            value=unit(s,w,cursor)
            cursor=get(w,0)
            expected=enum_byte(kind,index)
            if expected==256:
                if value==1114112:
                    return kind
                matching=0
            else:
                if value!=expected:
                    matching=0
            index=index+1
        kind=kind+1
    return 0

def error(s:readbuf,w:mutbuf,o:mutbuf,code:u64) -> u64:
    if code==22:
        return literal(w,o,12)
    if code==23:
        return literal(w,o,13)
    if code==24:
        literal(w,o,14)
        at=get(w,88)+1
        while at<length(s):
            value=unit(s,w,at)
            at=get(w,0)
            if value==1114112:
                return literal(w,o,15)
            emit_scalar(w,o,value)
        return 0
    return retained_error(s,w,o,code)

def header(o:mutbuf,status:u64,needed:u64,mode:u64,path_size:u64,content_size:u64,expected_size:u64,error_size:u64) -> u32:
    fill_range(o,0,128,0)
    put(o,0,RESPONSE)
    put(o,8,status)
    put(o,16,mode)
    put(o,24,path_size)
    put(o,32,content_size)
    put(o,40,expected_size)
    put(o,72,error_size)
    put(o,80,needed)
    return 128
