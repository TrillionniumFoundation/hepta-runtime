def worker_pool(s:readbuf, o:mutbuf, w:mutbuf) -> u32:
    if length(s) != 64 or read64(s, 0) != REQUEST_MAGIC:
        return 4294967295
    if read64(s, 40) != 0 or read64(s, 48) != 0 or read64(s, 56) != 0:
        return 4294967295
    command = read64(s, 8)
    job = read64(s, 16)
    now = read64(s, 24)
    argument = read64(s, 32)
    if command > 14:
        return 4294967295
    if command != 4 and command != 5 and command != 14 and now != 0:
        return 4294967295
    if command != 0 and command != 5 and command != 13 and command != 14 and argument != 0:
        return 4294967295
    if command == 0 or command == 1 or command == 2 or command == 11 or command == 12:
        if job != 0:
            return 4294967295
    else:
        if job == 0:
            return 4294967295
    if command == 0:
        if argument == 0:
            return 4294967295
    else:
        if argument > 4294967295:
            return 4294967295
    if length(o) < 320 or length(w) < 192:
        return 4294967294
    if command == 0:
        at = 0
        while at < 192:
            if get(w, at) != 0:
                return 4294967295
            at = at + 8
        put(w, 0, STATE_MAGIC)
        put(w, 24, argument)
        put(w, 120, 192)
        return response(o, w, command, 0, 0, 0)
    if valid_pool(w) == False:
        return 4294967295
    if command == 12:
        return response(o, w, command, 0, 0, 0)
    if command == 11:
        put(w, 16, 1)
        return response(o, w, command, 0, 0, 0)
    if command == 1:
        if get(w, 16) != 0:
            return response(o, w, command, 0, 0, 1)
        if get(w, 8) == 18446744073709551615:
            return response(o, w, command, 0, 0, 4)
        at = 192
        while at < get(w, 120) and get(w, at) != 0:
            at = at + 128
        if at == get(w, 120):
            if at > 18446744073709551487:
                return response(o, w, command, 0, 0, 4)
            if length(w) - at < 128:
                put(o, 0, GROW_MAGIC)
                put(o, 8, 1)
                put(o, 16, at + 128)
                put(o, 24, 0)
                return 4294967248
            clear_record(w, at)
            put(w, 120, at + 128)
        job = get(w, 8) + 1
        put(w, 8, job)
        put(w, at, job)
        put(w, at + 8, 1)
        put(w, 40, get(w, 40) + 1)
        return response(o, w, command, job, at, 0)
    if command == 2:
        if get(w, 32) >= get(w, 24):
            return response(o, w, command, 0, 0, 3)
        at = oldest_queued(w)
        if at == 0:
            return response(o, w, command, 0, 0, 3)
        job = get(w, at)
        put(w, at + 8, 2)
        put(w, 32, get(w, 32) + 1)
        put(w, 48, get(w, 48) + 1)
        return response(o, w, command, job, at, 0)
    at = find(w, job)
    if at == 0:
        return 4294967295
    phase = get(w, at + 8)
    caller = get(w, at + 16)
    if command == 3:
        if phase != 2:
            return 4294967295
        put(w, at + 8, 3)
        put(w, at + 72, 1)
        put(w, 56, get(w, 56) + 1)
        return response(o, w, command, job, at, 0)
    if command == 4:
        if phase != 3:
            return 4294967295
        put(w, at + 8, 4)
        put(w, at + 32, now)
        put(w, at + 64, 1)
        put(w, 64, get(w, 64) + 1)
        return response(o, w, command, job, at, 0)
    if command == 5:
        if phase != 4 or now < get(w, at + 32):
            return 4294967295
        put(w, at + 8, 5)
        put(w, at + 40, now)
        put(w, at + 48, argument)
        put(w, 32, get(w, 32) - 1)
        put(w, 72, get(w, 72) + 1)
        return response(o, w, command, job, at, 0)
    if command == 6:
        if caller > 1:
            return 4294967295
        if caller == 0:
            put(w, at + 16, 1)
            put(w, 80, get(w, 80) + 1)
        code = response(o, w, command, job, at, 0)
        retire_then_update(o, w, at)
        return code
    if command == 7:
        if caller != 0:
            return 4294967295
        if phase == 5:
            return response(o, w, command, job, at, 0)
        return response(o, w, command, job, at, 2)
    if command == 8:
        if caller != 0:
            return 4294967295
        if phase != 5:
            return response(o, w, command, job, at, 2)
        put(w, at + 16, 2)
        put(w, 88, get(w, 88) + 1)
        return response(o, w, command, job, at, 0)
    if command == 9:
        if phase != 5 or caller != 2:
            return 4294967295
        put(w, at + 16, 3)
        put(w, 96, get(w, 96) + 1)
        code = response(o, w, command, job, at, 0)
        retire_then_update(o, w, at)
        return code
    if command == 10:
        if phase != 5 or get(w, at + 24) != 0:
            return 4294967295
        put(w, at + 24, 1)
        put(w, 104, get(w, 104) + 1)
        code = response(o, w, command, job, at, 0)
        retire_then_update(o, w, at)
        return code
    if command == 13:
        if phase != 2 or argument == 0 or argument > 4095:
            return 4294967295
        put(w, at + 8, 5)
        put(w, at + 24, 1)
        put(w, at + 48, argument)
        put(w, at + 56, 1)
        put(w, 32, get(w, 32) - 1)
        put(w, 72, get(w, 72) + 1)
        put(w, 104, get(w, 104) + 1)
        put(w, 128, get(w, 128) + 1)
        code = response(o, w, command, job, at, 5)
        retire_then_update(o, w, at)
        return code
    if command == 14:
        if phase != 3 and phase != 4:
            return 4294967295
        if argument == 0 or now < get(w, at + 32):
            return 4294967295
        if phase == 3:
            put(w, 144, get(w, 144) + 1)
        put(w, at + 8, 5)
        put(w, at + 24, 1)
        put(w, at + 40, now)
        put(w, at + 48, argument)
        put(w, at + 56, 2)
        put(w, 32, get(w, 32) - 1)
        put(w, 72, get(w, 72) + 1)
        put(w, 104, get(w, 104) + 1)
        put(w, 136, get(w, 136) + 1)
        code = response(o, w, command, job, at, 5)
        retire_then_update(o, w, at)
        return code
    return 4294967295

def valid_pool(w:mutbuf) -> bool:
    if get(w, 0) != STATE_MAGIC or get(w, 16) > 1 or get(w, 24) == 0:
        return False
    used = get(w, 120)
    if used < 192 or used > length(w) or ((used - 192) & 127) != 0:
        return False
    at = 152
    while at < 192:
        if get(w, at) != 0:
            return False
        at = at + 8
    last = get(w, 8)
    at = 32
    while at < 152:
        if at != 120 and get(w, at) > last:
            return False
        at = at + 8
    if get(w, 32) > get(w, 24) or get(w, 144) > get(w, 136):
        return False
    live = 0
    queued = 0
    reserved = 0
    admitted = 0
    running = 0
    consumed = 0
    borrowed = 0
    released = 0
    reaped = 0
    at = 192
    while at < used:
        if valid_record(w, at, last) == False:
            return False
        job = get(w, at)
        if job != 0:
            if unique_before(w, at, job) == False:
                return False
            live = live + 1
            phase = get(w, at + 8)
            if phase == 1:
                queued = queued + 1
            if phase == 2:
                reserved = reserved + 1
            if phase == 3:
                admitted = admitted + 1
            if phase == 4:
                running = running + 1
            caller = get(w, at + 16)
            if caller != 0:
                consumed = consumed + 1
            if caller == 2:
                borrowed = borrowed + 1
            if caller == 1 or caller == 3:
                released = released + 1
            reaped = reaped + get(w, at + 24)
        at = at + 128
    active = reserved + admitted + running
    if live != get(w, 40) or active != get(w, 32) or last - get(w, 112) != live:
        return False
    if queued > last - active or get(w, 72) != last - active - queued:
        return False
    if get(w, 48) != last - queued:
        return False
    if reserved > get(w, 48) or get(w, 128) > get(w, 48) - reserved:
        return False
    if get(w, 56) != get(w, 48) - reserved - get(w, 128):
        return False
    if admitted > get(w, 56) or get(w, 144) > get(w, 56) - admitted:
        return False
    if get(w, 64) != get(w, 56) - admitted - get(w, 144):
        return False
    if get(w, 128) > get(w, 72) or get(w, 144) > get(w, 72) - get(w, 128):
        return False
    if get(w, 64) != get(w, 72) - get(w, 128) - get(w, 144) + running:
        return False
    if get(w, 136) > get(w, 72) - get(w, 128):
        return False
    if get(w, 104) != get(w, 112) + reaped:
        return False
    if get(w, 80) > last - get(w, 88) or get(w, 112) > last - consumed:
        return False
    if get(w, 80) + get(w, 88) != get(w, 112) + consumed:
        return False
    if get(w, 96) > get(w, 88) or get(w, 88) - get(w, 96) != borrowed:
        return False
    if get(w, 80) + get(w, 96) != get(w, 112) + released:
        return False
    return True

def valid_record(w:mutbuf, at:u64, last:u64) -> bool:
    job = get(w, at)
    if job == 0:
        n = 0
        while n < 128:
            if get(w, at + n) != 0:
                return False
            n = n + 8
        return True
    if job > last:
        return False
    phase = get(w, at + 8)
    caller = get(w, at + 16)
    reaped = get(w, at + 24)
    begun = get(w, at + 64)
    admitted = get(w, at + 72)
    if phase < 1 or phase > 5 or caller > 3 or reaped > 1 or begun > 1 or admitted > 1:
        return False
    n = 80
    while n < 128:
        if get(w, at + n) != 0:
            return False
        n = n + 8
    if phase < 5:
        if caller > 1 or reaped != 0 or get(w, at + 40) != 0 or get(w, at + 48) != 0 or get(w, at + 56) != 0:
            return False
        if phase < 3:
            return admitted == 0 and begun == 0 and get(w, at + 32) == 0
        if phase == 3:
            return admitted == 1 and begun == 0 and get(w, at + 32) == 0
        return admitted == 1 and begun == 1
    if get(w, at + 48) > 4294967295 or get(w, at + 56) > 2:
        return False
    if reaped == 1 and (caller == 1 or caller == 3):
        return False
    reason = get(w, at + 56)
    if reason == 1:
        if get(w, at + 32) != 0 or get(w, at + 40) != 0 or reaped != 1 or begun != 0 or admitted != 0:
            return False
        return get(w, at + 48) > 0 and get(w, at + 48) <= 4095
    if admitted != 1 or get(w, at + 40) < get(w, at + 32):
        return False
    if reason == 2:
        if reaped != 1 or get(w, at + 48) == 0:
            return False
        return begun == 1 or get(w, at + 32) == 0
    return begun == 1

def oldest_queued(w:mutbuf) -> u64:
    found = 0
    best = 0
    at = 192
    while at < get(w, 120):
        if get(w, at) != 0 and get(w, at + 8) == 1:
            job = get(w, at)
            if found == 0 or job < best:
                found = at
                best = job
        at = at + 128
    return found

def unique_before(w:mutbuf, stop:u64, job:u64) -> bool:
    at = 192
    while at < stop:
        if get(w, at) == job:
            return False
        at = at + 128
    return True

def find(w:mutbuf, job:u64) -> u64:
    at = 192
    while at < get(w, 120):
        if get(w, at) == job:
            return at
        at = at + 128
    return 0

def clear_record(w:mutbuf, at:u64) -> u64:
    n = 0
    while n < 128:
        put(w, at + n, 0)
        n = n + 8
    return 0

def retire_if_finished(w:mutbuf, at:u64) -> u64:
    caller = get(w, at + 16)
    if get(w, at + 8) == 5 and get(w, at + 24) == 1 and (caller == 1 or caller == 3):
        clear_record(w, at)
        put(w, 40, get(w, 40) - 1)
        put(w, 112, get(w, 112) + 1)
    return 0

def retire_then_update(o:mutbuf, w:mutbuf, at:u64) -> u64:
    retire_if_finished(w, at)
    n = 0
    while n < 192:
        put(o, 128 + n, get(w, n))
        n = n + 8
    return 0

def response(o:mutbuf, w:mutbuf, command:u64, job:u64, at:u64, status:u64) -> u64:
    put(o, 0, RESULT_MAGIC)
    put(o, 8, 320)
    put(o, 16, status)
    put(o, 24, command)
    put(o, 32, job)
    n = 40
    while n < 128:
        put(o, n, 0)
        n = n + 8
    if at != 0:
        put(o, 40, get(w, at + 8))
        put(o, 48, get(w, at + 16))
        put(o, 56, get(w, at + 24))
        put(o, 64, get(w, at + 32))
        put(o, 72, get(w, at + 40))
        put(o, 80, get(w, at + 48))
        put(o, 88, get(w, at + 56))
        put(o, 96, at)
        put(o, 104, get(w, at + 64))
        put(o, 112, get(w, at + 72))
    n = 0
    while n < 192:
        put(o, 128 + n, get(w, n))
        n = n + 8
    return 320

def read64(s:readbuf, at:u64) -> u64:
    return 0

def get(w:mutbuf, at:u64) -> u64:
    return 0

def put(w:mutbuf, at:u64, value:u64) -> u64:
    return 0
