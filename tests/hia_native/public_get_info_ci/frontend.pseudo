def catalog(s:readbuf,o:mutbuf,w:mutbuf,operation:u64,argument:u64,extra:u64) -> u32:
    if operation!=2:
        return baseline_catalog(s,o,w,operation,argument,extra)
    if argument<1 or argument>4 or extra!=0:
        return INVALID
    put(w,120,operation)
    put(w,128,argument)
    put(w,144,extra)
    return prepare_get_info(s,o,w)

def prepare(s:readbuf,o:mutbuf,w:mutbuf,phase:u64) -> u32:
    if phase==12:
        return prepare_get_info(s,o,w)
    return baseline_prepare(s,o,w,phase)

def prepare_get_info(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    put(w,8,112)
    if reserve(w,0,32)==0:
        return pending_grow(o,w)
    if reserve(w,1,64)==0:
        return pending_grow(o,w)
    at=region(w,0)
    put(w,at,INFO_REQUEST)
    put(w,at+8,1)
    put(w,at+16,0)
    put(w,at+24,0)
    return child(w,11,32,12)

def after_get_info(s:readbuf,o:mutbuf,w:mutbuf,returned:u64,extent:u64) -> u32:
    if returned!=64 or extent<96:
        return INVALID
    at=region(w,1)
    if get(w,at)!=INFO_RESPONSE or get(w,at+8)!=0 or get(w,at+16)!=1:
        return INVALID
    if get(w,at+24)!=0 or get(w,at+32)!=64 or get(w,at+48)!=0 or get(w,at+56)!=0:
        return INVALID
    size=get(w,at+40)
    if size!=extent-64:
        return INVALID
    if get(w,at+64)!=INFO_PREFIX_0 or get(w,at+72)!=INFO_PREFIX_1:
        return INVALID
    if get(w,at+80)!=INFO_PREFIX_2 or get(w,at+88)!=INFO_PREFIX_3:
        return INVALID
    version=get(w,128)
    if get(w,120)!=2 or version<1 or version>4:
        return INVALID
    return get_info_envelope(s,o,w,size)

def get_info_envelope(s:readbuf,o:mutbuf,w:mutbuf,wire_size:u64) -> u32:
    original=region(w,2)
    id_kind=get(w,original+40)
    id_size=4
    if id_kind==3:
        id_size=get(w,original+48)
    elif id_kind==4:
        id_size=json_size(w,original+192,get(w,original+48))
    if id_size>18446744073709551487:
        return request_grow(o,w,3,0)
    fixed=literal_size(1)+id_size+10+1
    if wire_size>18446744073709551615-fixed:
        return request_grow(o,w,3,0)
    total=fixed+wire_size
    if reserve(w,7,total)==0:
        return pending_grow(o,w)
    start=region(w,7)
    out=start+literal(w,start,1)
    original=region(w,2)
    if id_kind==3:
        copy_within(w,out,original+192,get(w,original+48))
        out=out+get(w,original+48)
    elif id_kind==4:
        out=json_write(w,out,original+192,get(w,original+48))
    else:
        out=out+literal(w,out,7)
    out=result_key(w,out)
    info=region(w,1)+64
    copy_within(w,out,info,20)
    out=negotiated_version(w,out+20,get(w,128))
    copy_within(w,out,info+30,wire_size-30)
    out=out+wire_size-30
    store(w,out,125)
    if out+1!=start+total:
        return INVALID
    put(w,64,2)
    put(w,184,0)
    return finish(o,w,3,total,0,0)
