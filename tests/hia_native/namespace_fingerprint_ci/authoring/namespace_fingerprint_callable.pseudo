    put64(o,3232,8972096246512509060)
    put64(o,3240,18446298252061050916)
    put64(o,3248,1080916843834853887)
    put64(o,3256,8972096246512508549)
    put64(o,3264,18446271855208656932)
    put64(o,3272,1080996008672053759)
    put64(o,3280,16683950956965938821)
    put64(o,3288,17509995419948138545)
    put64(o,3296,18446250297428912968)
    put64(o,3304,2149519359)
    return 0

def read64(s:readbuf,at:u64) -> u64:
    return byte(s,at)|(byte(s,at+1)<<8)|(byte(s,at+2)<<16)|(byte(s,at+3)<<24)|(byte(s,at+4)<<32)|(byte(s,at+5)<<40)|(byte(s,at+6)<<48)|(byte(s,at+7)<<56)

def put64(o:mutbuf,at:u64,value:u64) -> u64:
    store(o,at+0,(value>>0)&255)
    store(o,at+1,(value>>8)&255)
    store(o,at+2,(value>>16)&255)
    store(o,at+3,(value>>24)&255)
    store(o,at+4,(value>>32)&255)
    store(o,at+5,(value>>40)&255)
    store(o,at+6,(value>>48)&255)
    store(o,at+7,(value>>56)&255)
    return 0
