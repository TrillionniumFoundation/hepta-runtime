def entry(s: readbuf, o: mutbuf, w: mutbuf) -> u32:
    if length(o) < 32:
        return CAPACITY
    if length(w) < 4096:
        return request_grow(o, w, 1, 4096)
    if valid_input(s) == False:
        return INVALID
    if get(w, 0) == 0:
        fill_range(w, 0, 1024, 0)
        put(w, 0, STATE_MAGIC)
        put(w, 384, 4096)
    if get(w, 0) != STATE_MAGIC:
        return INVALID
    phase = get(w, PHASE)
    if phase == 0:
        put(w, INPUT_LENGTH, length(s))
        put(w, OUTPUT_LENGTH, length(o))
        put(w, WORK_LENGTH, length(w))
        put(w, 64, load(s, 8))
        put(w, 72, load(s, 16))
        put(w, 80, 0)
        put(w, 88, 0)
        put(w, 96, 0)
        put(w, 104, 0)
        put(w, PHASE, 100)
        return capture(s, o, w)
    if get(w, INPUT_LENGTH) != length(s) or get(w, 64) != load(s, 8) or get(w, 72) != load(s, 16):
        return INVALID
    if admit_growth(o, w) == False:
        return INVALID
    if phase == 100:
        return capture(s, o, w)
    if input_equal(s, w) == False:
        return INVALID
    if phase == 99:
        return finish(o, w, get(w, 176), get(w, 184), get(w, 192))
    if phase >= 101 and phase <= 106:
        return prepare(o, w, phase - 100)
    if phase < 1 or phase > 6:
        return INVALID
    if valid_reply(w) == False:
        return INVALID
    code = get(w, ACTION + 72)
    if code == DELIVERY:
        return delivery_again(o, w)
    size = get(w, ACTION + 96)
    if code == CANCELLED and size == 0:
        put(w, PHASE, 0)
        return CANCELLED
    if code >= FIRST_ERROR:
        put(w, PHASE, 0)
        return code
    if size > region_capacity(w, 1):
        return INVALID
    if phase == 1:
        return after_params(o, w, code, size)
    if phase == 2:
        return after_plan(o, w, code, size)
    if phase == 3:
        return after_config(o, w, code, size)
    if phase == 4:
        return after_host(o, w, code, size)
    if phase == 5:
        return after_files(o, w, code, size)
    return after_transport(o, w, code, size)

def valid_input(s: readbuf) -> bool:
    if length(s) < 48 or load(s, 0) != REQUEST_MAGIC:
        return False
    kind = load(s, 8)
    if kind < 1 or kind > 2 or load(s, 16) > 1:
        return False
    if load(s, 24) != length(s) - 48 or load(s, 32) != 0 or load(s, 40) != 0:
        return False
    return True

def capture(s: readbuf, o: mutbuf, w: mutbuf) -> u32:
    if reserve(w, 6, length(s)) == 0:
        return pending_grow(o, w)
    copy_range(w, s, region(w, 6), 0, length(s))
    put(w, PHASE, 101)
    return prepare(o, w, 1)

def input_equal(s: readbuf, w: mutbuf) -> bool:
    at = region(w, 6)
    if at < 4096 or at > length(w) or length(s) > length(w) - at:
        return False
    i = 0
    while i < length(s):
        if byte(s, i) != byte(w, at + i):
            return False
        i = i + 1
    return True

def valid_reply(w: mutbuf) -> bool:
    if get(w, ACTION) != ACTION_MAGIC or get(w, ACTION + 8) != get(w, SEQUENCE) or get(w, ACTION + 64) != get(w, SEQUENCE):
        return False
    if get(w, ACTION + 16) != get(w, 48) or get(w, ACTION + 24) > 1 or get(w, ACTION + 32) != region(w, 0):
        return False
    if get(w, ACTION + 40) != get(w, 56) or get(w, ACTION + 48) != region(w, 1) or get(w, ACTION + 56) != region_capacity(w, 1):
        return False
    if get(w, ACTION + 80) != 0 or get(w, ACTION + 88) != 0 or get(w, ACTION + 104) != 0:
        return False
    return True

def after_params(o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != 256 or size < 256 or get(w, at) != TYPED_RESULT or get(w, at + 16) != get(w, 64):
        return INVALID
    i = 152
    while i < 256:
        if get(w, at + i) != 0:
            return INVALID
        i = i + 8
    status = get(w, at + 8)
    if status == 1:
        i = 24
        while i < 152:
            if i != 72 and get(w, at + i) != 0:
                return INVALID
            i = i + 8
        if get(w, at + 72) != size - 256:
            return INVALID
        return finish(o, w, 2, at + 256, size - 256)
    if status != 0 or get(w, at + 72) != 0 or get(w, at + 80) != 0:
        return INVALID
    if reserve(w, 2, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 2), at, size)
    put(w, 88, size)
    put(w, PHASE, 102)
    return prepare(o, w, 2)

def after_plan(o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != size or size < 64 or get(w, at) != PLAN_RESULT or get(w, at + 16) != get(w, 64):
        return INVALID
    if get(w, at + 56) != size - 64 or get(w, at + 40) != 0:
        return INVALID
    status = get(w, at + 8)
    if status == 1:
        return finish(o, w, 1, at + 64, size - 64)
    if status == 2:
        if get(w, 80) != 0 or get(w, at + 24) != 2 or size < 88:
            return INVALID
        if get(w, at + 64) != CONFIG_REQUEST or get(w, at + 72) != 9 or get(w, at + 80) != size - 88:
            return INVALID
        if reserve(w, 3, size) == 0:
            return pending_grow(o, w)
        copy_range(w, w, region(w, 3), at, size)
        put(w, 96, size)
        put(w, PHASE, 103)
        return prepare(o, w, 3)
    if status != 3 or get(w, 80) != 2 or get(w, at + 24) != 0 or get(w, at + 32) != get(w, 64) or get(w, at + 48) != get(w, 72):
        return INVALID
    if reserve(w, 3, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 3), at, size)
    put(w, 96, size)
    put(w, PHASE, 104)
    return prepare(o, w, 4)

def valid_config(w: mutbuf, at: u64, size: u64) -> bool:
    if size < 32 or get(w, at) != CONFIG_RESULT or get(w, at + 8) > 1 or get(w, at + 16) != 0 or get(w, at + 24) != size - 32:
        return False
    return True

def after_config(o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != size or valid_config(w, at, size) == False:
        return INVALID
    if reserve(w, 4, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 4), at, size)
    put(w, 104, size)
    put(w, 80, 2)
    put(w, PHASE, 102)
    return prepare(o, w, 2)

def after_host(o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != size or valid_config(w, at, size) == False:
        return INVALID
    if get(w, at + 8) != 0:
        return finish(o, w, 1, at + 32, size - 32)
    if reserve(w, 5, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 5), at, size)
    put(w, 112, size)
    put(w, PHASE, 105)
    return prepare(o, w, 5)

def after_files(o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != size or valid_config(w, at, size) == False:
        return INVALID
    if get(w, at + 8) != 0:
        return finish(o, w, 1, at + 32, size - 32)
    if reserve(w, 7, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 7), at, size)
    put(w, 120, size)
    put(w, PHASE, 106)
    return prepare(o, w, 6)

def after_transport(o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != 32 or valid_config(w, at, size) == False:
        return INVALID
    return finish(o, w, get(w, at + 8), at + 32, size - 32)

def prepare(o: mutbuf, w: mutbuf, phase: u64) -> u32:
    if phase < 1 or phase > 6:
        return INVALID
    put(w, PHASE, 100 + phase)
    if reserve(w, 1, 256) == 0:
        return pending_grow(o, w)
    if phase == 1:
        size = get(w, INPUT_LENGTH) - 24
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        put(w, at, TYPED_REQUEST)
        put(w, at + 8, size - 24)
        put(w, at + 16, get(w, 64))
        copy_range(w, w, at + 24, region(w, 6) + 48, size - 24)
        return child(w, get(w, 64) - 1, size, 1)
    if phase == 2:
        typed = get(w, 88)
        feedback = choose(get(w, 80) == 0, 0, get(w, 104))
        if typed > MAXIMUM - 48 or feedback > MAXIMUM - 48 - typed:
            return request_grow(o, w, 3, 0)
        size = 48 + typed + feedback
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        put(w, at, PLAN_REQUEST)
        put(w, at + 8, get(w, 80))
        put(w, at + 16, get(w, 72))
        put(w, at + 24, typed)
        put(w, at + 32, feedback)
        put(w, at + 40, 0)
        copy_range(w, w, at + 48, region(w, 2), typed)
        if feedback != 0:
            copy_range(w, w, at + 48 + typed, region(w, 4), feedback)
        return child(w, 2, size, 2)
    if phase == 3:
        size = get(w, 96) - 64
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        copy_range(w, w, region(w, 0), region(w, 3) + 64, size)
        return child(w, 3, size, 3)
    if phase == 4 or phase == 5:
        typed = region(w, 2)
        host = get(w, typed + 88)
        if host > get(w, 88) - 256 or host > MAXIMUM - 24:
            return INVALID
        size = 24 + host
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        put(w, at, CONFIG_REQUEST)
        put(w, at + 8, choose(phase == 4, 10, 12))
        put(w, at + 16, host)
        copy_range(w, w, at + 24, typed + 256, host)
        return child(w, 3, size, phase)
    typed = get(w, 88)
    host = get(w, 112)
    plan = get(w, 96)
    files = get(w, 120)
    root = get(w, 104)
    if typed > MAXIMUM - 80 or host > MAXIMUM - 80 - typed or plan > MAXIMUM - 80 - typed - host:
        return request_grow(o, w, 3, 0)
    if files > MAXIMUM - 80 - typed - host - plan:
        return request_grow(o, w, 3, 0)
    if root > MAXIMUM - 80 - typed - host - plan - files:
        return request_grow(o, w, 3, 0)
    size = 80 + typed + host + plan + files + root
    if reserve(w, 0, size) == 0:
        return pending_grow(o, w)
    at = region(w, 0)
    put(w, at, TRANSPORT_REQUEST)
    put(w, at + 8, get(w, 64))
    put(w, at + 16, get(w, SEQUENCE) + 1)
    put(w, at + 24, get(w, 72))
    put(w, at + 32, typed)
    put(w, at + 40, host)
    put(w, at + 48, plan)
    put(w, at + 56, files)
    put(w, at + 64, root)
    put(w, at + 72, 0)
    copy_range(w, w, at + 80, region(w, 2), typed)
    copy_range(w, w, at + 80 + typed, region(w, 5), host)
    copy_range(w, w, at + 80 + typed + host, region(w, 3), plan)
    copy_range(w, w, at + 80 + typed + host + plan, region(w, 7), files)
    copy_range(w, w, at + 80 + typed + host + plan + files, region(w, 4), root)
    return child(w, 4, size, 6)

def finish(o: mutbuf, w: mutbuf, status: u64, at: u64, size: u64) -> u32:
    put(w, PHASE, 99)
    put(w, 176, status)
    put(w, 184, at)
    put(w, 192, size)
    if size > MAXIMUM - 32:
        return request_grow(o, w, 3, 0)
    if size > length(o) - 32:
        return request_grow(o, w, 2, 32 + size)
    put(o, 0, CONFIG_RESULT)
    put(o, 8, status)
    put(o, 16, 0)
    put(o, 24, size)
    copy_range(o, w, 32, at, size)
    put(w, PHASE, 0)
    return 32
