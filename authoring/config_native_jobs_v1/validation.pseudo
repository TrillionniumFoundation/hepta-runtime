def field(s:readbuf,node:u64,index:u64) -> u64:
    if read(s,24+node)==101:
        return physical_field(s,node,index+1)
    return physical_field(s,node,index)

def host_header(s:readbuf,w:mutbuf,host:u64) -> u64:
    jobs=physical_field(s,host,1)
    if present(s,jobs):
        put(w,24448,key(s,host))
        put(w,24456,keylen(s,host))
        if number(s,field(s,host,5))!=0:
            return 100
        role=1
        while role<=5:
            pin=physical_field(s,jobs,role)
            path=physical_field(s,pin,1)
            digest=physical_field(s,pin,2)
            if native_path(s,w,path,role)==False or valid_sha(s,digest)==False:
                return 100+role
            role=role+1
    return retained_host_header(s,w,host)

def native_path(s:readbuf,w:mutbuf,node:u64,role:u64) -> bool:
    n=slen(s,node)
    p=data(s,node)
    if n==0 or n>4096:
        return False
    if byte(s,p)!=47:
        return False
    i=1
    component=1
    while i<=n:
        if i<n:
            c=byte(s,p+i)
            if c<32 or c==127:
                return False
            if c==194 and i+1<n:
                c2=byte(s,p+i+1)
                if c2>=128 and c2<=159:
                    return False
        if i==n or byte(s,p+i)==47:
            size=i-component
            if size==0:
                return False
            if size==1 and byte(s,p+component)==46:
                return False
            if size==2 and byte(s,p+component)==46 and byte(s,p+component+1)==46:
                return False
            if i==n:
                return native_basename(s,w,p+component,size,role)
            component=i+1
        i=i+1
    return False

def native_basename(s:readbuf,w:mutbuf,p:u64,n:u64,role:u64) -> bool:
    start=get(w,24000+role*16)
    size=get(w,24008+role*16)
    if n!=size:
        return False
    i=0
    while i<n:
        if byte(s,p+i)!=byte(w,start+i):
            return False
        i=i+1
    return True

def render_error(s:readbuf,w:mutbuf,o:mutbuf,code:u64) -> u64:
    if code<100 or code>105:
        return retained_render_error(s,w,o,code)
    put(w,120,32)
    if code==100:
        native_literal(w,o,6)
        native_host(s,w,o)
        native_literal(w,o,7)
    else:
        native_literal(w,o,8)
        native_host(s,w,o)
        native_literal(w,o,7)
    return get(w,120)

def native_literal(w:mutbuf,o:mutbuf,which:u64) -> u64:
    p=get(w,24000+which*16)
    n=get(w,24008+which*16)
    i=0
    while i<n:
        emit(w,o,byte(w,p+i))
        i=i+1
    return 0

def native_host(s:readbuf,w:mutbuf,o:mutbuf) -> u64:
    p=get(w,24448)
    n=get(w,24456)
    i=0
    while i<n:
        emit(w,o,byte(s,p+i))
        i=i+1
    return 0
