def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(o)<64:
        return 4294967294
    if valid(s)==0:
        return INVALID
    if length(w)<4096:
        return grow(o,1,4096)
    capture=64+load(s,16)
    if load(s,capture+8)==1:
        if load(s,8)!=0:
            return INVALID
        return owner_error(s,o,w)
    if load(s,capture+32)!=0:
        if load(s,8)!=0:
            return INVALID
        return exited(s,o,w)
    if load(s,8)==0:
        size=load(s,capture+40)
        if length(o)<88+size:
            return grow(o,2,88+size)
        header(o,2,24+size)
        put(o,64,VALUE_QUERY)
        put(o,72,1)
        put(o,80,size)
        copy_range(o,s,88,capture+128,size)
        return 64
    feedback=capture+load(s,24)
    size=load(s,32)
    if load(s,8)==2:
        if size<64 or load(s,feedback)!=DIAGNOSTIC_RESULT or load(s,feedback+8)!=1:
            return INVALID
        if load(s,feedback+40)!=size-64 or load(s,feedback+48)!=0 or load(s,feedback+56)!=0:
            return INVALID
        return invalid_json(s,o,w)
    if size<32 or load(s,feedback)!=VALUE_RESULT or load(s,feedback+8)>1 or load(s,feedback+16)!=size-32 or load(s,feedback+24)!=0:
        return INVALID
    if load(s,feedback+8)==1:
        return INVALID
    if length(o)<64+size-32:
        return grow(o,2,64+size-32)
    header(o,0,size-32)
    copy_range(o,s,64,feedback+32,size-32)
    return 64

def valid(s:readbuf) -> u64:
    if length(s)<64 or length(s)>=4294901760 or load(s,0)!=REQUEST or load(s,8)>2:
        return 0
    if load(s,40)!=0 or load(s,48)!=0 or load(s,56)!=0:
        return 0
    left=length(s)-64
    if load(s,16)>left:
        return 0
    left=left-load(s,16)
    if load(s,24)<128 or load(s,24)>left or load(s,32)!=left-load(s,24):
        return 0
    if load(s,8)==0 and load(s,32)!=0:
        return 0
    at=64+load(s,16)
    if load(s,at)!=CAPTURE or load(s,at+8)>1:
        return 0
    i=64
    while i<128:
        if load(s,at+i)!=0:
            return 0
        i=i+8
    left=load(s,24)-128
    if load(s,at+40)>left or load(s,at+48)!=left-load(s,at+40):
        return 0
    if load(s,at+40)>8388608 or load(s,at+48)>8388608:
        return 0
    if load(s,at+8)==1:
        if left!=0 or load(s,at+32)!=0:
            return 0
    elif load(s,at+16)!=0 or load(s,at+24)!=0:
        return 0
    return 1

def header(o:mutbuf,status:u64,size:u64) -> u64:
    i=0
    while i<64:
        put(o,i,0)
        i=i+8
    put(o,0,RESPONSE)
    put(o,8,status)
    put(o,56,size)
    return 0

def grow(o:mutbuf,kind:u64,size:u64) -> u32:
    put(o,0,GROW)
    put(o,8,kind)
    put(o,16,size)
    put(o,24,0)
    return 4294967248

def whitespace(value:u64) -> bool:
    if value>=9 and value<=13:
        return True
    if value==32 or value==133 or value==160 or value==5760:
        return True
    if value>=8192 and value<=8202:
        return True
    return value==8232 or value==8233 or value==8239 or value==8287 or value==12288

def trim_start(s:readbuf,at:u64,size:u64) -> u64:
    end=at+size
    while at<end:
        decoded=next_lossy(s,at,end)
        if whitespace(decoded & 4294967295)==False:
            return at
        at=decoded>>32
    return at

def trim_end(s:readbuf,at:u64,size:u64) -> u64:
    end=at+size
    kept=at
    while at<end:
        decoded=next_lossy(s,at,end)
        at=decoded>>32
        if whitespace(decoded & 4294967295)==False:
            kept=at
    return kept

def exited(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    cap=64+load(s,16)
    out=cap+128
    err=out+load(s,cap+40)
    begin=trim_start(s,out,load(s,cap+40))
    put(w,0,begin)
    put(w,8,trim_end(s,begin,out+load(s,cap+40)-begin)-begin)
    begin=trim_start(s,err,load(s,cap+48))
    put(w,16,begin)
    put(w,24,trim_end(s,begin,err+load(s,cap+48)-begin)-begin)
    number_end=64
    if (load(s,cap+32)&127)==0:
        number_end=decimal(w,64,(load(s,cap+32)>>8)&255)
    else:
        number_end=literal(w,64,23)
    put(w,32,number_end-64)
    total=literal_size(1)+load(s,16)+literal_size(2)+get(w,32)+literal_size(3)+literal_size(4)
    total=total+lossy_size(s,get(w,0),get(w,8))+lossy_size(s,get(w,16),get(w,24))
    if length(o)<64+total:
        return grow(o,2,64+total)
    header(o,1,total)
    at=literal(o,64,1)
    copy_range(o,s,at,64,load(s,16))
    at=literal(o,at+load(s,16),2)
    copy_range(o,w,at,64,get(w,32))
    at=literal(o,at+get(w,32),3)
    at=lossy_copy(s,o,get(w,0),get(w,8),at)
    at=literal(o,at,4)
    lossy_copy(s,o,get(w,16),get(w,24),at)
    return 64

def invalid_json(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    cap=64+load(s,16)
    feedback=cap+load(s,24)
    error_size=load(s,32)-64
    total=literal_size(1)+load(s,16)+literal_size(5)+error_size+literal_size(6)+lossy_size(s,cap+128,load(s,cap+40))
    if length(o)<64+total:
        return grow(o,2,64+total)
    header(o,1,total)
    at=literal(o,64,1)
    copy_range(o,s,at,64,load(s,16))
    at=literal(o,at+load(s,16),5)
    copy_range(o,s,at,feedback+64,error_size)
    at=literal(o,at+error_size,6)
    lossy_copy(s,o,cap+128,load(s,cap+40),at)
    return 64

def reason_literal(reason:u64) -> u64:
    if reason==105 or reason==205:
        return 7
    if reason==101 or reason==704:
        return 8
    if reason==106:
        return 9
    if reason==103:
        return 10
    if reason==403 or reason==703:
        return 11
    if reason==401:
        return 12
    if reason==402:
        return 13
    if reason==404:
        return 14
    if reason==405:
        return 15
    if reason==406:
        return 16
    if reason==408:
        return 17
    if reason==411 or reason==412:
        return 18
    if reason==501 or reason==502:
        return 19
    if reason==504:
        return 20
    if reason==503:
        return 21
    if reason==505:
        return 22
    return 0

def owner_error(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    cap=64+load(s,16)
    reason=load(s,cap+16)
    ident=reason_literal(reason)
    if ident==0:
        if reason!=407 and reason!=409 and reason!=410 and reason!=413 and reason!=206:
            return INVALID
        if load(s,cap+24)<1 or load(s,cap+24)>4095:
            return INVALID
        size=errno_text(w,128,load(s,cap+24))-128
        if length(o)<64+size:
            return grow(o,2,64+size)
        header(o,1,size)
        copy_range(o,w,64,128,size)
        return 64
    size=literal_size(ident)
    if ident==7:
        size=size+load(s,16)
    if length(o)<64+size:
        return grow(o,2,64+size)
    header(o,1,size)
    at=literal(o,64,ident)
    if ident==7:
        copy_range(o,s,at,64,load(s,16))
    return 64

def literal_size(ident:u64) -> u64:
    if ident==1:
        return 17
    if ident==2:
        return 13
    if ident==3:
        return 9
    if ident==4:
        return 9
    if ident==5:
        return 24
    if ident==6:
        return 9
    if ident==7:
        return 24
    if ident==8:
        return 69
    if ident==9:
        return 47
    if ident==10:
        return 48
    if ident==11:
        return 56
    if ident==12:
        return 47
    if ident==13:
        return 38
    if ident==14:
        return 17
    if ident==15:
        return 18
    if ident==16:
        return 18
    if ident==17:
        return 28
    if ident==18:
        return 43
    if ident==19:
        return 62
    if ident==20:
        return 61
    if ident==21:
        return 68
    if ident==22:
        return 56
    if ident==23:
        return 2
    return 0

