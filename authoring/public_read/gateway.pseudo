def read_kind(w: mutbuf) -> u64:
    return choose(get(w,224)==MULTI_REQUEST,3,choose(get(w,224)==INFO_REQUEST,1,2))

def after_params(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    kind=read_kind(w)
    if code != 256 or size < 256 or get(w, at) != choose(kind==3,MULTI_PARAMS_RESULT,PARAMS_RESULT) or get(w, at + 16) != choose(kind==3,1,kind):
        return INVALID
    status = get(w, at + 8)
    if status == 1:
        if get(w, at + 72) != size - 256:
            return INVALID
        return finish(o, w, 2, at + 256, size - 256)
    if status != 0:
        return INVALID
    if reserve(w, 2, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 2), region(w, 1), size)
    put(w,232,size)
    put(w,408,0)
    put(w,416,0)
    put(w,424,0)
    return prepare(s, o, w, 2)

def after_fence(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64, ending: bool) -> u32:
    at = region(w, 1)
    if ending:
        if read_kind(w)==3:
            return after_multi_budget(s,o,w,code,size)
        return after_json_diagnostic(s,o,w,code,size)
    if read_kind(w)==3:
        return after_multi_plan(s,o,w,code,size)
    if code != size or size < 64 or get(w, at) != PLAN_RESULT or get(w, at + 16) != read_kind(w):
        return INVALID
    if get(w, at + 56) != size - 64:
        return INVALID
    if get(w, at + 8) == 1:
        return finish(o, w, 1, at + 64, size - 64)
    if get(w, at + 8) != 2 or get(w, at + 24) != 2:
        return INVALID
    if reserve(w, 3, size - 64) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 3), region(w, 1) + 64, size - 64)
    put(w, 200, size - 64)
    return prepare(s, o, w, 3)

def after_context(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != size or size < 32 or get(w, at) != MESSAGE or get(w, at + 16) != 0 or get(w, at + 24) != size - 32:
        return INVALID
    if read_kind(w)==3:
        if get(w,at+8)>1:
            return INVALID
        if reserve(w,3,size)==0:
            return pending_grow(o,w)
        copy_range(w,w,region(w,3),region(w,1),size)
        put(w,200,size)
        return prepare(s,o,w,4)
    if get(w, at + 8) == 1:
        return finish(o, w, 1, at + 32, size - 32)
    if get(w, at + 8) != 0:
        return INVALID
    if reserve(w, 4, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 4), region(w, 1), size)
    put(w, 216, size)
    return prepare(s, o, w, 4)

def after_current(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    if read_kind(w)==3:
        return after_multi_plan(s,o,w,code,size)
    at = region(w, 1)
    if code != size or size < 64 or get(w, at) != PLAN_RESULT or get(w, at + 16) != read_kind(w) or get(w, at + 56) != size - 64:
        return INVALID
    if get(w, at + 8) == 1:
        return finish(o, w, 1, at + 64, size - 64)
    if get(w, at + 8) != 3:
        return INVALID
    if reserve(w, 5, size - 64) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 5), region(w, 1) + 64, size - 64)
    put(w, 208, size - 64)
    return prepare(s, o, w, 5)

def after_config(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != size or size < 32 or get(w, at) != MESSAGE or get(w, at + 16) != 0 or get(w, at + 24) != size - 32:
        return INVALID
    if get(w, at + 8) == 1:
        return finish(o, w, 1, at + 32, size - 32)
    if get(w, at + 8) != 0:
        return INVALID
    if reserve(w, 6, size - 32) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 6), region(w, 1) + 32, size - 32)
    put(w, 240, size - 32)
    return prepare(s, o, w, 6)

def after_resolve(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    if code==4294967287 and size==0:
        return finish(o,w,3,0,0)
    at = region(w, 1)
    if code != 128 or size < 128 or get(w, at) != CAPTURE_RESULT:
        return INVALID
    if reserve(w, 7, size) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 7), region(w, 1), size)
    put(w, 248, size)
    return prepare(s, o, w, 7)

def after_policy(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64, parsed: bool) -> u32:
    at = region(w, 1)
    if parsed:
        if code != 32 or size < 32 or get(w, at) != VALUE_RESULT:
            return INVALID
        if get(w,at+8)==1:
            if read_kind(w)==3:
                return multi_transport_error(o,w)
            return prepare(s,o,w,10)
        if reserve(w, 3, size) == 0:
            return pending_grow(o, w)
        copy_range(w, w, region(w, 3), region(w, 1), size)
        put(w, 200, size)
        return prepare(s, o, w, 9)
    if code != 64 or size < 64 or get(w, at) != TRANSPORT_RESULT or get(w, at + 56) != size - 64:
        return INVALID
    status = get(w, at + 8)
    if status < 2:
        return after_transport_ready(s,o,w,status,size)
    if status != 2:
        return INVALID
    if reserve(w, 3, size - 64) == 0:
        return pending_grow(o, w)
    copy_range(w, w, region(w, 3), region(w, 1) + 64, size - 64)
    put(w, 200, size - 64)
    return prepare(s, o, w, 8)

def after_caller(s: readbuf, o: mutbuf, w: mutbuf, code: u64, size: u64) -> u32:
    at = region(w, 1)
    if code != 64 or size < 64 or get(w, at) != TRANSPORT_RESULT or get(w, at + 56) != size - 64 or get(w, at + 8) > 1:
        return INVALID
    return after_transport_ready(s,o,w,get(w,at+8),size)

def prepare(s: readbuf, o: mutbuf, w: mutbuf, phase: u64) -> u32:
    if phase < 1 or phase > 11:
        return INVALID
    put(w, 8, 100 + phase)
    if reserve(w, 1, 256) == 0:
        return pending_grow(o, w)
    if phase == 1:
        size = get(w, 72)
        if size > MAXIMUM - 24:
            return request_grow(o, w, 3, 0)
        if reserve(w, 0, size + 24) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        kind=read_kind(w)
        put(w,at,choose(kind==3,MULTI_PARAMS_REQUEST,PARAMS_REQUEST))
        put(w,at+8,size)
        put(w,at+16,choose(kind==3,1,kind))
        copy_range(w,s,at+24,48,size)
        return child(w,choose(kind==3,8,kind-1),size+24,phase)
    if phase == 2 or phase == 4:
        if read_kind(w)==3:
            return prepare_multi_plan(s,o,w,phase)
        typed_size = get(w, 232)
        feedback = choose(phase == 4, get(w, 216), 0)
        if typed_size > MAXIMUM - 48 or feedback > MAXIMUM - 48 - typed_size:
            return request_grow(o, w, 3, 0)
        size = 48 + typed_size + feedback
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        clear_words(w, at, 48)
        put(w, at, PLAN_REQUEST)
        put(w, at + 8, choose(phase == 4, 2, 0))
        put(w, at + 24, typed_size)
        put(w, at + 32, feedback)
        copy_range(w, w, at + 48, region(w, 2), typed_size)
        if feedback != 0:
            copy_range(w, w, at + 48 + typed_size, region(w, 4), feedback)
        return child(w, 2, size, phase)
    if phase == 3 or phase == 8:
        size = get(w, 200)
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        copy_range(w, w, region(w, 0), region(w, 3), size)
        return child(w, choose(phase == 3, 3, 6), size, phase)
    if phase == 5:
        host=get(w,region(w,2)+choose(read_kind(w)==3,56,88))
        if host > MAXIMUM - 64:
            return request_grow(o, w, 3, 0)
        if reserve(w, 0, host + 64) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        clear_words(w, at, 64)
        put(w, at, CONFIG_REQUEST)
        put(w, at + 8, 10)
        put(w, at + 16, host + 40)
        put(w, at + 48, host)
        copy_range(w, w, at + 64, region(w, 2) + 256, host)
        return child(w, 3, host + 64, phase)
    if phase == 6:
        typed_size = get(w, 232)
        root=choose(read_kind(w)==3,16+get(w,424),get(w,216)-32)
        target = get(w, 240)
        plan = get(w, 208)
        if typed_size > MAXIMUM - 64 or root > MAXIMUM - 64 - typed_size:
            return request_grow(o, w, 3, 0)
        size = 64 + typed_size + root
        if target > MAXIMUM - size or plan > MAXIMUM - size - target:
            return request_grow(o, w, 3, 0)
        size = size + target + plan
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        clear_words(w, at, 64)
        put(w, at, SSH_REQUEST)
        put(w, at + 8, read_kind(w))
        put(w, at + 16, typed_size)
        put(w, at + 24, root)
        put(w, at + 32, target)
        put(w, at + 40, plan)
        copy_range(w, w, at + 64, region(w, 2), typed_size)
        if read_kind(w)==3:
            put(w,at+64+typed_size,get(w,432))
            put(w,at+72+typed_size,get(w,440))
            copy_range(w,w,at+80+typed_size,region(w,4),root-16)
        else:
            copy_range(w,w,at+64+typed_size,region(w,4)+32,root)
        copy_range(w, w, at + 64 + typed_size + root, region(w, 6), target)
        copy_range(w, w, at + 64 + typed_size + root + target, region(w, 5), plan)
        return child(w, 4, size, phase)
    if phase == 10:
        if read_kind(w)==3:
            size=get(w,200)
            if size>MAXIMUM-64:
                return request_grow(o,w,3,0)
            if reserve(w,0,size+64)==0:
                return pending_grow(o,w)
            at=region(w,0)
            clear_words(w,at,64)
            put(w,at,TEXT_REQUEST)
            put(w,at+8,1)
            put(w,at+32,size)
            copy_range(w,w,at+64,region(w,3),size)
            return child(w,10,size+64,phase)
        size=get(w,region(w,7)+40)
        if size>8388608 or size>MAXIMUM-24:
            return INVALID
        if reserve(w,0,size+24)==0:
            return pending_grow(o,w)
        at=region(w,0)
        put(w,at,DIAGNOSTIC_REQUEST)
        put(w,at+8,1)
        put(w,at+16,size)
        copy_range(w,w,at+24,region(w,7)+128,size)
        return child(w,7,size+24,phase)
    if phase == 7 or phase == 9 or phase == 11:
        target = get(w, 240)
        capture = get(w, 248)
        feedback = choose(phase == 7, 0, get(w, 200))
        if target > MAXIMUM - 64 or capture > MAXIMUM - 64 - target:
            return request_grow(o, w, 3, 0)
        size = 64 + target + capture
        if feedback > MAXIMUM - size:
            return request_grow(o, w, 3, 0)
        size = size + feedback
        if reserve(w, 0, size) == 0:
            return pending_grow(o, w)
        at = region(w, 0)
        clear_words(w, at, 64)
        put(w, at, TRANSPORT_REQUEST)
        put(w, at + 8, choose(phase == 11, 2, choose(phase == 9, 1, 0)))
        put(w, at + 16, target)
        put(w, at + 24, capture)
        put(w, at + 32, feedback)
        copy_range(w, w, at + 64, region(w, 6), target)
        copy_range(w, w, at + 64 + target, region(w, 7), capture)
        if feedback != 0:
            copy_range(w, w, at + 64 + target + capture, region(w, 3), feedback)
        return child(w, 5, size, phase)
    return INVALID

def clear_words(w: mutbuf, at: u64, size: u64) -> u64:
    i = 0
    while i < size:
        put(w, at + i, 0)
        i = i + 8
    return 0

def after_json_diagnostic(s:readbuf,o:mutbuf,w:mutbuf,code:u64,size:u64) -> u32:
    at=region(w,1)
    if code!=size or size<64 or get(w,at)!=DIAGNOSTIC_RESULT or get(w,at+8)!=1:
        return INVALID
    if get(w,at+40)!=size-64 or get(w,at+48)!=0 or get(w,at+56)!=0:
        return INVALID
    if reserve(w,3,size)==0:
        return pending_grow(o,w)
    copy_range(w,w,region(w,3),region(w,1),size)
    put(w,200,size)
    return prepare(s,o,w,11)

def after_client(s:readbuf,o:mutbuf,w:mutbuf,code:u64,size:u64) -> u32:
    return after_caller(s,o,w,code,size)


def prepare_multi_plan(s:readbuf,o:mutbuf,w:mutbuf,phase:u64) -> u32:
    typed=get(w,232)
    roots=choose(phase==2,0,get(w,424))
    feedback=choose(phase==2,0,get(w,200))
    if typed>MAXIMUM-48 or roots>MAXIMUM-48-typed:
        return request_grow(o,w,3,0)
    size=48+typed+roots
    if feedback>MAXIMUM-size:
        return request_grow(o,w,3,0)
    size=size+feedback
    if reserve(w,0,size)==0:
        return pending_grow(o,w)
    at=region(w,0)
    clear_words(w,at,48)
    put(w,at,MULTI_PLAN_REQUEST)
    put(w,at+8,choose(phase==2,0,get(w,408)))
    put(w,at+16,choose(phase==2,0,get(w,416)))
    put(w,at+24,typed)
    put(w,at+32,roots)
    put(w,at+40,feedback)
    copy_range(w,w,at+48,region(w,2),typed)
    if roots!=0:
        copy_range(w,w,at+48+typed,region(w,4),roots)
    if feedback!=0:
        copy_range(w,w,at+48+typed+roots,region(w,3),feedback)
    return child(w,9,size,phase)

def after_multi_plan(s:readbuf,o:mutbuf,w:mutbuf,code:u64,size:u64) -> u32:
    at=region(w,1)
    if code!=size or size<64 or get(w,at)!=MULTI_PLAN_RESULT:
        return INVALID
    payload=get(w,at+48)
    roots=get(w,at+56)
    if payload>size-64 or roots!=size-64-payload:
        return INVALID
    status=get(w,at+8)
    if status==1:
        if roots!=0:
            return INVALID
        return finish(o,w,1,at+64,payload)
    if status==2:
        phase=get(w,at+16)
        index=get(w,at+24)
        if phase<1 or phase>2:
            return INVALID
        if reserve(w,3,payload)==0 or reserve(w,4,roots)==0:
            return pending_grow(o,w)
        at=region(w,1)
        copy_range(w,w,region(w,3),at+64,payload)
        copy_range(w,w,region(w,4),at+64+payload,roots)
        put(w,200,payload)
        put(w,408,phase)
        put(w,416,index)
        put(w,424,roots)
        return prepare(s,o,w,3)
    if status!=3 or roots!=0 or get(w,408)!=2 or get(w,200)<32:
        return INVALID
    feedback=region(w,3)
    last=get(w,200)-32
    prior=get(w,424)
    if get(w,feedback)!=MESSAGE or get(w,feedback+8)!=0 or get(w,feedback+16)!=0 or get(w,feedback+24)!=last:
        return INVALID
    if prior>MAXIMUM-8 or last>MAXIMUM-8-prior:
        return request_grow(o,w,3,0)
    total=prior+8+last
    file=get(w,at+32)
    response=get(w,at+40)
    if reserve(w,5,payload)==0 or reserve(w,4,total)==0:
        return pending_grow(o,w)
    at=region(w,1)
    copy_range(w,w,region(w,5),at+64,payload)
    put(w,region(w,4)+prior,last)
    copy_range(w,w,region(w,4)+prior+8,region(w,3)+32,last)
    put(w,424,total)
    put(w,432,file)
    put(w,440,response)
    put(w,208,payload)
    return prepare(s,o,w,5)

def after_transport_ready(s:readbuf,o:mutbuf,w:mutbuf,status:u64,size:u64) -> u32:
    if read_kind(w)!=3:
        return finish(o,w,status,region(w,1)+64,size-64)
    if status!=0:
        return multi_transport_error(o,w)
    if reserve(w,3,size-64)==0:
        return pending_grow(o,w)
    copy_range(w,w,region(w,3),region(w,1)+64,size-64)
    put(w,200,size-64)
    return prepare(s,o,w,10)

def after_multi_budget(s:readbuf,o:mutbuf,w:mutbuf,code:u64,size:u64) -> u32:
    at=region(w,1)
    if code!=64 or size<64 or get(w,at)!=TEXT_RESULT:
        return INVALID
    if get(w,at+8)!=0 or get(w,at+16)!=0 or get(w,at+24)!=0:
        return INVALID
    if get(w,at+32)!=64 or get(w,at+40)!=size-64 or get(w,at+48)!=0 or get(w,at+56)!=0:
        return INVALID
    if size-64>get(w,440):
        return multi_budget_error(o,w)
    return finish(o,w,0,region(w,3),get(w,200))

def multi_transport_error(o:mutbuf,w:mutbuf) -> u32:
    if reserve(w,3,122)==0:
        return pending_grow(o,w)
    at=region(w,3)
    store(w,at+0,109)
    store(w,at+1,117)
    store(w,at+2,108)
