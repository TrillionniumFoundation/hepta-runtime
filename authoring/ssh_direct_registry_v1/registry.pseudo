def entry(s: readbuf, o: mutbuf, w: mutbuf) -> u32:
    if length(o) < 128:
        return CAPACITY
    if valid_request(s) == False:
        return INVALID
    if length(w) < 512:
        return grow(o, 512)
    op = load(s, 8)
    generation = load(s, 16)
    token = load(s, 24)
    now = load(s, 32)
    if get(w, 0) == 0:
        if op != 1:
            return INVALID
        clear(w, 0, 512)
        put(w, 0, STATE)
        put(w, 8, generation)
        put(w, 16, 1)
        return answer(o, w, 0, 0, 0)
    if shape(w) == False or get(w, 8) != generation:
        return INVALID
    if op == 1:
        return INVALID
    if op == 2:
        return enqueue(s, o, w)
    if op == 8:
        put(w, 32, 1)
        return answer(o, w, 0, 0, 0)
    if op == 12:
        put(w, 32, 1)
        if get(w, 56) != 0 or get(w, 64) != 0 or get(w, 48) != 0:
            return answer(o, w, 2, 0, 0)
        if get(w, 40) != 0:
            return answer(o, w, 3, 0, get(w, 40))
        return answer(o, w, 0, 0, 0)
    if op == 14:
        fail(w, load(s, 48))
        return answer(o, w, 3, 0, get(w, 40))
    if op == 15 and token == 0:
        return answer(o, w, 0, 0, 0)
    at = find(w, token)
    if at == 0:
        return INVALID
    phase = get(w, at + 8)
    if op == 7 or op == 13:
        put(w, at + 24, 1)
        if op == 13:
            put(w, at + 72, 1)
        return answer(o, w, 0, at, 0)
    if op == 15:
        return answer(o, w, 0, at, 0)
    if op == 3:
        return commit(s, o, w, at)
    if op == 17:
        if phase != 1 or get(w, at + 80) != 0:
            return INVALID
        put(w, at + 80, 1)
        return answer(o, w, 0, at, 0)
    if op == 18:
        if phase != 1:
            return INVALID
        done(w, at, load(s, 48))
        return answer(o, w, 0, at, load(s, 48))
    if op == 16:
        if phase != 1:
            return INVALID
        reason = 0
        if get(w, 32) != 0:
            reason = 1
        else:
            if get(w, at + 24) != 0:
                reason = 2
            else:
                if now >= get(w, at + 16):
                    reason = 3
        if reason == 0:
            return INVALID
        done(w, at, reason)
        return answer(o, w, 1, at, reason)
    if op == 4:
        if phase != 2 or get(w, 48) != token or get(w, at + 48) != 0:
            return INVALID
        put(w, at + 48, 1)
        if load(s, 48) == 0:
            done(w, at, 4)
            put(w, 48, 0)
            return answer(o, w, 1, at, 4)
        put(w, at + 8, 3)
        put(w, at + 40, 1)
        return answer(o, w, 0, at, 0)
    if op == 5:
        if phase != 3 or get(w, 48) != token or get(w, at + 40) != 1:
            return INVALID
        if load(s, 48) == 0:
            put(w, at + 8, 9)
            put(w, at + 56, 5)
            return answer(o, w, 1, at, 5)
        put(w, at + 8, 4)
        put(w, at + 32, load(s, 48))
        put(w, 64, get(w, 64) + 1)
        put(w, 48, 0)
        return answer(o, w, 0, at, 0)
    if op == 6:
        if phase != 4 or get(w, at + 112) != 0 or get(w, 64) == 0:
            return INVALID
        put(w, at + 8, 5)
        put(w, at + 96, load(s, 48))
        put(w, at + 112, 1)
        put(w, 64, get(w, 64) - 1)
        return answer(o, w, 0, at, 0)
    if op == 9:
        if phase == 1 or phase == 7 or phase == 8:
            return INVALID
        put(w, at + 8, 8)
        put(w, at + 56, load(s, 48))
        fail(w, load(s, 48))
        return answer(o, w, 3, at, load(s, 48))
    if op == 10:
        if phase != 5 and phase != 9:
            return INVALID
        if get(w, 48) != 0 and get(w, 48) != token:
            return answer(o, w, 2, at, 0)
        if get(w, at + 40) != 1:
            return INVALID
        put(w, at + 8, 6)
        return answer(o, w, 0, at, 0)
    if op == 11:
        if phase != 6 or get(w, at + 40) != 1:
            return INVALID
        if load(s, 56) != 0:
            put(w, at + 8, 8)
            put(w, at + 56, 7)
            fail(w, 7)
            return answer(o, w, 3, at, 7)
        put(w, at + 40, 0)
        if get(w, 48) == token:
            put(w, 48, 0)
        done(w, at, get(w, at + 56))
        return answer(o, w, 0, at, get(w, at + 56))
    return INVALID

def valid_request(s: readbuf) -> bool:
    if length(s) != 96 or load(s, 0) != REQUEST or load(s, 16) == 0:
        return False
    op = load(s, 8)
    if op < 1 or op > 18:
        return False
    at = 64
    while at < 96:
        if load(s, at) != 0:
            return False
        at = at + 8
    token = load(s, 24)
    x = load(s, 48)
    y = load(s, 56)
    if op == 1:
        return token == 0 and load(s, 32) == 0 and load(s, 40) == 0 and x == 0 and y == 0
    if op == 2:
        return token == 0 and load(s, 40) != 0 and x == 1 and y == 0
    if load(s, 40) != 0:
        return False
    if op == 8 or op == 12:
        return token == 0 and x == 0 and y == 0
    if op == 14:
        return token == 0 and x > 0 and x <= 65535 and y == 0
    if op == 15:
        return x == 0 and y == 0
    if token == 0:
        return False
    if op == 4:
        return (x == 1 and y == 0) or (x == 0 and y > 0 and y <= 4095)
    if op == 5:
        return (x > 0 and x <= 2147483647 and y == 0) or (x == 0 and y > 0 and y <= 4095)
    if op == 6:
        return x <= 65535 and y == 0
    if op == 9 or op == 18:
        return x > 0 and x <= 65535 and y == 0
    if op == 11:
        return x == 0 and y <= 4095
    return x == 0 and y == 0

def enqueue(s: readbuf, o: mutbuf, w: mutbuf) -> u32:
    if get(w, 32) != 0:
        return answer(o, w, 1, 0, 1)
    if load(s, 32) >= load(s, 40):
        return answer(o, w, 1, 0, 3)
    if get(w, 16) == MAXIMUM:
        fail(w, 6)
        return answer(o, w, 3, 0, 6)
    end = 512 + get(w, 24) * 128
    at = vacant(w)
    if at == end:
        if at > MAXIMUM - 128:
            return CAPACITY
        if length(w) < at + 128:
            return grow(o, at + 128)
        put(w, 24, get(w, 24) + 1)
    clear(w, at, 128)
    token = get(w, 16)
    put(w, 16, token + 1)
    put(w, at, token)
    put(w, at + 8, 1)
    put(w, at + 16, load(s, 40))
    put(w, 56, get(w, 56) + 1)
    return answer(o, w, 0, at, 0)

def commit(s: readbuf, o: mutbuf, w: mutbuf, at: u64) -> u32:
    if get(w, at + 8) != 1:
        return INVALID
    if get(w, 48) != 0:
        return answer(o, w, 2, at, 0)
    if get(w, 80) == MAXIMUM:
        fail(w, 6)
        done(w, at, 6)
        return answer(o, w, 3, at, 6)
    put(w, 80, get(w, 80) + 1)
    if get(w, 32) != 0:
        done(w, at, 1)
        return answer(o, w, 1, at, 1)
    if get(w, at + 24) != 0:
        done(w, at, 2)
        return answer(o, w, 1, at, 2)
    if load(s, 32) >= get(w, at + 16):
        done(w, at, 3)
        return answer(o, w, 1, at, 3)
    put(w, at + 8, 2)
    put(w, 48, get(w, at))
    return answer(o, w, 0, at, 0)

def done(w: mutbuf, at: u64, reason: u64) -> u64:
    put(w, at + 8, 7)
    put(w, at + 56, reason)
    put(w, at + 64, 1)
    put(w, 56, get(w, 56) - 1)
    return 0

def fail(w: mutbuf, reason: u64) -> u64:
    put(w, 32, 1)
    if get(w, 40) == 0:
        put(w, 40, reason)
    return 0

def vacant(w: mutbuf) -> u64:
    at = 512
    end = 512 + get(w, 24) * 128
    while at < end:
        if get(w, at + 8) == 7 and get(w, at + 72) == 1:
            return at
        at = at + 128
    return end

def find(w: mutbuf, token: u64) -> u64:
    at = 512
    end = 512 + get(w, 24) * 128
    while at < end:
        if get(w, at) == token:
            return at
        at = at + 128
    return 0

def shape(w: mutbuf) -> bool:
    if get(w, 0) != STATE or get(w, 8) == 0 or get(w, 16) == 0 or get(w, 32) > 1:
        return False
    if get(w, 24) > ((length(w) - 512) >> 7):
        return False
    pending = 0
    children = 0
    in_flight = 0
    at = 512
    end = 512 + get(w, 24) * 128
    while at < end:
        token = get(w, at)
        phase = get(w, at + 8)
        if token == 0 or token >= get(w, 16) or phase < 1 or phase > 9:
            return False
        if get(w, at + 24) > 1 or get(w, at + 40) > 1 or get(w, at + 48) > 1 or get(w, at + 64) > 1 or get(w, at + 72) > 1 or get(w, at + 112) > 1:
            return False
        if get(w, at + 80) > 1 or get(w, at + 88) != 0 or get(w, at + 104) != 0 or get(w, at + 120) != 0:
            return False
        if phase != 7:
            pending = pending + 1
            if get(w, at + 64) != 0:
                return False
        else:
            if get(w, at + 64) != 1 or get(w, at + 40) != 0:
                return False
        if get(w, at + 32) != 0 and get(w, at + 112) == 0:
            children = children + 1
        if get(w, at + 112) == 1 and get(w, at + 32) == 0:
            return False
        if get(w, 48) == token:
            if phase != 2 and phase != 3 and phase != 6 and phase != 8 and phase != 9:
                return False
            if get(w, at + 32) != 0:
                return False
            in_flight = token
        if phase == 2 or phase == 3 or phase == 9:
            if get(w, 48) != token:
                return False
        if phase == 4 and (get(w, at + 32) == 0 or get(w, at + 40) != 1 or get(w, at + 112) != 0):
            return False
        if phase == 5 and (get(w, at + 112) != 1 or get(w, at + 40) != 1):
            return False
        if phase == 1 and (get(w, at + 32) != 0 or get(w, at + 40) != 0 or get(w, at + 48) != 0):
            return False
        at = at + 128
    if pending != get(w, 56) or children != get(w, 64) or in_flight != get(w, 48):
        return False
    at = 88
    while at < 512:
        if get(w, at) != 0:
            return False
        at = at + 8
    return True

def answer(o: mutbuf, w: mutbuf, status: u64, at: u64, reason: u64) -> u32:
    clear(o, 0, 128)
    put(o, 0, RESULT)
    put(o, 8, status)
    put(o, 16, get(w, 8))
    if at != 0:
        put(o, 24, get(w, at))
        put(o, 32, get(w, at + 8))
        put(o, 48, get(w, at + 16))
        put(o, 56, get(w, at + 24))
        put(o, 72, get(w, at + 32))
        put(o, 80, get(w, at + 40))
        put(o, 88, get(w, at + 48))
    put(o, 40, reason)
    put(o, 64, get(w, 32))
    put(o, 96, get(w, 56))
    put(o, 104, get(w, 64))
    put(o, 112, get(w, 48))
    joined = 0
    if get(w, 32) != 0:
        joined = 3
        if get(w, 56) == 0 and get(w, 64) == 0 and get(w, 48) == 0:
            joined = 1
            if get(w, 40) != 0:
                joined = 2
    put(o, 120, joined)
    return 128

def clear(b: mutbuf, start: u64, size: u64) -> u64:
    at = 0
    while at < size:
        store(b, start + at, 0)
        at = at + 1
    return 0

def grow(o: mutbuf, needed: u64) -> u32:
    put(o, 0, GROW_TAG)
    put(o, 8, 1)
    put(o, 16, needed)
    put(o, 24, 0)
    return GROW
