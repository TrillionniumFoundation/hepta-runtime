def emit_write_packet(s:readbuf,o:mutbuf,at:u64,size:u64) -> u64:
    root=load(s,88)
    path=load(s,224)
    data=load(s,232)
    expected=load(s,240)
    put(o,at,WRITE_PACKET)
    put(o,at+8,1)
    put(o,at+24,1)
    put(o,at+32,root)
    put(o,at+40,path)
    put(o,at+48,expected)
    put(o,at+56,data)
    put(o,at+64,1)
    put(o,at+88,size-96)
    copy_range(o,s,at+96,128+load(s,80),root)
    source=384+load(s,216)
    copy_range(o,s,at+96+root,source,path)
    copy_range(o,s,at+96+root+path,source+path+data,expected)
    copy_range(o,s,at+96+root+path+expected,source+path,data)
    return 0
