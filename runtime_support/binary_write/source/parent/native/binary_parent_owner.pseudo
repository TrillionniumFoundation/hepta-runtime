        return 0
    root=get(w,192)
    path=get(w,200)
    same=0
    if root==path:
        same=equal(w,get(w,104),get(w,112),root)
    inside=same
    if get(w,224)==get(w,240) and path>root:
        if equal(w,get(w,104),get(w,112),root)!=0:
            if root==get(w,224):
                inside=1
            else:
