                    inside=1
    if inside==0:
        literal_error(w,2)
        put(w,8,99)
        return 0
    name=path
    stop=0
    while name>get(w,240) and stop==0:
        if byte(w,get(w,112)+name-1)==47:
            stop=1
        else:
            name=name-1
    put(w,208,name)
    put(w,216,path-name)
    sidecar=0
    if path-name>=7:
        if byte(w,get(w,112)+name)==46 and byte(w,get(w,112)+name+1)==104 and byte(w,get(w,112)+name+2)==101:
            if byte(w,get(w,112)+name+3)==112 and byte(w,get(w,112)+name+4)==116 and byte(w,get(w,112)+name+5)==97 and byte(w,get(w,112)+name+6)==45:
                sidecar=1
    if same!=0 or sidecar!=0:
        literal_error(w,3)
        put(w,8,99)
        return 0
    put(w,256,get(w,240))
