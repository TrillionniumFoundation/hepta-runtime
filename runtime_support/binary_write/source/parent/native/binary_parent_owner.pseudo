    put(o,32,size)
    return 64

def normalize(s:readbuf,w:mutbuf,at:u64,size:u64,dst:u64,meta:u64) -> u64:
    source=0
    anchor=0
    count=0
    if size!=0:
        if byte(s,at)==47:
            anchor=1
            if size>=2:
                if byte(s,at+1)==47:
                    anchor=2
                    if size>=3:
                        if byte(s,at+2)==47:
                            anchor=1
            stop=0
            while source<size and stop==0:
                if byte(s,at+source)!=47:
                    stop=1
                else:
                    source=source+1
            store(w,dst,47)
            count=1
            if anchor==2:
                store(w,dst+1,47)
                count=2
    put(w,meta,anchor)
    put(w,meta+8,0)
    while source<size:
        end=source
        stop=0
        while end<size and stop==0:
            if byte(s,at+end)==47:
                stop=1
            else:
                end=end+1
        extent=end-source
        omit=0
        if extent==0:
            omit=1
        if extent==1:
            if byte(s,at+source)==46:
                omit=1
        if omit==0:
            if extent==2:
                if byte(s,at+source)==46 and byte(s,at+source+1)==46:
                    put(w,meta+8,1)
            if count>anchor:
                store(w,dst+count,47)
                count=count+1
            copy_in(s,w,at+source,dst+count,extent)
            count=count+extent
        source=end+1
    if count==0:
        store(w,dst,46)
        count=1
    store(w,dst+count,0)
    return count

def validate_path(w:mutbuf) -> u64:
    if get(w,224)==0 or get(w,240)==0 or get(w,232)!=0 or get(w,248)!=0:
        literal_error(w,1)
