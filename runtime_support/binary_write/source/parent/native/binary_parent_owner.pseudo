        put(w,152,get(w,144)+get(w,80)+2048)
        put(w,160,get(w,152)+reply_capacity(get(w,80),get(w,96)))
        put(w,168,reply_capacity(get(w,80),get(w,96)))
        put(w,176,needed)
        put(w,184,load(s,64))
        copy_in(s,w,96+get(w,72)+get(w,80),get(w,120),get(w,88))
        copy_in(s,w,96+get(w,72)+get(w,80)+get(w,88),get(w,128),get(w,96))
        put(w,192,normalize(s,w,96,get(w,72),get(w,104),224))
        put(w,200,normalize(s,w,96+get(w,72),get(w,80),get(w,112),240))
