                return 4294967295
        sequence=load(s,16)
        if get(w,24)!=0:
            if sequence!=get(w,24):
                return 4294967295
            copy_in(s,w,96,get(w,152),length(s)-96)
            put(w,32,sequence)
            put(w,40,load(s,24))
            put(w,48,length(s)-96)
            put(w,24,0)
        else:
            if sequence!=get(w,32) or load(s,24)!=get(w,40) or length(s)-96!=get(w,48):
                return 4294967295
            at=0
            while at<get(w,48):
                if byte(s,96+at)!=byte(w,get(w,152)+at):
                    return 4294967295
                at=at+1
    status=4294967293
    while status==4294967293:
        phase=get(w,8)
        if phase<10:
            status=flow(o,w)
