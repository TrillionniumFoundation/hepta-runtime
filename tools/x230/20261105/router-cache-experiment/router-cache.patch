+#[tokio::test(flavor = "multi_thread")]
+async fn shared_router_keeps_workdirs_and_view_caches_session_scoped() {
+	let root_a = tempfile::tempdir().expect("session A root");
+	let root_b = tempfile::tempdir().expect("session B root");
+	let nested_a = root_a.path().join("nested");
+	std::fs::create_dir(&nested_a).expect("session A nested directory");
+	std::fs::write(root_a.path().join("marker.txt"), "SESSION_A_ROOT\n").unwrap();
+	std::fs::write(root_b.path().join("marker.txt"), "SESSION_B_ROOT\n").unwrap();
+	std::fs::write(nested_a.join("marker.txt"), "SESSION_A_NESTED\n").unwrap();
+	let shared_path = root_a.path().join("shared.txt");
+	std::fs::write(&shared_path, "FIRST_VIEW_MUST_CONTAIN_THIS_LINE\n").unwrap();
+
+	let (client_a, _server_a, _) = connect_with_lifecycle_in_root(
+		ProtocolVersion::V_2025_11_25,
+		ClientLifecycleMode::Initialize,
+		root_a,
+	)
+	.await;
+	client_a.list_tools(None).await.expect("warm shared router");
+	let (client_b, _server_b, _) = connect_with_lifecycle_in_root(
+		ProtocolVersion::V_2025_11_25,
+		ClientLifecycleMode::Initialize,
+		root_b,
+	)
+	.await;
+	let ((failed_a, text_a), (failed_b, text_b)) = tokio::join!(
+		call_runtime_tool_text(&client_a, "view", json!({"path":"marker.txt"})),
+		call_runtime_tool_text(&client_b, "view", json!({"path":"marker.txt"})),
+	);
+	assert!(!failed_a && text_a.contains("SESSION_A_ROOT"), "{text_a}");
+	assert!(!failed_b && text_b.contains("SESSION_B_ROOT"), "{text_b}");
+	let (failed, changed) =
+		call_runtime_tool_text(&client_a, "workdir", json!({"path":nested_a})).await;
+	assert!(!failed, "{changed}");
+	let ((failed_a, text_a), (failed_b, text_b)) = tokio::join!(
+		call_runtime_tool_text(&client_a, "view", json!({"path":"marker.txt","full":true})),
+		call_runtime_tool_text(&client_b, "view", json!({"path":"marker.txt","full":true})),
+	);
+	assert!(
+		!failed_a && text_a.contains("SESSION_A_NESTED"),
+		"{text_a}"
+	);
+	assert!(!failed_b && text_b.contains("SESSION_B_ROOT"), "{text_b}");
+
+	let (failed, first_a) =
+		call_runtime_tool_text(&client_a, "view", json!({"path":shared_path})).await;
+	assert!(
+		!failed && first_a.contains("FIRST_VIEW_MUST_CONTAIN_THIS_LINE"),
+		"{first_a}"
+	);
+	let (failed, repeated_a) =
+		call_runtime_tool_text(&client_a, "view", json!({"path":shared_path})).await;
+	assert!(
+		!failed && repeated_a.contains("unchanged since you last viewed"),
+		"the first session's delta cache must be active: {repeated_a}"
+	);
+	let (failed, first_b) =
+		call_runtime_tool_text(&client_b, "view", json!({"path":shared_path})).await;
+	assert!(
+		!failed && first_b.contains("FIRST_VIEW_MUST_CONTAIN_THIS_LINE"),
+		"a different session must receive its first full view: {first_b}"
+	);
 }
 
