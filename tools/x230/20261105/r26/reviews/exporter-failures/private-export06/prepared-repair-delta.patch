+def cache_directory_identity(path):
+    """Record present cache metadata or current absence; never replace ELF proof."""
+    path = Path(path)
+    need(path.is_absolute() and path.parent.resolve(strict=True) == path.parent,
+         'indirect private cache parent')
+    if not os.path.lexists(path):
+        return {'path': str(path), 'exists': False, 'directory_identity': None,
+                'reason': 'private reproducible Cargo cache is currently absent; no deletion cause inferred; referenced ELF evidence is handled independently'}
+    current = path.lstat()
+    need(path.resolve(strict=True) == path and stat.S_ISDIR(current.st_mode)
+         and current.st_uid == os.geteuid(), 'unsafe current private cache directory')
+    return {'path': str(path), 'exists': True, 'directory_identity': stamp(current),
+            'reason': 'private reproducible Cargo cache payload excluded; referenced actual test/runtime/release ELF identities retained'}
+
