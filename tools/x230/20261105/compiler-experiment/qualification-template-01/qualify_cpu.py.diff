+def config_absence(source, cargo_home):
+    paths = {base / ".cargo" / name for base in (source, *source.parents)
+             for name in ("config", "config.toml")}
+    paths.update(cargo_home / name for name in ("config", "config.toml"))
+    result = []
+    for path in sorted(paths):
+        try:
+            path.lstat()
+        except FileNotFoundError:
+            # A dangling parent symlink is not evidence of definite configuration absence.
+            for ancestor in path.parents:
+                try:
+                    info = ancestor.lstat()
+                except FileNotFoundError:
+                    continue
+                need(stat.S_ISDIR(info.st_mode), "indeterminate Cargo config ancestor")
+            result.append({"path": str(path), "state": "absent"})
+        else:
+            raise ValueError("unbound Cargo configuration exists: " + str(path))
+    return result
