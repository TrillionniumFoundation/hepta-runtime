+def identity(path):
+    path = Path(path)
+    need(path.is_absolute() and path.resolve(strict=True) == path, "noncanonical input path")
+    before = path.lstat()
+    need(stat.S_ISREG(before.st_mode), "input is not a regular file: " + str(path))
+    digest = sha(path)
+    after = path.lstat()
+    need((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns)
+         == (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns),
+         "input changed while hashing: " + str(path))
+    return {"path": str(path), "bytes": before.st_size, "sha256": digest}
+
+
+def bound(ref, as_json=False):
+    need(set(ref) == {"path", "bytes", "sha256"}, "file reference must bind path/bytes/SHA")
