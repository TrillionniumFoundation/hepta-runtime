+def preserved_transport_locks(directory):
+    states = {}
+    for name in OBSERVED_LOCKS:
+        before = os.stat(name, dir_fd=directory, follow_symlinks=False)
+        require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1
+                and before.st_uid == os.geteuid() and stat.S_IMODE(before.st_mode) == 0o600
+                and before.st_size == 0, 'observed transport lock identity differs: ' + name)
+        require(read_regular(directory, name, 0) == b'', 'observed transport lock is not empty: ' + name)
+        require(stamp(os.stat(name, dir_fd=directory, follow_symlinks=False)) == stamp(before),
+                'observed transport lock changed while read: ' + name)
+        states[name] = stamp(before)
+    return states
+
