[package]
name = "hepta-direct-capacity-component"
version = "0.0.0"
edition = "2021"
rust-version = "1.95"
publish = false

[workspace]
resolver = "2"

[dependencies]
hepta-runtime = { path = @@RUNTIME_PATH_TOML@@ }
anyhow = "=1.0.104"
serde_json = "=1.0.151"
tokio = "=1.53.1"
libc = "=0.2.189"

[profile.release]
lto = true
codegen-units = 1
panic = "abort"
strip = true
opt-level = 3
overflow-checks = false
