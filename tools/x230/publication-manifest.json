          "original_segment_bytes": 109,
          "original_segment_sha256": "4099894c40adcf148ec888cb07e7098ae9919c9a99c6f3e712251a235a96673b",
          "published_segment": "    if sha(args.driver.read_bytes()) != args.driver_sha256:\n        raise ValueError(\"explicit measured D2 driver SHA differs\")\n",
