{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
    {
      "detail": "summary",
      "filters": {
        "operation": "analyze_function",
        "procedure_address": "0x1000"
      }
    }
  ],
  "properties": {
    "detail": {
      "default": "complete",
      "enum": [
        "complete",
        "summary"
      ],
      "type": "string"
    },
    "filters": {
      "additionalProperties": false,
      "properties": {
        "analysis_profile_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "evidence_id": {
          "description": "Stable identifier of the recorded Evidence observation.",
          "pattern": "^ev_[a-f0-9]{64}$",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "type": "string"
        },
        "procedure_address": {
          "minLength": 1,
          "type": "string"
        },
        "target_sha256": {
          "description": "Exact SHA-256 digest of target.",
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}
