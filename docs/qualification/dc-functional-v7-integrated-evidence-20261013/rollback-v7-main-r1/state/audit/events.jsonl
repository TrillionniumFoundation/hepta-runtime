{"action":"process_start","at_unix_ms":1791910438470,"host":"main","outcome":{"job":{"args":["-u","-c","import json,os,pathlib,signal,time\nbase=pathlib.Path('.');once=base/'legacy-once';f=once.open('a');f.write('1');f.flush();os.fsync(f.fileno());f.close()\nraw=pathlib.Path('/proc/'+str(os.getpid())+'/stat').read_text();ticks=int(raw.rsplit(') ',1)[1].split()[19])\nidentity=pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip()+':'+str(ticks)\nterm_count=0;tick=0\ndef store():\n p=base/'legacy-activity.json';t=base/'legacy-activity.tmp';t.write_text(json.dumps({'pid':os.getpid(),'uid':os.geteuid(),'identity':identity,'tick':tick,'term_count':term_count}));os.replace(t,p)\ndef term(sig,frame):\n global term_count\n term_count+=1;store()\nsignal.signal(signal.SIGTERM,term);store();print('LEGACY_BEGIN',flush=True)\ndeadline=time.monotonic()+90\nwhile not (base/'release-legacy').exists() and time.monotonic()<deadline:\n tick+=1;store();time.sleep(.1)\nprint('LEGACY_END',flush=True)\n"],"created_unix_ms":1791910437888,"cwd":"/tmp/hepta-v7-rollback-target-umxg4mkl/data","env_keys":[],"executable":"/usr/bin/python3","execution_mode":"operator","host":"main","id":"1a1362f6400-77e0e-1","idempotency_key":"v7-rollback-4b6b228b934ace2454e3f1f763511133-legacy-job","launch_error":null,"launch_state":"launched","remote_job_dir":"/tmp/hepta-v7-rollback-target-umxg4mkl/remote-state/jobs/1a1362f6400-77e0e-1","request_digest":"6c63f31510dbd14ba61fbcecf8a06c99d6c774d19588a4077858e44c69ecd279","request_fingerprint":7810353450593276235,"ssh_target":"localhost","system_jobctl":false,"unit":"hepta-runtime-job-1a1362f6400-77e0e-1"},"launch":{"backend":"systemd","launcher_pid":null,"ok":true,"unit":"hepta-runtime-job-1a1362f6400-77e0e-1"},"reused":false},"subject":"1a1362f6400-77e0e-1"}
