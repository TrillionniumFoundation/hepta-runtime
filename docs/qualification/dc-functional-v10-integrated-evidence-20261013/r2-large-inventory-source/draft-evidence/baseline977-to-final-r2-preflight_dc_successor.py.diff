+def large_bounded_deadline(protocol, budget_seconds, rpc_timeout):
+    """Refuse invalid requested limits before credential, contract or RPC work."""
+    if (isinstance(rpc_timeout, bool) or not isinstance(rpc_timeout, (int, float))
+            or not 0 < rpc_timeout <= protocol.MAX_RPC_SECONDS or not math.isfinite(rpc_timeout)):
+        raise protocol.InventoryError("DeadlineExpired")
+    deadline = protocol.Deadline(budget_seconds)
+    deadline.timeout(rpc_timeout)
+    return deadline
+
+
+def large_bounded_inventory_observation(manifest, *, budget_seconds=120.0, rpc_timeout=10.0):
+    """Jobs-only observer; exact installed catalog and six authorities precede status."""
+    import dc_successor_inventory as I
+    deadline = large_bounded_deadline(I, budget_seconds, rpc_timeout)
+    token_path = S.absolute_path(manifest["baseline"]["auth_token_file"])
+    contract_pin = manifest["baseline"]["artifacts"]["contract"]
+    refuse_token_source(contract_pin["path"], token_path)
+    credential_pin = I.credential_inode(token_path)
+    raw, _ = S.read_pinned(contract_pin["path"], contract_pin["sha256"], "installed inventory contract")
+    expected = I._json(raw)
+    expected_tools = expected.get("tools")
+    if not isinstance(expected_tools, list):
+        raise I.InventoryError("ProtocolInvalid")
+
+    def definitions(rows):
+        if not isinstance(rows, list) or len(rows) > I.MAX_RECORDS:
+            raise I.InventoryError("ProtocolInvalid")
+        tools = {}
+        for row in rows:
+            if (not isinstance(row, dict) or not isinstance(row.get("name"), str)
+                    or row["name"] in tools):
+                raise I.InventoryError("ProtocolInvalid")
+            tools[row["name"]] = row
+        return tools
+
+    expected_definitions = definitions(expected_tools)
+
+    def factory(host, shared_deadline, pin):
+        client = I.LoopbackReadClient(token_path, token_reader=read_private_token, host=host,
+            deadline=shared_deadline, expected_credential_identity=pin, rpc_timeout=rpc_timeout)
+        try:
+            catalog = client.rpc("tools/list", {})
+            if (not isinstance(catalog, dict) or catalog.get("nextCursor") is not None
+                    or not I._typed_json_equal(definitions(catalog.get("tools")), expected_definitions)):
+                raise I.InventoryError("ProtocolInvalid")
+            host_data = client.call("host_list", {})
+            rows = host_data.get("hosts")
+            if (not isinstance(rows, list) or len(rows) != len(HOSTS)
+                    or any(not isinstance(row, dict) or not isinstance(row.get("name"), str) for row in rows)
+                    or len({row["name"] for row in rows}) != len(HOSTS)
+                    or {row["name"] for row in rows} != set(HOSTS)):
+                raise I.InventoryError("IdentityMismatch")
+            return client
+        except BaseException:
+            client.close()
+            raise
+
+    return I.observe_inventory(S.absolute_path(manifest["baseline"]["state_directory"]) / "jobs",
+        factory, credential_identity=credential_pin, budget_seconds=deadline.remaining(), rpc_timeout=rpc_timeout)
 
 
