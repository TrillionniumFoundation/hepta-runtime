+#[test]
+fn private_policy_binding_has_independent_domain_and_no_public_digest_or_owner_key() {
+	let first = scope();
+	let config = br#"{"ssh_target":"private-host-secret","fixed_args":["secret-option"]}"#;
+	let policy = first.policy_binding(config).unwrap();
+	assert_eq!(policy.len(), 64);
+	assert_eq!(policy, scope().policy_binding(config).unwrap());
+	assert_ne!(policy, first.request_binding(config).unwrap());
+	assert_ne!(policy, first.idempotency_binding(config).unwrap());
+	assert_ne!(
+		policy,
+		hex(digest::digest(&digest::SHA256, config).as_ref())
+	);
+	let mut legacy = b"hepta-runtime/result-policy/v1\0".to_vec();
+	legacy.extend_from_slice(config);
+	assert_ne!(
+		policy,
+		hex(digest::digest(&digest::SHA256, &legacy).as_ref())
+	);
+	let owner_guess = ResultCryptoScope::from_verified_token(id('b').as_bytes()).unwrap();
+	assert_ne!(policy, owner_guess.policy_binding(config).unwrap());
+	let rotated =
+		ResultCryptoScope::from_verified_token(b"rotated-private-policy-token-92843762843876234")
+			.unwrap();
+	assert_ne!(policy, rotated.policy_binding(config).unwrap());
+	assert_ne!(
+		policy,
+		first
+			.policy_binding(br#"{"ssh_target":"changed"}"#)
+			.unwrap()
+	);
+	assert!(!policy.contains("private-host-secret"));
+	assert_ne!(first.keys.policy.as_ref(), first.keys.aead.as_ref());
+	assert_ne!(first.keys.policy.as_ref(), first.keys.request.as_ref());
+	assert_ne!(first.keys.policy.as_ref(), first.keys.idempotency.as_ref());
+}
