+struct FairRequest {
+	reply: oneshot::Receiver<Result<Captured>>,
+	cancel: CancellationToken,
+}
+
+fn enqueue_fair_request(
+	sender: &mpsc::Sender<Request>,
+	admissions: &Arc<Semaphore>,
+	host: &str,
+	command: &str,
+	deadline: Instant,
+) -> FairRequest {
+	let (reply, receive) = oneshot::channel();
+	let cancel = CancellationToken::new();
+	let request = Request {
+		host: host.into(),
+		command: command.into(),
+		input: vec![],
+		deadline,
+		cancel: cancel.clone(),
+		reply,
+		admission: Arc::new(admissions.clone().try_acquire_owned().unwrap()),
+	};
+	assert!(sender.try_send(request).is_ok());
+	FairRequest {
+		reply: receive,
+		cancel,
+	}
+}
+
+fn fair_output(budget: OwnedSemaphorePermit, admission: Arc<OwnedSemaphorePermit>) -> Captured {
+	Captured {
+		output: Output {
+			status: ExitStatus::from_raw(0),
+			stdout: b"{}".to_vec(),
+			stderr: vec![],
+		},
+		_budget: Arc::new(budget),
+		_admission: admission,
+	}
+}
+
+async fn controlled_dispatch(
+	core: Arc<Core>,
+	request: Request,
+	permit: OwnedSemaphorePermit,
+	release: Arc<Semaphore>,
+) {
+	let result = tokio::select! {
+		value = release.acquire_owned() => {
+			value.unwrap().forget();
+			assert_ne!(request.command, "PANIC", "controlled supervisor panic");
+			Ok(fair_output(permit, request.admission.clone()))
+		},
+		_ = request.cancel.cancelled() => Err(anyhow!("controlled request cancelled")),
+		_ = core.stop.cancelled() => Err(anyhow!("controlled pool stopped")),
+		_ = tokio::time::sleep_until(request.deadline) => Err(anyhow!("controlled deadline")),
+	};
+	let _ = request.reply.send(result);
+}
+
+async fn drained(sender: &mpsc::Sender<Request>) {
+	timeout(Duration::from_secs(3), async {
+		while sender.capacity() != QUEUE {
+			tokio::task::yield_now().await;
+		}
+	})
+	.await
+	.unwrap();
+}
