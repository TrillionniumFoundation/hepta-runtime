+async fn started_host(started: &mut mpsc::Receiver<(String, String)>, host: &str) -> String {
+	let (actual, command) = timeout(Duration::from_secs(3), started.recv())
+		.await
+		.unwrap()
+		.unwrap();
+	assert_eq!(actual, host);
+	command
+}
