+#[derive(Clone, Copy, Default, Serialize)]
+struct Statistics {
+	started_intervals: u64,
+	closed_intervals: u64,
+	marked_success: u64,
+	not_marked_success: u64,
+	wall_valid_samples: u64,
+	wall_invalid_samples: u64,
+	wall_ns_sum: u64,
+	wall_ns_max: u64,
+	cpu_valid_samples: u64,
+	cpu_invalid_samples: u64,
+	cpu_ns_sum: u64,
+	cpu_ns_max: u64,
+	bytes_on_marked_success: u64,
+	counter_saturated: bool,
+}
+
+fn add(value: &mut u64, amount: u64, saturated: &mut bool) {
+	if let Some(next) = value.checked_add(amount) {
+		*value = next;
+	} else {
+		*value = u64::MAX;
+		*saturated = true;
+	}
+}
+
+impl Statistics {
+	fn started(&mut self) {
+		add(&mut self.started_intervals, 1, &mut self.counter_saturated);
+	}
+	fn closed(
+		&mut self,
+		wall: Option<u64>,
+		cpu: Option<u64>,
+		measure_cpu: bool,
+		success: bool,
+		bytes: u64,
+	) {
+		add(&mut self.closed_intervals, 1, &mut self.counter_saturated);
+		if success {
+			add(&mut self.marked_success, 1, &mut self.counter_saturated);
+			add(
+				&mut self.bytes_on_marked_success,
+				bytes,
+				&mut self.counter_saturated,
+			);
+		} else {
+			add(&mut self.not_marked_success, 1, &mut self.counter_saturated);
+		}
+		if let Some(value) = wall {
+			add(&mut self.wall_valid_samples, 1, &mut self.counter_saturated);
+			add(&mut self.wall_ns_sum, value, &mut self.counter_saturated);
+			self.wall_ns_max = self.wall_ns_max.max(value);
+		} else {
+			add(
+				&mut self.wall_invalid_samples,
+				1,
+				&mut self.counter_saturated,
+			);
+		}
+		if measure_cpu {
+			if let Some(value) = cpu {
+				add(&mut self.cpu_valid_samples, 1, &mut self.counter_saturated);
+				add(&mut self.cpu_ns_sum, value, &mut self.counter_saturated);
+				self.cpu_ns_max = self.cpu_ns_max.max(value);
+			} else {
+				add(
+					&mut self.cpu_invalid_samples,
+					1,
+					&mut self.counter_saturated,
+				);
+			}
+		}
+	}
+}
+
+struct State {
+	owner_started_wall: Instant,
+	owner_started_cpu: Option<u64>,
+	statistics: [Statistics; METRIC_COUNT],
+	failure_events: FailureEventStatistics,
+}
+
+thread_local! {
+	// The disabled path performs one thread-local flag read, with no clock,
+	// environment lookup, statistics borrow, allocation or output.
+	static ENABLED: Cell<bool> = const { Cell::new(false) };
+	static RECORDING_INCOMPLETE: Cell<bool> = const { Cell::new(false) };
+	static STATE: RefCell<Option<State>> = const { RefCell::new(None) };
+}
+
+fn incomplete() {
+	let _ = RECORDING_INCOMPLETE.try_with(|flag| flag.set(true));
+}
+
+fn with_state(action: impl FnOnce(&mut State)) -> bool {
+	let recorded = STATE
+		.try_with(|slot| {
+			let Ok(mut borrowed) = slot.try_borrow_mut() else {
+				return false;
+			};
+			let Some(state) = borrowed.as_mut() else {
+				return false;
+			};
+			action(state);
+			true
+		})
+		.unwrap_or(false);
+	if !recorded {
+		incomplete();
+	}
+	recorded
+}
+
+fn requested(value: Option<&std::ffi::OsStr>) -> bool {
+	value == Some(std::ffi::OsStr::new("1"))
+}
+
+pub(super) fn enabled() -> bool {
+	ENABLED.try_with(Cell::get).unwrap_or(false)
+}
+
+fn thread_cpu_now() -> Option<u64> {
+	let mut time = libc::timespec {
+		tv_sec: 0,
+		tv_nsec: 0,
+	};
+	if unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut time) } != 0 {
+		return None;
+	}
+	let seconds = u64::try_from(time.tv_sec).ok()?;
+	let nanoseconds = u64::try_from(time.tv_nsec).ok()?;
+	if nanoseconds >= 1_000_000_000 {
+		return None;
+	}
+	seconds.checked_mul(1_000_000_000)?.checked_add(nanoseconds)
+}
+
+fn cpu_delta(start: Option<u64>, end: Option<u64>) -> Option<u64> {
+	end?.checked_sub(start?)
+}
+
+fn nanoseconds(value: Option<Duration>) -> Option<u64> {
+	u64::try_from(value?.as_nanos()).ok()
+}
+
+/// Activate only at the entry of the dedicated observation owner thread.
+/// It outlives the runtime, so normal drain and runtime destruction are covered.
+pub(super) struct OwnerGuard {
+	active: bool,
+	owner_thread: std::thread::ThreadId,
+	_not_send: std::marker::PhantomData<std::rc::Rc<()>>,
+}
+
+impl OwnerGuard {
+	pub(super) fn start() -> Self {
+		let wanted = requested(std::env::var_os(ENVIRONMENT).as_deref())
+			&& !ENABLED.try_with(Cell::get).unwrap_or(false);
+		let mut active = false;
+		if wanted {
+			let state = State {
+				owner_started_wall: Instant::now(),
+				owner_started_cpu: thread_cpu_now(),
+				statistics: [Statistics::default(); METRIC_COUNT],
+				failure_events: FailureEventStatistics::default(),
+			};
+			active = STATE
+				.try_with(|slot| {
+					let Ok(mut borrowed) = slot.try_borrow_mut() else {
+						return false;
+					};
+					if borrowed.is_some() {
+						return false;
+					}
+					*borrowed = Some(state);
+					true
+				})
+				.unwrap_or(false);
+			if active {
+				let _ = RECORDING_INCOMPLETE.try_with(|flag| flag.set(false));
+				let _ = ENABLED.try_with(|flag| flag.set(true));
+			}
+		}
+		Self {
+			active,
+			owner_thread: std::thread::current().id(),
+			_not_send: std::marker::PhantomData,
+		}
+	}
+}
+
+#[derive(Serialize)]
+struct MetricSummary {
+	category: &'static str,
+	phase: &'static str,
+	parent_inclusive_metric: Option<&'static str>,
+	cpu_applicable: bool,
+	#[serde(flatten)]
+	statistics: Statistics,
+}
+
+fn metric_summary(index: usize, statistics: Statistics) -> MetricSummary {
+	let (category, phase, parent) = match index {
+		FILE_SET => ("verify_files", "total", None),
+		SHELL_RESOLUTION => ("shell_resolution", "total", Some("verify_files.total")),
+		POLICY => (
+			"policy_parent_and_environment",
+			"total",
+			Some("verify_files.total"),
+		),
+		AGENT => ("agent_snapshot", "wall_only", None),
+		_ => {
+			let file = (index - 1) / FILE_PHASES;
+			let phase = (index - 1) % FILE_PHASES;
+			(
+				FILE_NAMES[file],
+				PHASE_NAMES[phase],
+				Some(if phase == 0 {
+					"verify_files.total"
+				} else {
+					"same_category.total"
+				}),
+			)
+		}
+	};
+	MetricSummary {
+		category,
+		phase,
+		parent_inclusive_metric: parent,
+		cpu_applicable: index != AGENT,
+		statistics,
+	}
+}
+
+#[derive(Serialize)]
+struct Summary {
+	schema: &'static str,
+	enabled: bool,
+	owner_scope: &'static str,
+	owner_wall_ns: Option<u64>,
+	owner_thread_cpu_ns: Option<u64>,
+	owner_thread_cpu_is_whole_controller_cpu: bool,
+	clock: &'static str,
+	thread_cpu_recorded_only_for_synchronous_metrics: bool,
+	recording_incomplete: bool,
+	all_metrics_include_startup_observations_and_shutdown: bool,
+	includes_only_timed_benchmark_cells: bool,
+	agent_wall_intervals_may_overlap: bool,
+	parent_metrics_include_their_children: bool,
+	measurement_overhead_in_parent_and_owner_totals: bool,
+	not_marked_success_definition: &'static str,
+	bytes_definition: &'static str,
+	abrupt_termination_may_omit_summary: bool,
+	failure_event_limit: u64,
+	failure_event_logging_may_perturb_failure_timing: bool,
+	failure_events: FailureEventStatistics,
+	metrics: [MetricSummary; METRIC_COUNT],
+}
+
+impl Drop for OwnerGuard {
+	fn drop(&mut self) {
+		if !self.active || self.owner_thread != std::thread::current().id() {
+			return;
+		}
+		// Stop collecting before serialization or stderr I/O. The denominator
+		// covers the same owner scope as every completed synchronous interval.
+		let ended_wall = Instant::now();
+		let ended_cpu = thread_cpu_now();
+		let _ = ENABLED.try_with(|flag| flag.set(false));
+		let state = STATE
+			.try_with(|slot| slot.try_borrow_mut().ok()?.take())
+			.ok()
+			.flatten();
+		let Some(state) = state else {
+			return;
+		};
+		let summary = Summary {
+			schema: "hepta-x230-profile-diagnostic/v2",
+			enabled: true,
+			owner_scope: "diagnostic activation at owner thread entry through completed runtime drain/destruction; excludes summary serialization, stderr write and final thread teardown; excludes profile loading before owner thread creation",
+			owner_wall_ns: nanoseconds(ended_wall.checked_duration_since(state.owner_started_wall)),
+			owner_thread_cpu_ns: cpu_delta(state.owner_started_cpu, ended_cpu),
+			owner_thread_cpu_is_whole_controller_cpu: false,
+			clock: "CLOCK_THREAD_CPUTIME_ID around synchronous intervals only",
+			thread_cpu_recorded_only_for_synchronous_metrics: true,
+			recording_incomplete: RECORDING_INCOMPLETE.try_with(Cell::get).unwrap_or(true),
+			all_metrics_include_startup_observations_and_shutdown: true,
+			includes_only_timed_benchmark_cells: false,
+			agent_wall_intervals_may_overlap: true,
+			parent_metrics_include_their_children: true,
+			measurement_overhead_in_parent_and_owner_totals: true,
+			not_marked_success_definition: "interval dropped without its explicit success marker; includes errors, cancellation and unwinding, and is not an RPC failure count",
+			bytes_definition: "bytes counted only on a successfully completed read_and_hash interval; a later stamp/digest or request check can still fail",
+			abrupt_termination_may_omit_summary: true,
+			failure_event_limit: FAILURE_EVENT_LIMIT,
+			failure_event_logging_may_perturb_failure_timing: true,
+			failure_events: state.failure_events,
+			metrics: std::array::from_fn(|index| metric_summary(index, state.statistics[index])),
+		};
+		let mut stderr = std::io::stderr().lock();
+		// Diagnostics must not alter runtime results if their sink fails. A
+		// partial/missing JSON line is invalid diagnostic evidence, never zero.
+		if stderr
+			.write_all(b"HEPTA_X230_PROFILE_DIAGNOSTIC_JSON ")
+			.is_ok() && serde_json::to_writer(&mut stderr, &summary).is_ok()
+		{
+			let _ = stderr.write_all(b"\n");
+		}
+	}
+}
+
+struct Started {
+	owner_thread: std::thread::ThreadId,
+	wall: Instant,
+	cpu: Option<u64>,
+}
+
+pub(super) struct Span {
+	index: usize,
+	started: Option<Started>,
+	success: bool,
+	bytes: u64,
+}
+
+impl Span {
+	fn start(index: usize) -> Self {
+		let started = if ENABLED.try_with(Cell::get).unwrap_or(false)
+			&& with_state(|state| state.statistics[index].started())
+		{
+			Some(Started {
+				owner_thread: std::thread::current().id(),
+				wall: Instant::now(),
+				cpu: if index == AGENT {
+					None
+				} else {
+					thread_cpu_now()
+				},
+			})
+		} else {
+			None
+		};
+		Self {
+			index,
+			started,
+			success: false,
+			bytes: 0,
+		}
+	}
+	pub(super) fn files() -> Self {
+		Self::start(FILE_SET)
+	}
+	pub(super) fn file(kind: FileKind, phase: FilePhase) -> Self {
+		Self::start(1 + kind as usize * FILE_PHASES + phase as usize)
+	}
+	pub(super) fn shell_resolution() -> Self {
+		Self::start(SHELL_RESOLUTION)
+	}
+	pub(super) fn policy() -> Self {
+		Self::start(POLICY)
+	}
+	pub(super) fn agent_wall() -> Self {
+		Self::start(AGENT)
+	}
+	pub(super) fn success(mut self) {
+		self.success = true;
+	}
+	pub(super) fn success_with_bytes(mut self, bytes: u64) {
+		self.success = true;
+		self.bytes = bytes;
+	}
+}
+
+impl Drop for Span {
+	fn drop(&mut self) {
+		let Some(started) = &self.started else {
+			return;
+		};
+		if started.owner_thread != std::thread::current().id() {
+			// Never charge another thread's clock or TLS. Its original owner's
+			// started/closed mismatch makes this diagnostic evidence incomplete.
+			return;
+		}
+		let wall = nanoseconds(Instant::now().checked_duration_since(started.wall));
+		let measure_cpu = self.index != AGENT;
+		let cpu = if measure_cpu {
+			cpu_delta(started.cpu, thread_cpu_now())
+		} else {
+			None
+		};
+		with_state(|state| {
+			state.statistics[self.index].closed(wall, cpu, measure_cpu, self.success, self.bytes);
+		});
+	}
+}
