+#[derive(Serialize)]
+struct FailureEvent {
+	schema: &'static str,
+	sequence: u64,
+	observed_owner_wall_ns: Option<u64>,
+	emitted_owner_wall_ns: Option<u64>,
+	expected_argv_mode_is_not_verified_process_identity: bool,
+	initial_proof_passed: bool,
+	pool_stop_cancelled_before_cleanup: bool,
+	no_retry_or_fallback: bool,
+	pidfd_probe_kind: &'static str,
+	pidfd_errno_category: Option<&'static str>,
+	#[serde(flatten)]
+	observation: SpawnProofObservation,
+	stop_reap: ProbeResult,
+	ledger_release: ProbeResult,
+}
+
+pub(super) struct SpawnFailureGuard {
+	event: Option<FailureEvent>,
+	owner_thread: Option<std::thread::ThreadId>,
+}
+
+impl SpawnFailureGuard {
+	pub(super) fn new(build: impl FnOnce() -> SpawnProofObservation) -> Self {
+		let mut result = Self {
+			event: None,
+			owner_thread: None,
+		};
+		if !enabled() {
+			return result;
+		}
+		let mut sequence = 0;
+		let mut observed = None;
+		let mut allowed = false;
+		if !with_state(|state| {
+			let counters = &mut state.failure_events;
+			add(&mut counters.seen, 1, &mut counters.counter_saturated);
+			sequence = counters.seen;
+			allowed = sequence <= FAILURE_EVENT_LIMIT;
+			if allowed {
+				observed =
+					nanoseconds(Instant::now().checked_duration_since(state.owner_started_wall));
+			} else {
+				add(&mut counters.capped, 1, &mut counters.counter_saturated);
+			}
+		}) || !allowed
+		{
+			return result;
+		}
+		let observation = build();
+		let (kind, errno_class) = if !observation.pid_available {
+			("not_attempted_pid_unavailable", None)
+		} else if observation.pidfd_available {
+			("acquired", None)
+		} else {
+			("failed", Some(errno_category(observation.pidfd_errno)))
+		};
+		result.owner_thread = Some(std::thread::current().id());
+		result.event = Some(FailureEvent {
+			schema: "hepta-x230-spawn-proof-failure/v1",
+			sequence,
+			observed_owner_wall_ns: observed,
+			emitted_owner_wall_ns: None,
+			expected_argv_mode_is_not_verified_process_identity: true,
+			initial_proof_passed: false,
+			pool_stop_cancelled_before_cleanup: true,
+			no_retry_or_fallback: true,
+			pidfd_probe_kind: kind,
+			pidfd_errno_category: errno_class,
+			observation,
+			stop_reap: ProbeResult::status("not_attempted"),
+			ledger_release: ProbeResult::status("not_attempted"),
+		});
+		result
+	}
+	pub(super) fn stopping(&mut self) {
+		if let Some(event) = self.event.as_mut() {
+			event.stop_reap = ProbeResult::status("in_progress");
+		}
+	}
+	pub(super) fn stopped(&mut self, result: &anyhow::Result<()>) {
+		if let Some(event) = self.event.as_mut() {
+			event.stop_reap = ProbeResult::cleanup(result);
+		}
+	}
+	pub(super) fn releasing(&mut self) {
+		if let Some(event) = self.event.as_mut() {
+			event.ledger_release = ProbeResult::status("in_progress");
+		}
+	}
+	pub(super) fn released(&mut self, result: &anyhow::Result<()>) {
+		if let Some(event) = self.event.as_mut() {
+			event.ledger_release = ProbeResult::cleanup(result);
+		}
+	}
+	fn close_with_writer(&mut self, writer: &mut impl Write) {
+		if self.owner_thread != Some(std::thread::current().id()) {
+			return;
+		}
+		let Some(mut event) = self.event.take() else {
+			return;
+		};
+		if event.stop_reap.kind == "in_progress" {
+			event.stop_reap.kind = "not_completed";
+		}
+		if event.ledger_release.kind == "in_progress" {
+			event.ledger_release.kind = "not_completed";
+		}
+		if !with_state(|state| {
+			event.emitted_owner_wall_ns =
+				nanoseconds(Instant::now().checked_duration_since(state.owner_started_wall));
+			add(
+				&mut state.failure_events.attempted,
+				1,
+				&mut state.failure_events.counter_saturated,
+			);
+		}) {
+			return;
+		}
+		let written = writer
+			.write_all(b"HEPTA_X230_SPAWN_PROOF_FAILURE_JSON ")
+			.is_ok() && serde_json::to_writer(&mut *writer, &event).is_ok()
+			&& writer.write_all(b"\n").is_ok();
+		with_state(|state| {
+			let counters = &mut state.failure_events;
+			if written {
+				add(&mut counters.written, 1, &mut counters.counter_saturated);
+			} else {
+				add(
+					&mut counters.write_failed,
+					1,
+					&mut counters.counter_saturated,
+				);
+			}
+		});
+	}
+}
+
+impl Drop for SpawnFailureGuard {
+	fn drop(&mut self) {
+		if self.event.is_some() {
+			self.close_with_writer(&mut std::io::stderr().lock());
+		}
+	}
+}
