+#[derive(Clone, Copy, Default, Serialize)]
+struct FailureEventStatistics {
+	seen: u64,
+	attempted: u64,
+	written: u64,
+	capped: u64,
+	write_failed: u64,
+	counter_saturated: bool,
+}
+
+pub(super) fn errno_category(errno: Option<i32>) -> &'static str {
+	match errno {
+		None => "no_os_errno",
+		Some(libc::ENOENT | libc::ESRCH) => "not_found_or_exited",
+		Some(libc::EACCES | libc::EPERM) => "permission",
+		Some(libc::EMFILE | libc::ENFILE | libc::ENOMEM | libc::EAGAIN | libc::ENOSPC) => {
+			"resource"
+		}
+		Some(libc::EINTR) => "interrupted",
+		Some(libc::EINVAL | libc::ENOSYS | libc::ENODEV) => "invalid_or_unsupported",
+		Some(libc::EIO) => "io",
+		Some(_) => "other_os_error",
+	}
+}
