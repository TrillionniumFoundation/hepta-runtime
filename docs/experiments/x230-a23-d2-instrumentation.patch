+#[derive(Clone, Copy, Default, Serialize)]
+pub(super) struct IdentityObservation {
+	#[serde(skip)]
+	active: bool,
+	failure_stage: Option<&'static str>,
+	failure_errno: Option<i32>,
+	failure_errno_category: Option<&'static str>,
+	stat_state: Option<&'static str>,
+	argv_was_empty: Option<bool>,
+	uid_matches: Option<bool>,
+	executable_matches: Option<bool>,
+	argv_matches: Option<bool>,
+}
+
+impl IdentityObservation {
+	pub(super) fn new(active: bool) -> Self {
+		Self {
+			active,
+			..Self::default()
+		}
+	}
+	pub(super) fn failed(&mut self, stage: &'static str, errno: Option<i32>) {
+		if self.active {
+			self.failure_stage = Some(stage);
+			self.failure_errno = errno;
+			self.failure_errno_category = Some(errno_category(errno));
+		}
+	}
+	pub(super) fn state(&mut self, value: Option<&str>) {
+		if self.active {
+			self.stat_state = value.map(|state| match state {
+				"R" => "running",
+				"S" => "sleeping",
+				"D" => "disk_sleep",
+				"Z" => "zombie",
+				"T" => "stopped",
+				"t" => "tracing_stop",
+				"X" | "x" => "dead",
+				"I" => "idle",
+				_ => "other",
+			});
+		}
+	}
+	pub(super) fn argv_empty(&mut self, value: bool) {
+		if self.active {
+			self.argv_was_empty = Some(value);
+		}
+	}
+	pub(super) fn uid(&mut self, value: bool) -> bool {
+		if self.active {
+			self.uid_matches = Some(value);
+		}
+		value
+	}
+	pub(super) fn executable(&mut self, value: bool) -> bool {
+		if self.active {
+			self.executable_matches = Some(value);
+		}
+		value
+	}
+	pub(super) fn argv(&mut self, value: bool) -> bool {
+		if self.active {
+			self.argv_matches = Some(value);
+		}
+		value
+	}
+}
+
+pub(super) fn expected_argv_mode(args: &[String]) -> &'static str {
+	let master = args.iter().any(|value| value == "ControlMaster=yes");
+	let slave = args.iter().any(|value| value == "ControlMaster=no");
+	let effective = args.iter().any(|value| value == "-G");
+	match (master, slave, effective) {
+		(true, false, true) => "effective_master",
+		(false, true, true) => "effective_slave",
+		(true, false, false) => "master",
+		(false, true, false) => "slave",
+		_ => "unknown",
+	}
+}
