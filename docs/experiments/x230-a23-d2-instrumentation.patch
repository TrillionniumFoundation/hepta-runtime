+//! Optional, owner-thread-only measurements for an isolated diagnostic build.
+//! No measurement participates in an authority decision or changes a deadline.
+
+use serde::Serialize;
+use std::cell::{Cell, RefCell};
+use std::io::Write;
+use std::time::{Duration, Instant};
+
+pub(super) const ENVIRONMENT: &str = "HEPTA_X230_PROFILE_DIAGNOSTIC";
+const METRIC_COUNT: usize = 32;
+const FILE_PHASES: usize = 4;
+const FILE_SET: usize = 0;
+const SHELL_RESOLUTION: usize = 29;
+const POLICY: usize = 30;
+const AGENT: usize = 31;
+const FAILURE_EVENT_LIMIT: u64 = 16;
+const FILE_NAMES: [&str; 7] = [
+	"profile",
+	"ssh_config",
+	"known_hosts",
+	"ssh_executable",
+	"false_executable",
+	"shell_executable",
+	"unclassified",
+];
+const PHASE_NAMES: [&str; FILE_PHASES] = [
+	"total",
+	"open_and_before_checks",
+	"read_and_hash",
+	"after_stamps_and_digest",
+];
+
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub(super) enum FileKind {
+	Profile,
+	Config,
+	KnownHosts,
+	Ssh,
+	False,
+	Shell,
+	Other,
+}
+
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub(super) enum FilePhase {
+	Total,
+	OpenBefore,
+	ReadHash,
+	AfterStampsDigest,
+}
