+#[derive(Debug)]
+struct MetadataQueryDeadline;
+
+#[cfg(unix)]
+impl std::fmt::Display for MetadataQueryDeadline {
+	fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+		out.write_str(
