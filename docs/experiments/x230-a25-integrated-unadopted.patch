+		.await
+		.unwrap()
+		.unwrap()
+		.is_err());
+	assert!(stop.is_cancelled());
+	assert_eq!(workers.permits.available_permits(), WORKERS - 1);
+	assert!(timeout(Duration::from_millis(25), workers.drain())
+		.await
