+#[test]
+fn d4_failure_buffer_is_capped_and_flushes_after_failed_cleanup() {
+	let _state = TestState::start();
+	let mut unfinished = SpawnFailureGuard::new(|| observation(1));
+	unfinished.stopping();
+	for id in 2..=20 {
+		let mut failure = SpawnFailureGuard::new(|| observation(id));
+		failure.stopping();
+		failure.stopped(&Ok(()));
+		failure.releasing();
+		failure.released(&Ok(()));
+	}
+	STATE.with(|slot| {
+		let slot = slot.borrow();
+		let state = slot.as_ref().unwrap();
+		assert_eq!(state.events.len(), 16);
+		assert_eq!(state.seen, 20);
+		assert_eq!(state.capped, 4);
+		assert_eq!(state.events[0].stop_reap.kind, "in_progress");
+	});
+	let cleanup = Err(
+		anyhow::Error::from(std::io::Error::from_raw_os_error(libc::EBUSY))
+			.context("/private/sentinel-cleanup"),
+	);
+	let mut output = Vec::new();
+	finish_cleanup_with_writer(&cleanup, &mut output);
+	let text = String::from_utf8(output).unwrap();
+	assert!(!text.contains("sentinel-"));
+	let records: Vec<serde_json::Value> = text
+		.lines()
+		.map(|line| {
+			let prefix = std::str::from_utf8(PREFIX).unwrap();
+			serde_json::from_str(line.strip_prefix(prefix).unwrap()).unwrap()
+		})
+		.collect();
+	assert_eq!(records.len(), 16);
+	for (index, event) in records.iter().enumerate() {
+		assert_eq!(event["sequence"], index + 1);
+		assert_eq!(event["schema"], "hepta-x230-spawn-proof-failure/v2-d4");
+		assert_eq!(event["owner_cleanup"]["kind"], "error");
+		assert_eq!(event["owner_cleanup"]["errno"], libc::EBUSY);
+		assert_eq!(event["flush_after_owner_cleanup_returned"], true);
+		assert_eq!(event["initial_proof_passed"], false);
+		assert_eq!(event["failures_seen"], 20);
+		assert_eq!(event["failures_capped"], 4);
+		assert_eq!(event["failures_reserved_but_not_buffered"], 0);
+		assert_eq!(event["expected_argv_mode"], "effective_slave");
+	}
+	assert_eq!(records[0]["failure_guard_closed"], false);
+	assert_eq!(records[0]["stop_reap"]["kind"], "not_completed");
+	assert_eq!(records[0]["ledger_release"]["kind"], "not_attempted");
+	assert_eq!(records[1]["failure_guard_closed"], true);
+	assert_eq!(records[1]["stop_reap"]["kind"], "succeeded");
+	assert_eq!(records[1]["ledger_release"]["kind"], "succeeded");
+	drop(unfinished);
+	let mut second_output = Vec::new();
+	finish_cleanup_with_writer(&cleanup, &mut second_output);
+	assert!(second_output.is_empty());
+}
