+#[test]
+fn d4_observation_keeps_short_circuit_identity_results_and_fixed_categories() {
+	for uid in [false, true] {
+		for executable in [false, true] {
+			for argv in [false, true] {
+				let mut observed = IdentityObservation::default();
+				let matches =
+					observed.uid(uid) && observed.executable(executable) && observed.argv(argv);
+				assert_eq!(matches, uid && executable && argv);
+				assert_eq!(observed.uid_matches, Some(uid));
+				assert_eq!(observed.executable_matches, uid.then_some(executable));
+				assert_eq!(observed.argv_matches, (uid && executable).then_some(argv));
+			}
+		}
+	}
+	let mut observed = IdentityObservation::default();
+	observed.state(Some("secret-unexpected-state"));
+	observed.argv_empty(true);
+	observed.failed("exe_metadata", Some(libc::EACCES));
+	let data = serde_json::to_value(observed).unwrap();
+	assert_eq!(data["stat_state"], "other");
+	assert_eq!(data["failure_errno"], libc::EACCES);
+	assert_eq!(data["failure_errno_category"], "permission");
+	assert_eq!(data["argv_was_empty"], true);
+	assert!(!data.to_string().contains("secret-unexpected-state"));
+	assert_eq!(errno_category(Some(libc::ENOENT)), "not_found_or_exited");
+	assert_eq!(errno_category(Some(libc::EMFILE)), "resource");
+	assert_eq!(errno_category(None), "no_os_errno");
+	let error = anyhow::Error::from(std::io::Error::from_raw_os_error(libc::ECHILD))
+		.context("/private/sentinel-error");
+	let probe = serde_json::to_value(ProbeResult::terminal(&Err(error))).unwrap();
+	assert_eq!(probe["errno"], libc::ECHILD);
+	assert_eq!(probe["kind"], "error");
+	assert!(!probe.to_string().contains("sentinel-error"));
+}
