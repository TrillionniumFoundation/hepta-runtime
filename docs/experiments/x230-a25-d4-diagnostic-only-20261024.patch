@@ -0,0 +1,359 @@
+// Copyright 2026 Muvon Un Limited
+// Copyright 2026 TrillionniumFoundation
+// SPDX-License-Identifier: Apache-2.0
+//! Failure-only, always-on evidence for the isolated A25-D4 diagnostic tree.
+//! No phase clocks, extra process probes, retries, or raw process identity bytes.
+//! Guards buffer at most sixteen failures; only owner cleanup flushes stderr.
+use serde::Serialize;
+use std::cell::RefCell;
+use std::io::Write;
+
+const FAILURE_EVENT_LIMIT: u64 = 16;
+const PREFIX: &[u8] = b"HEPTA_X230_SPAWN_PROOF_FAILURE_JSON ";
+
+thread_local! {
+	static STATE: RefCell<Option<State>> = const { RefCell::new(None) };
+}
+
+struct State {
+	seen: u64,
+	capped: u64,
+	events: Vec<FailureEvent>,
+}
+
+fn with_state(apply: impl FnOnce(&mut State)) {
+	let _ = STATE.try_with(|slot| {
+		let Ok(mut slot) = slot.try_borrow_mut() else {
+			return;
+		};
+		let Some(state) = slot.as_mut() else {
+			return;
+		};
+		apply(state);
+	});
+}
+
+pub(super) fn initialize() {
+	let _ = STATE.try_with(|slot| {
+		if let Ok(mut slot) = slot.try_borrow_mut() {
+			*slot = Some(State {
+				seen: 0,
+				capped: 0,
+				events: Vec::with_capacity(FAILURE_EVENT_LIMIT as usize),
+			});
+		}
+	});
+}
+
+pub(super) fn errno_category(errno: Option<i32>) -> &'static str {
+	match errno {
+		None => "no_os_errno",
+		Some(libc::ENOENT | libc::ESRCH) => "not_found_or_exited",
+		Some(libc::EACCES | libc::EPERM) => "permission",
+		Some(libc::EMFILE | libc::ENFILE | libc::ENOMEM | libc::EAGAIN | libc::ENOSPC) => {
+			"resource"
+		}
+		Some(libc::EINTR) => "interrupted",
+		Some(libc::EINVAL | libc::ENOSYS | libc::ENODEV) => "invalid_or_unsupported",
+		Some(libc::EIO) => "io",
+		Some(_) => "other_os_error",
+	}
+}
+
+#[derive(Clone, Copy, Default, Serialize)]
+pub(super) struct IdentityObservation {
+	failure_stage: Option<&'static str>,
+	failure_errno: Option<i32>,
+	failure_errno_category: Option<&'static str>,
+	stat_state: Option<&'static str>,
+	argv_was_empty: Option<bool>,
+	uid_matches: Option<bool>,
+	executable_matches: Option<bool>,
+	argv_matches: Option<bool>,
+}
+
+impl IdentityObservation {
+	pub(super) fn failed(&mut self, stage: &'static str, errno: Option<i32>) {
+		self.failure_stage = Some(stage);
+		self.failure_errno = errno;
+		self.failure_errno_category = Some(errno_category(errno));
+	}
+	pub(super) fn state(&mut self, value: Option<&str>) {
+		self.stat_state = value.map(|state| match state {
+			"R" => "running",
+			"S" => "sleeping",
+			"D" => "disk_sleep",
+			"Z" => "zombie",
+			"T" => "stopped",
+			"t" => "tracing_stop",
+			"X" | "x" => "dead",
+			"I" => "idle",
+			_ => "other",
+		});
+	}
+	pub(super) fn argv_empty(&mut self, value: bool) {
+		self.argv_was_empty = Some(value);
+	}
+	pub(super) fn uid(&mut self, value: bool) -> bool {
+		self.uid_matches = Some(value);
+		value
+	}
+	pub(super) fn executable(&mut self, value: bool) -> bool {
+		self.executable_matches = Some(value);
+		value
+	}
+	pub(super) fn argv(&mut self, value: bool) -> bool {
+		self.argv_matches = Some(value);
+		value
+	}
+}
+
+pub(super) fn expected_argv_mode(args: &[String]) -> &'static str {
+	let master = args.iter().any(|value| value == "ControlMaster=yes");
+	let slave = args.iter().any(|value| value == "ControlMaster=no");
+	let effective = args.iter().any(|value| value == "-G");
+	match (master, slave, effective) {
+		(true, false, true) => "effective_master",
+		(false, true, true) => "effective_slave",
+		(true, false, false) => "master",
+		(false, true, false) => "slave",
+		_ => "unknown",
+	}
+}
+
+#[derive(Clone, Copy, Serialize)]
+pub(super) struct ProbeResult {
+	kind: &'static str,
+	errno: Option<i32>,
+	errno_category: Option<&'static str>,
+}
+
+impl ProbeResult {
+	fn status(kind: &'static str) -> Self {
+		Self {
+			kind,
+			errno: None,
+			errno_category: None,
+		}
+	}
+	fn error(error: &anyhow::Error) -> Self {
+		let errno = error.chain().find_map(|cause| {
+			cause
+				.downcast_ref::<std::io::Error>()
+				.and_then(std::io::Error::raw_os_error)
+		});
+		Self {
+			kind: "error",
+			errno,
+			errno_category: Some(errno_category(errno)),
+		}
+	}
+	pub(super) fn terminal(result: &anyhow::Result<bool>) -> Self {
+		match result {
+			Ok(true) => Self::status("exited"),
+			Ok(false) => Self::status("not_exited"),
+			Err(error) => Self::error(error),
+		}
+	}
+	fn cleanup(result: &anyhow::Result<()>) -> Self {
+		match result {
+			Ok(()) => Self::status("succeeded"),
+			Err(error) => Self::error(error),
+		}
+	}
+}
+
+#[derive(Clone, Copy, Serialize)]
+pub(super) struct SpawnProofObservation {
+	// Private same-run correlation only: neither value proves identity.
+	pub pid: u32,
+	pub owned_child_id: u64,
+	pub expected_argv_mode: &'static str,
+	pub pid_available: bool,
+	pub pidfd_available: bool,
+	pub pidfd_errno: Option<i32>,
+	pub identity_available: bool,
+	pub identity_observation: IdentityObservation,
+	pub identity_matches: bool,
+	pub initial_terminal_probe: ProbeResult,
+}
+
+#[derive(Serialize)]
+struct FailureEvent {
+	schema: &'static str,
+	sequence: u64,
+	expected_argv_mode_is_not_verified_process_identity: bool,
+	initial_proof_passed: bool,
+	pool_stop_cancelled_before_cleanup: bool,
+	no_retry_or_fallback: bool,
+	pidfd_probe_kind: &'static str,
+	pidfd_errno_category: Option<&'static str>,
+	#[serde(flatten)]
+	observation: SpawnProofObservation,
+	stop_reap: ProbeResult,
+	ledger_release: ProbeResult,
+	failure_guard_closed: bool,
+}
+
+pub(super) struct SpawnFailureGuard {
+	index: Option<usize>,
+	owner_thread: std::thread::ThreadId,
+}
+
+impl SpawnFailureGuard {
+	pub(super) fn new(build: impl FnOnce() -> SpawnProofObservation) -> Self {
+		let mut sequence = None;
+		with_state(|state| {
+			state.seen = state.seen.saturating_add(1);
+			if state.seen <= FAILURE_EVENT_LIMIT {
+				sequence = Some(state.seen);
+			} else {
+				state.capped = state.capped.saturating_add(1);
+			}
+		});
+		let mut index = None;
+		if let Some(sequence) = sequence {
+			let observation = build();
+			let (kind, errno_class) = if !observation.pid_available {
+				("not_attempted_pid_unavailable", None)
+			} else if observation.pidfd_available {
+				("acquired", None)
+			} else {
+				("failed", Some(errno_category(observation.pidfd_errno)))
+			};
+			let event = FailureEvent {
+				schema: "hepta-x230-spawn-proof-failure/v2-d4",
+				sequence,
+				expected_argv_mode_is_not_verified_process_identity: true,
+				initial_proof_passed: false,
+				pool_stop_cancelled_before_cleanup: true,
+				no_retry_or_fallback: true,
+				pidfd_probe_kind: kind,
+				pidfd_errno_category: errno_class,
+				observation,
+				stop_reap: ProbeResult::status("not_attempted"),
+				ledger_release: ProbeResult::status("not_attempted"),
+				failure_guard_closed: false,
+			};
+			with_state(|state| {
+				if state.events.len() < FAILURE_EVENT_LIMIT as usize {
+					index = Some(state.events.len());
+					state.events.push(event);
+				}
+			});
+		}
+		Self {
+			index,
+			owner_thread: std::thread::current().id(),
+		}
+	}
+	fn update(&mut self, apply: impl FnOnce(&mut FailureEvent)) {
+		if self.owner_thread != std::thread::current().id() {
+			return;
+		}
+		let Some(index) = self.index else {
+			return;
+		};
+		with_state(|state| {
+			if let Some(event) = state.events.get_mut(index) {
+				apply(event);
+			}
+		});
+	}
+	pub(super) fn stopping(&mut self) {
+		self.update(|event| {
+			event.stop_reap = ProbeResult::status("in_progress");
+		});
+	}
+	pub(super) fn stopped(&mut self, result: &anyhow::Result<()>) {
+		self.update(|event| {
+			event.stop_reap = ProbeResult::cleanup(result);
+		});
+	}
+	pub(super) fn releasing(&mut self) {
+		self.update(|event| {
+			event.ledger_release = ProbeResult::status("in_progress");
+		});
+	}
+	pub(super) fn released(&mut self, result: &anyhow::Result<()>) {
+		self.update(|event| {
+			event.ledger_release = ProbeResult::cleanup(result);
+		});
+	}
+}
+
+impl Drop for SpawnFailureGuard {
+	fn drop(&mut self) {
+		self.update(|event| {
+			event.failure_guard_closed = true;
+			close_incomplete_probes(event);
+		});
+	}
+}
+
+fn close_incomplete_probes(event: &mut FailureEvent) {
+	if event.stop_reap.kind == "in_progress" {
+		event.stop_reap.kind = "not_completed";
+	}
+	if event.ledger_release.kind == "in_progress" {
+		event.ledger_release.kind = "not_completed";
+	}
+}
+
+#[derive(Serialize)]
+struct FlushedEvent<'a> {
+	#[serde(flatten)]
+	event: &'a FailureEvent,
+	owner_cleanup: ProbeResult,
+	flush_after_owner_cleanup_returned: bool,
+	failures_seen: u64,
+	failures_capped: u64,
+	failures_buffered: usize,
+	failures_reserved_but_not_buffered: u64,
+}
+
+fn finish_cleanup_with_writer(cleanup: &anyhow::Result<()>, writer: &mut impl Write) {
+	let state = STATE
+		.try_with(|slot| slot.try_borrow_mut().ok().and_then(|mut slot| slot.take()))
+		.ok()
+		.flatten();
+	let Some(mut state) = state else {
+		return;
+	};
+	let owner_cleanup = ProbeResult::cleanup(cleanup);
+	// Keep already captured evidence even if shutdown returned an error before
+	// an owner task was dropped. Never claim its unfinished cleanup completed.
+	for event in &mut state.events {
+		close_incomplete_probes(event);
+	}
+	for event in &state.events {
+		let output = FlushedEvent {
+			event,
+			owner_cleanup,
+			flush_after_owner_cleanup_returned: true,
+			failures_seen: state.seen,
+			failures_capped: state.capped,
+			failures_buffered: state.events.len(),
+			failures_reserved_but_not_buffered: state
+				.seen
+				.min(FAILURE_EVENT_LIMIT)
+				.saturating_sub(state.events.len() as u64),
+		};
+		// Logging failure cannot replace the original operation or cleanup result.
+		// Stop after a partial write so no later record masquerades as complete.
+		if writer.write_all(PREFIX).is_err()
+			|| serde_json::to_writer(&mut *writer, &output).is_err()
+			|| writer.write_all(b"\n").is_err()
+		{
+			break;
+		}
+	}
+}
+
+pub(super) fn finish_cleanup(cleanup: &anyhow::Result<()>) {
+	finish_cleanup_with_writer(cleanup, &mut std::io::stderr().lock());
+}
+
