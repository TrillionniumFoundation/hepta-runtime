+#[test]
+fn d4_flush_write_failure_does_not_change_cleanup_result() {
+	struct Reject;
+	impl Write for Reject {
+		fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+			Err(std::io::Error::from_raw_os_error(libc::EPIPE))
+		}
+		fn flush(&mut self) -> std::io::Result<()> {
+			Ok(())
+		}
+	}
+	let _state = TestState::start();
+	drop(SpawnFailureGuard::new(|| observation(1)));
+	let cleanup = Err(anyhow::Error::from(std::io::Error::from_raw_os_error(
+		libc::EACCES,
+	)));
+	finish_cleanup_with_writer(&cleanup, &mut Reject);
+	assert_eq!(
+		cleanup
+			.as_ref()
+			.unwrap_err()
+			.downcast_ref::<std::io::Error>()
+			.unwrap()
+			.raw_os_error(),
+		Some(libc::EACCES)
+	);
+	let mut output = Vec::new();
+	finish_cleanup_with_writer(&cleanup, &mut output);
+	assert!(output.is_empty());
+	initialize();
+	finish_cleanup_with_writer(&Ok(()), &mut output);
+	assert!(output.is_empty());
+}
