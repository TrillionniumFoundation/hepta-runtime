+/// Callers hold STORE_LOCK. Metadata queries consume the archive, not copies of
+/// the hot records. Preserve the fresh archive and hot-namespace checks on a
+/// cache hit; a miss still runs the complete existing validation/seeding path.
+#[cfg(unix)]
+fn metadata_archive(root: &Path, directory: &File) -> Result<Archive> {
+	let archive = open_archive(root)?;
+	let stamp = archive_stamp(directory)?;
+	let cached = HOT_CACHE
+		.get_or_init(|| Mutex::new(VecDeque::new()))
+		.lock()
+		.map_err(|_| anyhow!("request hot cache unavailable"))?
+		.iter()
+		.any(|entry| entry.stamp == stamp);
+	if !cached {
+		// A miss repeats the stamp/cache lookup before the unchanged cold path.
+		// The miss still validates all hot records and seeds any absent originals.
+		hot_snapshot_at(directory, &archive, false)?;
+	}
+	Ok(archive)
+}
