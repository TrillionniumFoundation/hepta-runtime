+class DependencySelection(unittest.TestCase):
+    PROFILE = {"debug_assertions": False, "debuginfo": 0, "opt_level": "3", "overflow_checks": False, "test": False}
+
+    def records(self, directory):
+        runtime = {"executable": str(directory / "release/hepta-runtime"), "profile": dict(self.PROFILE)}
+        target = {"reason": "compiler-artifact", "target": {"name": "serde_json", "kind": ["lib"]},
+                  "profile": dict(self.PROFILE), "features": ["alloc", "default", "std"],
+                  "filenames": [str(directory / "release/deps/libserde_json-target.rlib")]}
+        host = copy.deepcopy(target)
+        host["profile"]["opt_level"] = "0"
+        host["features"] = ["default", "std"]
+        host["filenames"] = [str(directory / "release/deps/libserde_json-host.rlib")]
+        return runtime, host, target
+
+    def test_host_target_selection_is_profile_based_and_order_independent(self):
+        runtime, host, target = self.records(Path("/fixture"))
+        for records in ([host, target], [target, host]):
+            chosen, evidence = release_artifact(records, "serde_json", runtime)
+            self.assertEqual(chosen, target)
+            self.assertEqual(len(evidence["considered_artifacts"]), 2)
+            rejected = [row for row in evidence["considered_artifacts"] if not row["selected"]]
+            self.assertEqual(rejected[0]["compiler_artifact"], host)
+            self.assertEqual(rejected[0]["excluded_reasons"], ["profile_differs_from_qualified_runtime"])
+
+    def test_no_match_duplicate_or_nonmatching_full_profile_never_falls_back(self):
+        runtime, host, target = self.records(Path("/fixture"))
+        duplicate = copy.deepcopy(target)
+        duplicate["filenames"] = ["/fixture/release/deps/libserde_json-other.rlib"]
+        for rows in ([host], [target, duplicate]):
+            with self.assertRaises(ValueError):
+                release_artifact(rows, "serde_json", runtime)
+        for changed in ("profile", "path"):
+            different = copy.deepcopy(target)
+            if changed == "profile":
+                different["profile"]["overflow_checks"] = True
+            else:
+                different["filenames"] = ["/other/release/deps/libserde_json-target.rlib"]
+            with self.assertRaises(ValueError):
+                release_artifact([different], "serde_json", runtime)
+
+    def test_selected_dependency_still_requires_exact_manifest_lock_and_hash(self):
+        with tempfile.TemporaryDirectory(prefix="a27-selector-", dir=HERE) as temporary:
+            directory = Path(temporary)
+            runtime, host, target = self.records(directory)
+            artifact = Path(target["filenames"][0])
+            artifact.parent.mkdir(parents=True)
+            artifact.write_bytes(b"synthetic metadata fixture, not a Rust executable")
+            manifest = directory / "Cargo.toml"
+            manifest.write_text('[package]\nname = "serde_json"\nversion = "1.0.151"\n')
+            source = "registry+https://github.com/rust-lang/crates.io-index"
+            for row in (host, target):
+                row["manifest_path"] = str(manifest)
+                row["package_id"] = source + "#serde_json@1.0.151"
+            locked = {"package": [{"name": "serde_json", "version": "1.0.151", "source": source}]}
+            selected = select_dependency([host, target], "serde_json", locked, runtime)
+            self.assertEqual(selected["compiler_artifact"], target)
+            self.assertEqual(selected["rlib"]["sha256"], hashlib.sha256(artifact.read_bytes()).hexdigest())
+            locked["package"][0]["version"] = "1.0.150"
+            with self.assertRaises(ValueError):
+                select_dependency([host, target], "serde_json", locked, runtime)
+
+
