Host hepta-rog
    HostName REPLACE_ROG_ADDRESS
    User hepta-runtime
    IdentityFile /var/lib/hepta-runtime/.ssh/id_ed25519
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes

Host hepta-pocket4
    HostName 127.0.0.1
    User hepta-runtime
    IdentityFile /var/lib/hepta-runtime/.ssh/id_ed25519
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes

Host hepta-mac
    HostName REPLACE_MAC_ADDRESS
    User hepta-runtime
    IdentityFile /var/lib/hepta-runtime/.ssh/id_ed25519
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
