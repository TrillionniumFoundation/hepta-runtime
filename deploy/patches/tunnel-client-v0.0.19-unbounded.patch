@@ -0,0 +1,71 @@
+package runtimeconfig
+
+import "testing"
+
+func TestMCPConcurrencyZeroIsUnboundedAndPositiveLimitsRemainCompatible(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name string
+		args []string
+		env  string
+		want int
+		bad  bool
+	}{
+		{name: "upstream_default", want: 10},
+		{name: "zero_flag", args: []string{"--mcp.max-concurrent-requests=0"}},
+		{name: "zero_env", env: "0"},
+		{name: "positive_flag", args: []string{"--mcp.max-concurrent-requests=12"}, want: 12},
+		{name: "positive_env", env: "12", want: 12},
+		{name: "negative_flag", args: []string{"--mcp.max-concurrent-requests=-1"}, bad: true},
+		{name: "negative_env", env: "-1", bad: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			env := map[string]string{
+				"CONTROL_PLANE_TUNNEL_ID": envTunnelID,
+				"CONTROL_PLANE_API_KEY":   "test-control-key",
+				"MCP_SERVER_URL":          "https://example.com/mcp",
+			}
+			if tc.env != "" {
+				env["MCP_MAX_CONCURRENT_REQUESTS"] = tc.env
+			}
+			cfg, err := LoadRuntimeForTest(tc.args, lookupEnvMap(env))
+			if tc.bad {
+				if err == nil {
+					t.Fatal("negative concurrency limit was accepted")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("load concurrency configuration: %v", err)
+			}
+			if cfg.MCP.MaxConcurrentRequests != tc.want {
+				t.Fatalf("concurrency = %d, want %d", cfg.MCP.MaxConcurrentRequests, tc.want)
+			}
+		})
+	}
+}
+
+func TestMCPConcurrencyYAMLExplicitZeroSurvivesConfigurationMerge(t *testing.T) {
+	t.Parallel()
+	path := writeTempConfigFile(t, `
+config_version: 1
+control_plane:
+  tunnel_id: tunnel_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
+  api_key: env:TEST_CONTROL_KEY
+mcp:
+  server_urls:
+    - channel: main
+      url: https://example.com/mcp
+  max_concurrent_requests: 0
+`)
+	cfg, err := LoadRuntimeForTest([]string{"--config", path}, lookupEnvMap(map[string]string{
+		"TEST_CONTROL_KEY": "test-control-key",
+	}))
+	if err != nil {
+		t.Fatalf("load explicit zero YAML: %v", err)
+	}
+	if cfg.MCP.MaxConcurrentRequests != 0 {
+		t.Fatalf("explicit YAML zero was replaced by %d", cfg.MCP.MaxConcurrentRequests)
+	}
+}
