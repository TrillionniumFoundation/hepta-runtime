index 0000000000000000000000000000000000000000..1dd9b7b81350855785c6181ddc509b53cccb65f7
--- /dev/null
+++ b/cmd/client/hepta_unix_doctor_test.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDoctorUsesConfiguredUnixHTTPBridge(t *testing.T) {
+	t.Parallel()
+	if runtime.GOOS == "windows" {
+		t.Skip("private Unix HTTP bridge is Unix-only")
+	}
+	// A short private directory also fits macOS's Unix-socket path limit.
+	directory, err := os.MkdirTemp("", "hepta-doctor-")
+	require.NoError(t, err)
+	defer func() { require.NoError(t, os.RemoveAll(directory)) }()
+	socket := filepath.Join(directory, "bridge.sock")
+	listener, err := net.Listen("unix", socket)
+	require.NoError(t, err)
+	require.NoError(t, os.Chmod(socket, 0o600))
+	var mu sync.Mutex
+	var paths []string
+	server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		paths = append(paths, r.URL.Path)
+		mu.Unlock()
+		if r.URL.Path == "/mcp" {
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		http.NotFound(w, r)
+	})}
+	defer func() { require.NoError(t, server.Close()) }()
+	go func() { _ = server.Serve(listener) }()
+	config := filepath.Join(directory, "profile.yaml")
+	require.NoError(t, os.WriteFile(config, []byte(fmt.Sprintf(`config_version: 1
+control_plane:
+  tunnel_id: tunnel_0123456789abcdef0123456789abcdef
+  api_key: env:HEPTA_TEST_CONTROL_KEY
+mcp:
+  server_urls:
+    - channel: main
+      url: http://localhost/mcp
+      unix_socket: %q
+  max_concurrent_requests: 0
+`, socket)), 0o600))
+	stdout, stderr, err := executeCommand(t, map[string]string{
+		"HOME": directory, "HEPTA_TEST_CONTROL_KEY": "private-test-control-key",
+	}, "doctor", "--config", config, "--health.listen-addr", "127.0.0.1:0", "--json")
+	require.NoError(t, err, stdout)
+	require.Empty(t, stderr)
+	var report doctorReport
+	require.NoError(t, json.Unmarshal([]byte(stdout), &report))
+	require.Equal(t, "ok", report.Result)
+	mu.Lock()
+	defer mu.Unlock()
+	require.Contains(t, paths, "/mcp")
+	require.True(t, slices.ContainsFunc(paths, func(path string) bool {
+		return strings.HasPrefix(path, "/.well-known/")
+	}), "OAuth absence must be checked on the same Unix HTTP endpoint")
+}
diff --git a/pkg/dispatcher/internal/unbounded_concurrency_test.go b/pkg/dispatcher/internal/unbounded_concurrency_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..29aeee27b49cf0cb77a5da18ce1ad610b3a227b0
--- /dev/null
+++ b/pkg/dispatcher/internal/unbounded_concurrency_test.go
@@ -0,0 +1,108 @@
+package dispatcherinternal
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/otel/sdk/metric/metricdata"
+
+	"github.com/openai/tunnel-client/pkg/controlplane"
+	"github.com/openai/tunnel-client/pkg/healthstate"
+	"github.com/openai/tunnel-client/pkg/types"
+)
+
+func TestZeroConcurrencyDispatchesBeyondPriorLimitsAndDrainsOriginalCommands(t *testing.T) {
+	t.Parallel()
+	const count = 64
+	block := make(chan struct{})
+	release := sync.OnceFunc(func() { close(block) })
+	defer release()
+	processor := &stubProcessor{
+		started:  make(chan types.RequestID, count),
+		finished: make(chan types.RequestID, count),
+		block:    block,
+	}
+	cfg := newTestMCPConfigQueue(t, 0)
+	meterProvider, reader := newManualMeterProviderWithReader(t)
+	queue := make(controlplane.PolledCommandQueue, count)
+	listener, err := NewQueueListener(slog.New(slog.NewTextHandler(io.Discard, nil)), processor, queue, cfg, meterProvider)
+	require.NoError(t, err)
+	activity := NewActivityHealth(cfg)
+	listener.ObserveHealth(nil, activity)
+	listener.Start(t.Context())
+	for index := range count {
+		queue <- newTestCommand(index)
+	}
+	close(queue)
+	for index := range count {
+		select {
+		case <-processor.started:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("command %d did not enter while the prior commands remained active", index)
+		}
+	}
+	details := activity.Snapshot(time.Now()).Details.(healthstate.DispatcherDetails)
+	require.Zero(t, details.PoolLimit)
+	require.Equal(t, uint64(count), details.Active)
+	var metrics metricdata.ResourceMetrics
+	require.NoError(t, reader.Collect(context.Background(), &metrics))
+	assertGaugeValue(t, metrics, "dispatcher_worker_pool_capacity", 0)
+	waitDone := make(chan struct{})
+	go func() { listener.Wait(); close(waitDone) }()
+	select {
+	case <-waitDone:
+		t.Fatal("listener released original commands before they completed")
+	case <-time.After(25 * time.Millisecond):
+	}
+	release()
+	select {
+	case <-waitDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("listener did not finish draining original commands")
+	}
+	processor.requireCalls(t, count)
+	details = activity.Snapshot(time.Now()).Details.(healthstate.DispatcherDetails)
+	require.Zero(t, details.Active)
+	require.Equal(t, uint64(count), details.Completed)
+}
+
+func TestZeroConcurrencyPreservesCancellationAndOriginalDrain(t *testing.T) {
+	t.Parallel()
+	const count = 32
+	processor := &stubProcessor{started: make(chan types.RequestID, count), block: make(chan struct{})}
+	cfg := newTestMCPConfigQueue(t, 0)
+	queue := make(controlplane.PolledCommandQueue, count)
+	listener, err := NewQueueListener(slog.New(slog.NewTextHandler(io.Discard, nil)), processor, queue, cfg, newManualMeterProvider(t))
+	require.NoError(t, err)
+	activity := NewActivityHealth(cfg)
+	listener.ObserveHealth(nil, activity)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	listener.Start(ctx)
+	for index := range count {
+		queue <- newTestCommand(index)
+	}
+	for index := range count {
+		select {
+		case <-processor.started:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("command %d never started", index)
+		}
+	}
+	cancel()
+	waitDone := make(chan struct{})
+	go func() { listener.Wait(); close(waitDone) }()
+	select {
+	case <-waitDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("canceled original commands were not drained")
+	}
+	details := activity.Snapshot(time.Now()).Details.(healthstate.DispatcherDetails)
+	require.Zero(t, details.Active)
+	require.Equal(t, uint64(count), details.Completed)
+}
