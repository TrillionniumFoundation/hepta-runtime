# Install as /etc/hepta-runtime/tunnel.env, owner root:hepta-runtime, mode 0640.
# Use a runtime API key with Tunnels Read + Use. Never use an admin API key.
CONTROL_PLANE_API_KEY=sk_REPLACE_ME
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_ME
MCP_EXTRA_HEADERS="X-Hepta-Runtime-Token: file:/etc/hepta-runtime/mcp-token"
