def io(s:readbuf, o:mutbuf, w:mutbuf) -> u32:
    if length(s) >= 64 and read64(s, 0) == COMMAND_MAGIC:
        return command(s, o)
    if length(s) != 128 or read64(s, 0) != REQUEST_MAGIC:
        return 4294967295
    op = read64(s, 8)
    cap = read64(s, 16)
    gen = read64(s, 24)
    a = read64(s, 32)
    b = read64(s, 40)
    c = read64(s, 48)
    lo = read64(s, 56)
    hi = read64(s, 64)
    seq = read64(s, 72)
    at = 80
    while at < 128:
        if read64(s, at) != 0:
            return 4294967295
        at = at + 8
    if op > 3 or cap == 0 or gen == 0:
        return 4294967295
    if length(o) < 320 or length(w) < 256:
        return 4294967294
    if op == 0:
        if b > 7 or c != 0 or seq != 0:
            return 4294967295
        at = 0
        while at < 256:
            if get(w, at) != 0:
                return 4294967295
            at = at + 8
        put(w, 0, STATE_MAGIC)
        put(w, 8, cap)
        put(w, 16, gen)
        put(w, 32, a)
        put(w, 224, b)
        put(w, 48, b & 1)
        put(w, 56, (b >> 1) & 1)
        put(w, 64, (b >> 2) & 1)
        put(w, 120, lo)
        put(w, 128, hi)
        if (b & 1) == 0:
            fail(w, 4, 0)
        elif (b & 2) == 0:
            fail(w, 5, 0)
        elif (b & 4) == 0:
            fail(w, 6, 0)
        return reply(o, w, op, 0)
    if valid(w) == False or get(w, 8) != cap or get(w, 16) != gen:
        return 4294967295
    if op == 2:
        if lo != 0 or hi != 0 or seq == 0 or seq != get(w, 176) or get(w, 168) == 0:
            return 4294967295
        return ack(o, w, a, b, c)
    if seq != 0 or get(w, 168) != 0:
        return 4294967295
    if op == 3:
        if a != 0 or b != 0 or c != 0 or lo != 0 or hi != 0:
            return 4294967295
        return reply(o, w, op, 0)
    if a > 1 or b > 1 or c > 15 or get(w, 176) == 18446744073709551615:
        return 4294967295
    if get(w, 152) == 1 and before(lo, hi, get(w, 136), get(w, 144)):
        return 4294967295
    put(w, 136, lo)
    put(w, 144, hi)
    put(w, 152, 1)
    clear_append(w)
    phase = get(w, 24)
    if phase == 1:
        return reply(o, w, op, 2)
    if phase == 0:
        if a == 1:
            fail(w, 1, 0)
        elif b == 1:
            fail(w, 2, 0)
        elif before(lo, hi, get(w, 120), get(w, 128)) == False:
            fail(w, 3, 0)
    if get(w, 24) == 2:
        if get(w, 48) != 0:
            return issue(o, w, 5, 0, 0)
        if get(w, 56) != 0:
            return issue(o, w, 6, 0, 0)
        if get(w, 64) != 0:
            return issue(o, w, 7, 0, 0)
        return reply(o, w, op, 3)
    if get(w, 48) == 1 and get(w, 40) == get(w, 32):
        return issue(o, w, 5, 0, 0)
    if get(w, 56) == 2:
        return issue(o, w, 6, 0, 0)
    if get(w, 64) == 2:
        return issue(o, w, 7, 0, 0)
    if get(w, 48) == 0 and get(w, 56) == 0 and get(w, 64) == 0 and get(w, 72) == 1:
        put(w, 24, 1)
        return reply(o, w, op, 2)
    tried = 0
    cursor = get(w, 160)
    while tried < 4:
        if cursor == 0 and get(w, 48) == 1 and (c & 1) != 0:
            remaining = get(w, 32) - get(w, 40)
            if remaining > 8192:
                remaining = 8192
            return issue(o, w, 1, get(w, 40), remaining)
        if cursor == 1 and get(w, 56) == 1 and (c & 2) != 0:
            return issue(o, w, 2, get(w, 88), 8192)
        if cursor == 2 and get(w, 64) == 1 and (c & 4) != 0:
            return issue(o, w, 3, get(w, 96), 8192)
        if cursor == 3 and get(w, 72) == 0 and (c & 8) != 0:
            return issue(o, w, 4, 0, 0)
        cursor = (cursor + 1) & 3
        tried = tried + 1
    return reply(o, w, op, 0)

def ack(o:mutbuf, w:mutbuf, value:u64, b:u64, c:u64) -> u32:
    action = get(w, 168)
    negative = (value & 9223372036854775808) != 0
    error = 0
    if negative:
        error = 0 - value
        if error == 0 or error > 4095:
            return 4294967295
    if action <= 3:
        if c != 0:
            return 4294967295
        if action == 1 or negative or value == 0:
            if b != 0:
                return 4294967295
        elif b != value:
            return 4294967295
        if negative == False and value > get(w, 184):
            return 4294967295
    elif action == 4:
        if c == 0:
            return 4294967295
        if negative or value == 0:
            if b != 0:
                return 4294967295
        elif value != c or b > 4294967295:
            return 4294967295
    else:
        if b != 0 or c != 0 or (negative == False and value != 0):
            return 4294967295
    clear_append(w)
    put(w, 168, 0)
    put(w, 184, 0)
    put(w, 192, 0)
    if action <= 4:
        put(w, 160, action & 3)
    if action >= 5:
        put(w, 48 + (action - 5) * 8, 0)
        put(w, 240, get(w, 240) + 1)
        return reply(o, w, 2, 0)
    if negative:
        if error == 4 or (action <= 3 and error == 11):
            return reply(o, w, 2, 0)
        reason = 7
        if action == 2:
            reason = 9
        elif action == 3:
            reason = 10
        elif action == 4:
            reason = 13
        fail(w, reason, error)
        return reply(o, w, 2, 3)
    if action == 1:
        if value == 0:
            fail(w, 8, 0)
            return reply(o, w, 2, 3)
        put(w, 40, get(w, 40) + value)
    elif action == 4:
        if value != 0:
            put(w, 72, 1)
            put(w, 80, b)
    elif value == 0:
        put(w, 56 + (action - 2) * 8, 2)
    else:
        offset = 88 + (action - 2) * 8
        previous = get(w, offset)
        if value > 8388608 - previous:
            fail(w, 9 + action, 0)
            return reply(o, w, 2, 3)
        put(w, offset, previous + value)
        put(w, 200, action - 1)
        put(w, 208, previous)
        put(w, 216, value)
    return reply(o, w, 2, 0)

def issue(o:mutbuf, w:mutbuf, action:u64, offset:u64, count:u64) -> u32:
    if get(w, 176) == 18446744073709551615:
        return 4294967295
    put(w, 176, get(w, 176) + 1)
    put(w, 168, action)
    put(w, 184, count)
    put(w, 192, offset)
    return reply(o, w, 1, 1)

def fail(w:mutbuf, reason:u64, error:u64) -> u64:
    put(w, 24, 2)
    put(w, 104, reason)
    put(w, 112, error)
    return 0

def clear_append(w:mutbuf) -> u64:
    put(w, 200, 0)
    put(w, 208, 0)
    put(w, 216, 0)
    return 0

def reply(o:mutbuf, w:mutbuf, op:u64, status:u64) -> u32:
    put(o, 0, RESULT_MAGIC)
    put(o, 8, 320)
    put(o, 16, op)
    put(o, 24, status)
    put(o, 32, get(w, 168))
    put(o, 40, get(w, 176))
    put(o, 48, get(w, 200))
    put(o, 56, get(w, 208))
    copy_range(o, w, 64, 0, 256)
    return 320

def before(al:u64, ah:u64, bl:u64, bh:u64) -> bool:
    return ah < bh or (ah == bh and al < bl)

def valid(w:mutbuf) -> bool:
    if get(w, 0) != STATE_MAGIC or get(w, 8) == 0 or get(w, 16) == 0:
        return False
    if get(w, 24) > 2 or get(w, 40) > get(w, 32) or get(w, 48) > 1 or get(w, 56) > 2 or get(w, 64) > 2:
        return False
    if get(w, 72) > 1 or get(w, 80) > 4294967295 or get(w, 88) > 8388608 or get(w, 96) > 8388608:
        return False
    if get(w, 104) > 13 or get(w, 112) > 4095 or get(w, 152) > 1 or get(w, 160) > 3:
        return False
    action = get(w, 168)
    if action > 7 or get(w, 200) > 2 or get(w, 240) > 3 or get(w, 224) > 7 or get(w, 232) != 0 or get(w, 248) != 0:
        return False
    mask = get(w, 224)
    initial = (mask & 1) + ((mask >> 1) & 1) + ((mask >> 2) & 1)
    opened = 0
    role = 0
    while role < 3:
        flag = get(w, 48 + role * 8)
        if flag != 0:
            if ((mask >> role) & 1) == 0:
                return False
            opened = opened + 1
        role = role + 1
    if initial - opened != get(w, 240):
        return False
    if action >= 5 and get(w, 48 + (action - 5) * 8) == 0:
        return False
    if action == 0:
        if get(w, 184) != 0 or get(w, 192) != 0:
            return False
    elif get(w, 176) == 0:
        return False
    if action == 1:
        if get(w, 48) != 1 or get(w, 184) == 0 or get(w, 184) > 8192 or get(w, 192) != get(w, 40) or get(w, 184) > get(w, 32) - get(w, 40):
            return False
    if action == 2 or action == 3:
        if get(w, 184) != 8192 or get(w, 192) != get(w, 88 + (action - 2) * 8) or get(w, 56 + (action - 2) * 8) != 1:
            return False
    if action >= 4:
        if get(w, 184) != 0 or get(w, 192) != 0:
            return False
    if get(w, 200) == 0:
        if get(w, 208) != 0 or get(w, 216) != 0:
            return False
    else:
        if get(w, 216) == 0 or get(w, 216) > 8192 or get(w, 208) + get(w, 216) != get(w, 88 + (get(w, 200) - 1) * 8):
            return False
    phase = get(w, 24)
    if phase == 2:
        if get(w, 104) == 0:
            return False
    elif get(w, 104) != 0 or get(w, 112) != 0:
        return False
    if phase == 1 and (get(w, 48) != 0 or get(w, 56) != 0 or get(w, 64) != 0 or get(w, 72) != 1 or action != 0):
        return False
    if get(w, 72) == 0 and get(w, 80) != 0:
        return False
    if get(w, 152) == 0 and (get(w, 136) != 0 or get(w, 144) != 0):
        return False
    return True

def command(s:readbuf, o:mutbuf) -> u32:
    size = length(s)
    path_len = read64(s, 8)
    argc = read64(s, 16)
    envc = read64(s, 24)
    flags = read64(s, 32)
    if read64(s, 40) != size or read64(s, 48) != 0 or read64(s, 56) != 0:
        return 4294967295
    if argc == 0 or flags > 63 or ((flags & 7) & (flags >> 3)) != 0:
        return 4294967295
    if argc > (size - 64) // 9 or envc > (size - 64) // 9 or argc + envc > (size - 64) // 9:
        return 4294967295
    if path_len == 0 or path_len > size - 64 or path_len == size - 64:
        return 4294967295
    at = 64
    end = at + path_len
    while at < end:
        if byte(s, at) == 0:
            return 4294967295
        at = at + 1
    if byte(s, at) != 0:
        return 4294967295
    at = at + 1
    i = 0
    count = argc + envc
    while i < count:
        if size - at < 9:
            return 4294967295
        n = read64(s, at)
        at = at + 8
        if n >= size - at:
            return 4294967295
        end = at + n
        while at < end:
            if byte(s, at) == 0:
                return 4294967295
            at = at + 1
        if byte(s, at) != 0:
            return 4294967295
        at = at + 1
        i = i + 1
    if at != size:
        return 4294967295
    extent = 64 + count * 8
    if extent > 4294901759:
        return 4294967295
    if length(o) < extent:
        return 4294967294
    put(o, 0, COMMAND_RESULT)
    put(o, 8, extent)
    put(o, 16, 64)
    put(o, 24, argc)
    put(o, 32, envc)
    put(o, 40, flags)
    put(o, 48, size)
    put(o, 56, 0)
    at = 65 + path_len
    i = 0
    while i < count:
        n = read64(s, at)
        at = at + 8
        put(o, 64 + i * 8, at)
        at = at + n + 1
        i = i + 1
    return extent
