    i=1
    while i<width:
        next=byte(w,at+i)
        if next<128 or next>191:
            return ((56320+first)<<3)|1
        value=(value<<6)|(next&63)
        i=i+1
    if value<minimum or value>1114111 or (value>=55296 and value<=57343):
        return ((56320+first)<<3)|1
    return (value<<3)|width

def name_less(w:mutbuf,left:u64,right:u64) -> u64:
    a=8192+get(w,left)
    b=8192+get(w,right)
    ae=a+get(w,left+8)
    be=b+get(w,right+8)
    while a<ae and b<be:
        ac=scalar(w,a,ae)
        bc=scalar(w,b,be)
        if (ac>>3)<(bc>>3):
            return 1
        if (ac>>3)>(bc>>3):
            return 0
        a=a+(ac&7)
        b=b+(bc&7)
    if a==ae and b!=be:
        return 1
    return 0

def sort_names(w:mutbuf) -> u64:
    count=get(w,8192+56)
    i=0
    while i<count:
        put(w,get(w,344)+i*8,i)
        j=i
        moving=1
        while j>0 and moving!=0:
            left=get(w,get(w,344)+(j-1)*8)
            if name_less(w,8192+128+i*32,8192+128+left*32)==0:
                moving=0
            else:
                put(w,get(w,344)+j*8,left)
                j=j-1
        put(w,get(w,344)+j*8,i)
        i=i+1
    return 0

def unicode_escape(w:mutbuf,at:u64,value:u64) -> u64:
    store(w,at,92)
    store(w,at+1,117)
    store(w,at+2,hex_digit((value>>12)&15))
    store(w,at+3,hex_digit((value>>8)&15))
    store(w,at+4,hex_digit((value>>4)&15))
    store(w,at+5,hex_digit(value&15))
    return at+6

def json_name(w:mutbuf,at:u64,source:u64,size:u64) -> u64:
    store(w,at,34)
    at=at+1
    end=source+size
    while source<end:
        code=scalar(w,source,end)
        source=source+(code&7)
        value=code>>3
        if value==34 or value==92:
            store(w,at,92)
            store(w,at+1,value)
            at=at+2
        else:
            if value==8 or value==9 or value==10 or value==12 or value==13:
                escaped=98
                if value==9:
                    escaped=116
                if value==10:
                    escaped=110
                if value==12:
                    escaped=102
                if value==13:
                    escaped=114
                store(w,at,92)
                store(w,at+1,escaped)
                at=at+2
            else:
                if value<32 or value>=127:
                    if value<=65535:
                        at=unicode_escape(w,at,value)
                    else:
                        value=value-65536
                        at=unicode_escape(w,at,55296+(value>>10))
                        at=unicode_escape(w,at,56320+(value&1023))
                else:
                    store(w,at,value)
                    at=at+1
    store(w,at,34)
    return at+1

def summary_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==300:
        sort_names(w)
        put(w,160,0)
        put(w,8,301)
        return 4294967293
    if phase==301:
        index=get(w,160)
        if index==get(w,8192+56):
            put(w,8,310)
            return 4294967293
        row=8192+128+index*32
        codec(w)
        size=get(w,row+24)
        copy_within(w,get(w,328)+24,8192+get(w,row+16),size)
        return request(w,o,302,2,1,0,0,0,get(w,328),24+size)
    if phase==302:
        if result!=64 or get(w,48)!=64 or digest_valid(w,get(w,304))==0:
            return 4294967295
        copy_within(w,get(w,336)+get(w,160)*64,get(w,304),64)
        put(w,160,get(w,160)+1)
        put(w,8,301)
        return 4294967293
    if phase==310:
        index=named_attribute(w,8192,2)
        size=0
        codec(w)
        if index!=18446744073709551615:
            row=8192+128+index*32
            size=get(w,row+24)
            copy_within(w,get(w,328)+24,8192+get(w,row+16),size)
        return request(w,o,311,2,1,0,0,0,get(w,328),24+size)
    if phase==311:
        if result!=64 or get(w,48)!=64 or digest_valid(w,get(w,304))==0:
            return 4294967295
        copy_within(w,1536,get(w,304),64)
        put(w,8,320)
        return 4294967293
    if phase==320:
        size=render_summary(w)-get(w,352)
        if size>900000:
            return 4294967295
        put(w,232,size)
        put(w,240,get(w,352))
        put(w,8,999)
        return 4294967293
    return 4294967295

def codec(w:mutbuf) -> u64:
    put(w,get(w,328),3549757090987987528)
    put(w,get(w,328)+8,2)
    put(w,get(w,328)+16,0)
    return 0

def digest_valid(w:mutbuf,at:u64) -> u64:
    i=0
    while i<64:
        value=byte(w,at+i)
        if value<48 or value>102 or (value>57 and value<97):
            return 0
        i=i+1
    return 1

def render_summary(w:mutbuf) -> u64:
    at=wire_uid(w,get(w,352))
    at=decimal(w,at,get(w,8192+16))
    at=wire_gid(w,at)
    at=decimal(w,at,get(w,8192+24))
    at=wire_mode(w,at)
    at=decimal(w,at,get(w,8192+32))
    at=wire_links(w,at)
    at=decimal(w,at,get(w,8192+40))
    at=wire_names(w,at)
    index=0
    while index<get(w,8192+56):
        if index!=0:
            store(w,at,44)
            at=at+1
        row=8192+128+get(w,get(w,344)+index*8)*32
        at=json_name(w,at,8192+get(w,row),get(w,row+8))
        index=index+1
    at=wire_hashes(w,at)
    index=0
    while index<get(w,8192+56):
        if index!=0:
            store(w,at,44)
            at=at+1
        row=8192+128+index*32
        at=json_name(w,at,8192+get(w,row),get(w,row+8))
        store(w,at,58)
        at=json_name(w,at+1,get(w,336)+index*64,64)
        index=index+1
    at=wire_acl_hash(w,at)
    at=json_name(w,at,1536,64)
    return wire_platform(w,at)

def exception_class(w:mutbuf) -> u64:
    if get(w,216)!=0:
        return 1
    number=get(w,224)
    if number==1 or number==13:
        return 2
    if number==2:
        return 4
    if number==20:
        return 5
    if number==21:
        return 6
    if number==17:
        return 7
    if number==4:
        return 8
    if number==11 or number==114 or number==115:
        return 9
    if number==32 or number==108:
        return 10
    if number==110:
        return 11
    if number==104:
        return 12
    if number==103:
        return 13
    if number==111:
        return 14
    return 3

def finish(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    if phase==900:
        size=0
        if get(w,216)!=0:
            size=error_literal(w,get(w,352),get(w,216))-get(w,352)
        put(w,288,size)
        if get(w,264)!=0:
            put(w,get(w,352)+size,get(w,264)-1)
            size=size+8
        put(w,232,size)
        put(w,240,get(w,352))
        put(w,8,999)
        return 4294967293
    if phase!=999:
        return 4294967295
    size=get(w,232)
    if length(o)<64+size:
        return short_header(o,5,64+size)
    fill_range(o,0,64,0)
    put(o,0,3544386036883017032)
    put(o,16,get(w,16))
    put(o,24,get(w,56))
    if get(w,216)!=0 or get(w,224)!=0:
        put(o,8,3)
        put(o,24,exception_class(w))
        put(o,32,get(w,224))
        put(o,40,get(w,288))
        if get(w,264)!=0:
            put(o,48,2)
    put(o,56,size)
    copy_out(w,o,get(w,240),64,size)
    return 64
def load(s:readbuf,at:u64) -> u64:
    return byte(s,at)|(byte(s,at+1)<<8)|(byte(s,at+2)<<16)|(byte(s,at+3)<<24)|(byte(s,at+4)<<32)|(byte(s,at+5)<<40)|(byte(s,at+6)<<48)|(byte(s,at+7)<<56)

def get(w:mutbuf,at:u64) -> u64:
    return byte(w,at)|(byte(w,at+1)<<8)|(byte(w,at+2)<<16)|(byte(w,at+3)<<24)|(byte(w,at+4)<<32)|(byte(w,at+5)<<40)|(byte(w,at+6)<<48)|(byte(w,at+7)<<56)

def put(w:mutbuf,at:u64,value:u64) -> u64:
    store(w,at,value)
    store(w,at+1,value>>8)
    store(w,at+2,value>>16)
    store(w,at+3,value>>24)
    store(w,at+4,value>>32)
    store(w,at+5,value>>40)
    store(w,at+6,value>>48)
    store(w,at+7,value>>56)
    return 0

def u32_at(w:mutbuf,at:u64) -> u64:
    return byte(w,at)|(byte(w,at+1)<<8)|(byte(w,at+2)<<16)|(byte(w,at+3)<<24)

def copy_in(s:readbuf,w:mutbuf,src:u64,dst:u64,size:u64) -> u64:
    at=0
    while size-at>=8:
        put(w,dst+at,load(s,src+at))
        at=at+8
    while at<size:
        store(w,dst+at,byte(s,src+at))
        at=at+1
    return size

def copy_out(w:mutbuf,o:mutbuf,src:u64,dst:u64,size:u64) -> u64:
    at=0
    while size-at>=8:
        put(o,dst+at,get(w,src+at))
        at=at+8
    while at<size:
        store(o,dst+at,byte(w,src+at))
        at=at+1
    return size

def hex_digit(value:u64) -> u64:
    if value<10:
        return value+48
    return value+87


def decimal(w:mutbuf,at:u64,value:u64) -> u64:
    if value==0:
        store(w,at,48)
        return at+1
    size=0
    while value!=0:
        quotient=0
        remainder=0
        shift=64
        while shift!=0:
            shift=shift-1
            remainder=(remainder<<1)|((value>>shift)&1)
            if remainder>=10:
                remainder=remainder-10
                quotient=quotient|(1<<shift)
        store(w,3072+size,48+remainder)
        size=size+1
        value=quotient
    while size!=0:
        size=size-1
        store(w,at,byte(w,3072+size))
        at=at+1
    return at


