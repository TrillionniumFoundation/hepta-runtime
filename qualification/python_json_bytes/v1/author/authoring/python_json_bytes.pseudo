def entry(s:readbuf, o:mutbuf, w:mutbuf) -> u32:
    if length(s) > 6291456:
        return 4294967295
    if length(w) < 1024:
        return 4294967293
    result = decode(s,o,w,False)
    if result != 0:
        text_end = diagnostic(s,w)
        required = 64 + text_end - 128
        if length(o) < required:
            return 4294967294
        put(o,0,RESPONSE)
        put(o,8,1)
        put(o,16,get(w,0))
        put(o,24,get(w,24))
        put(o,32,get(w,32))
        put(o,40,get(w,40))
        put(o,48,get(w,48))
        put(o,56,text_end-128)
        copy(w,128,o,64,text_end-128)
        return required
    required = 64 + get(w,16)*4
    if length(o) < required:
        return 4294967294
    put(o,0,RESPONSE)
    put(o,8,0)
    put(o,16,get(w,0))
    put(o,24,get(w,16))
    put(o,32,get(w,8))
    put(o,40,0)
    put(o,48,0)
    put(o,56,get(w,16)*4)
    if decode(s,o,w,True) != 0:
        return 4294967295
    return required

def decode(s:readbuf, o:mutbuf, w:mutbuf, writing:bool) -> u64:
    n = length(s)
    encoding = 1
    skip = 0
    bias = 0
    if n >= 4 and byte(s,0) == 0 and byte(s,1) == 0 and byte(s,2) == 254 and byte(s,3) == 255:
        encoding = 5
        skip = 4
    elif n >= 4 and byte(s,0) == 255 and byte(s,1) == 254 and byte(s,2) == 0 and byte(s,3) == 0:
        encoding = 4
        skip = 4
    elif n >= 2 and byte(s,0) == 254 and byte(s,1) == 255:
        encoding = 3
        skip = 2
    elif n >= 2 and byte(s,0) == 255 and byte(s,1) == 254:
        encoding = 2
        skip = 2
    elif n >= 3 and byte(s,0) == 239 and byte(s,1) == 187 and byte(s,2) == 191:
        skip = 3
        bias = 3
    elif n >= 4:
        if byte(s,0) == 0:
            if byte(s,1) == 0:
                encoding = 5
            else:
                encoding = 3
        elif byte(s,1) == 0:
            if byte(s,2) != 0 or byte(s,3) != 0:
                encoding = 2
            else:
                encoding = 4
    elif n == 2:
        if byte(s,0) == 0:
            encoding = 3
        elif byte(s,1) == 0:
            encoding = 2
    put(w,0,encoding)
    put(w,8,skip)
    put(w,16,0)
    put(w,24,0)
    put(w,32,0)
    put(w,40,0)
    put(w,48,0)
    put(w,56,bias)
    at = skip
    count = 0
    while at < n:
        begin = at
        code = byte(s,at)
        if encoding == 1:
            if code < 128:
                at = at + 1
            else:
                width = 0
                if code >= 194 and code <= 223:
                    width = 2
                    value = code & 31
                elif code >= 224 and code <= 239:
                    width = 3
                    value = code & 15
                elif code >= 240 and code <= 244:
                    width = 4
                    value = code & 7
                else:
                    return failure(s,w,begin,begin+1,1)
                j = 1
                while j < width:
                    if begin+j >= n:
                        return failure(s,w,begin,n,3)
                    ch = byte(s,begin+j)
                    if ch < 128 or ch > 191:
                        return failure(s,w,begin,begin+j,2)
                    if j == 1 and ((code == 224 and ch < 160) or (code == 240 and ch < 144) or (code == 244 and ch > 143)):
                        return failure(s,w,begin,begin+1,2)
                    value = (value << 6) | (ch & 63)
                    j = j+1
                code = value
                at = begin+width
        elif encoding == 2 or encoding == 3:
            if n-at < 2:
                return failure(s,w,at,n,4)
            code = unit16(s,at,encoding == 3)
            at = at+2
            if code >= 55296 and code <= 56319 and n-at >= 2:
                low = unit16(s,at,encoding == 3)
                if low >= 56320 and low <= 57343:
                    code = 65536+((code-55296)<<10)+low-56320
                    at = at+2
        else:
            if n-at < 4:
                return failure(s,w,at,n,4)
            code = unit32(s,at,encoding == 5)
            if code > 1114111:
                return failure(s,w,at,at+4,5)
            at = at+4
        if writing:
            put32(o,64+count*4,code)
        count = count+1
    put(w,16,count)
    return 0

def failure(s:readbuf,w:mutbuf,begin:u64,end:u64,reason:u64) -> u64:
    bias = get(w,56)
    put(w,24,begin-bias)
    put(w,32,end-bias)
    put(w,40,reason)
    put(w,48,byte(s,begin))
    return 1

def diagnostic(s:readbuf,w:mutbuf) -> u64:
    at = prefix(w,128)
    encoding = get(w,0)
    if encoding == 1:
        at = utf8name(w,at)
    elif encoding == 2:
        at = utf16le(w,at)
    elif encoding == 3:
        at = utf16be(w,at)
    elif encoding == 4:
        at = utf32le(w,at)
    else:
        at = utf32be(w,at)
    at = cannot(w,at)
    begin = get(w,24)
    end = get(w,32)
    if end == begin+1:
        at = onebyte(w,at)
        value = get(w,48)
        store(w,at,hex(value>>4))
        store(w,at+1,hex(value&15))
        at = at+2
        at = position(w,at)
        at = decimal(w,at,begin)
    else:
        at = bytesposition(w,at)
        at = decimal(w,at,begin)
        store(w,at,45)
        at = decimal(w,at+1,end-1)
    store(w,at,58)
    store(w,at+1,32)
    at = at+2
    reason = get(w,40)
    if reason == 1:
        return startbyte(w,at)
    if reason == 2:
        return continuation(w,at)
    if reason == 3:
        return unexpected(w,at)
    if reason == 4:
        return truncated(w,at)
    return rangeerror(w,at)

def unit16(s:readbuf,at:u64,big:bool) -> u64:
    if big:
        return (byte(s,at)<<8)|byte(s,at+1)
    return byte(s,at)|(byte(s,at+1)<<8)

def unit32(s:readbuf,at:u64,big:bool) -> u64:
    if big:
        return (byte(s,at)<<24)|(byte(s,at+1)<<16)|(byte(s,at+2)<<8)|byte(s,at+3)
    return byte(s,at)|(byte(s,at+1)<<8)|(byte(s,at+2)<<16)|(byte(s,at+3)<<24)

def get(w:mutbuf,at:u64) -> u64:
    value = 0
    i = 0
    while i < 8:
        value = value | (byte(w,at+i)<<(i*8))
        i = i+1
    return value

def put(w:mutbuf,at:u64,value:u64) -> u64:
    i = 0
    while i < 8:
        store(w,at+i,(value>>(i*8))&255)
        i = i+1
    return 0

def put32(w:mutbuf,at:u64,value:u64) -> u64:
    i = 0
    while i < 4:
        store(w,at+i,(value>>(i*8))&255)
        i = i+1
    return 0

def copy(s:mutbuf,at:u64,o:mutbuf,dest:u64,n:u64) -> u64:
    i = 0
    while i < n:
        store(o,dest+i,byte(s,at+i))
        i = i+1
    return 0

def hex(value:u64) -> u64:
    if value < 10:
        return value+48
    return value+87

def decimal(w:mutbuf,at:u64,value:u64) -> u64:
    count = 0
    while value >= 10:
        quotient = divide10(value)
        store(w,900+count,48+value-quotient*10)
        value = quotient
        count = count+1
    store(w,900+count,48+value)
    count = count+1
    while count > 0:
        count = count-1
        store(w,at,byte(w,900+count))
        at = at+1
    return at

def divide10(value:u64) -> u64:
    step = 64
    remainder = 0
    quotient = 0
    while step > 0:
        step = step-1
        remainder = (remainder<<1)|((value>>step)&1)
        if remainder >= 10:
            remainder = remainder-10
            quotient = quotient|(1<<step)
    return quotient
