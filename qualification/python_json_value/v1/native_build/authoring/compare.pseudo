def is_numeric(tag:u64) -> bool:
    return tag >= 1 and tag <= 4

def equal_integer(s:readbuf,w:mutbuf,left:u64,right:u64) -> bool:
    if integer_negative(s,w,left) != integer_negative(s,w,right):
        return False
    size = integer_size(w,left)
    if size != integer_size(w,right):
        return False
    i = 0
    while i < size:
        if integer_digit(s,w,left,i) != integer_digit(s,w,right,i):
            return False
        i = i+1
    return True

def float_integer_digits(w:mutbuf,bits:u64) -> u64:
    exponent = (bits>>52)&2047
    mantissa = (bits&4503599627370495)|4503599627370496
    if exponent < 1023 or exponent == 2047:
        return 0
    shift = 0
    if exponent < 1075:
        down = 1075-exponent
        if (mantissa&((1<<down)-1)) != 0:
            return 0
        mantissa = mantissa>>down
    else:
        shift = exponent-1075
    size = 0
    while mantissa >= 10:
        quotient = divide10(mantissa)
        store(w,9500+size,mantissa-quotient*10)
        size = size+1
        mantissa = quotient
    store(w,9500+size,mantissa)
    size = size+1
    i = 0
    while i < shift:
        j = 0
        carry = 0
        while j < size:
            value = byte(w,9500+j)*2+carry
            carry = 0
            if value >= 10:
                carry = 1
                value = value-10
            store(w,9500+j,value)
            j = j+1
        if carry != 0:
            store(w,9500+size,carry)
            size = size+1
        i = i+1
    return size

def equal_float_integer(s:readbuf,w:mutbuf,floating:u64,integer:u64) -> bool:
    bits = get(w,floating+40)
    magnitude = bits&9223372036854775807
    if magnitude == 0:
        return integer_zero(s,w,integer)
    if magnitude >= 9218868437227405312:
        return False
    if (bits>>63 != 0) != integer_negative(s,w,integer):
        return False
    size = float_integer_digits(w,bits)
    if size == 0 or size != integer_size(w,integer):
        return False
    i = 0
    while i < size:
        if byte(w,9500+size-i-1)+48 != integer_digit(s,w,integer,i):
            return False
        i = i+1
    return True

def equal_numeric(s:readbuf,w:mutbuf,left:u64,right:u64,nested:bool) -> bool:
    a = get(w,left)
    b = get(w,right)
    if a != 4 and b != 4:
        return equal_integer(s,w,left,right)
    if a == 4 and b != 4:
        return equal_float_integer(s,w,left,right)
    if b == 4 and a != 4:
        return equal_float_integer(s,w,right,left)
    x = get(w,left+40)
    y = get(w,right+40)
    xm = x&9223372036854775807
    ym = y&9223372036854775807
    if xm > 9218868437227405312 or ym > 9218868437227405312:
        return nested and xm > 9218868437227405312 and ym > 9218868437227405312
    if xm == 0 and ym == 0:
        return True
    return x == y

def equal_values(s:readbuf,w:mutbuf,left:u64,right:u64) -> bool:
    end = get(w,HEAP)
    stack = end-24
    put(w,stack,left)
    put(w,stack+8,right)
    put(w,stack+16,0)
    while stack < end:
        a = get(w,stack)
        b = get(w,stack+8)
        nested = get(w,stack+16) != 0
        stack = stack+24
        atype = get(w,a)
        btype = get(w,b)
        if is_numeric(atype) and is_numeric(btype):
            if equal_numeric(s,w,a,b,nested) == False:
                return False
        elif atype != btype:
            return False
        elif atype == 5:
            if string_compare(w,a,b) != 0:
                return False
        elif atype >= 6:
            if get(w,a+48) != get(w,b+48):
                return False
            x = get(w,a+24)
            y = get(w,b+24)
            while x != 0:
                if atype == 7 and string_compare(w,get(w,x+32),get(w,y+32)) != 0:
                    return False
                if stack < get(w,NEXT)+24:
                    put(w,ERR,16)
                    return False
                stack = stack-24
                put(w,stack,x)
                put(w,stack+8,y)
                put(w,stack+16,1)
                x = get(w,x+16)
                y = get(w,y+16)
    return True

def divide10(value:u64) -> u64:
    step = 64
    remainder = 0
    quotient = 0
    while step > 0:
        step = step-1
        remainder = (remainder<<1)|((value>>step)&1)
        if remainder >= 10:
            remainder = remainder-10
            quotient = quotient|(1<<step)
    return quotient

def diagnostic_decimal(w:mutbuf,at:u64,value:u64) -> u64:
    count = 0
    while value >= 10:
        quotient = divide10(value)
        store(w,9000+count,48+value-quotient*10)
        value = quotient
        count = count+1
    store(w,9000+count,48+value)
    count = count+1
    while count > 0:
        count = count-1
        store(w,at,byte(w,9000+count))
        at = at+1
    return at

def key_repr(s:readbuf,w:mutbuf,at:u64) -> u64:
    begin = get(w,KEY_BASE)
    size = get(w,KEY_SIZE)
    single = False
    double = False
    i = 0
    while i < size:
        cp = character(s,begin+i)
        single = single or cp == 39
        double = double or cp == 34
        i = i+1
    quote = choose(single and double == False,34,39)
    store(w,at,quote)
    at = at+1
    i = 0
    while i < size:
        cp = character(s,begin+i)
        if cp == quote or cp == 92:
            store(w,at,92)
            store(w,at+1,cp)
            at = at+2
        elif cp == 9 or cp == 10 or cp == 13:
            store(w,at,92)
            store(w,at+1,choose(cp == 9,116,choose(cp == 10,110,114)))
            at = at+2
        elif cp < 32 or cp == 127:
            store(w,at,92)
            store(w,at+1,120)
            store(w,at+2,hex_digit(cp>>4))
            store(w,at+3,hex_digit(cp&15))
            at = at+4
        else:
            store(w,at,cp)
            at = at+1
        i = i+1
    store(w,at,quote)
    return at+1

def type_name(w:mutbuf,at:u64,tag:u64) -> u64:
    if tag == 0:
        return type_none(w,at)
    if tag == 1 or tag == 2:
        return type_bool(w,at)
    if tag == 3:
        return type_int(w,at)
    if tag == 4:
        return type_float(w,at)
    if tag == 5:
        return type_str(w,at)
    if tag == 6:
        return type_list(w,at)
    return type_dict(w,at)

def report_error(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    code = get(w,ERR)
    if code == 0 or code == 16:
        return 4294967295
    at = 10000
    if code <= 9:
        at = json_error_prefix(w,at)
        if code == 1:
            at = expecting_value(w,at)
        elif code == 2:
            at = property_name(w,at)
        elif code == 3:
            at = colon(w,at)
        elif code == 4:
            at = comma(w,at)
        elif code == 5:
            at = unterminated(w,at)
        elif code == 6:
            at = control_character(w,at)
        elif code == 7:
            at = invalid_escape(w,at)
        elif code == 8:
            at = invalid_unicode(w,at)
        else:
            at = extra_data(w,at)
        position = get(w,POSITION)
        base = get(w,BASE)
        line = 1
        last_line = base
        i = base
        while i < position:
            if character(s,i) == 10:
                line = line+1
                last_line = i+1
            i = i+1
        at = line_prefix(w,at)
        at = diagnostic_decimal(w,at,line)
        at = column_prefix(w,at)
        at = diagnostic_decimal(w,at,position-last_line+1)
        at = char_prefix(w,at)
        at = diagnostic_decimal(w,at,position-base)
        store(w,at,41)
        at = at+1
    elif code == 10:
        at = integer_limit(w,at)
        at = diagnostic_decimal(w,at,get(w,DETAIL))
        at = integer_limit_tail(w,at)
    elif code == 11:
        at = recursion_array(w,at)
    elif code == 12:
        at = recursion_object(w,at)
    elif code == 13:
        at = key_error(w,at)
        at = key_repr(s,w,at)
    elif code == 17:
        at = recursion_encode(w,at)
    elif code == 14:
        tag = get(w,DETAIL)
        if tag == 5:
            at = string_indices(w,at)
        elif tag == 6:
            at = list_indices(w,at)
        else:
            at = type_error(w,at)
            at = type_name(w,at,tag)
            at = not_subscriptable(w,at)
    else:
        at = attribute_error(w,at)
        at = type_name(w,at,get(w,DETAIL))
        at = no_attribute(w,at)
        if code == 15:
            at = update_attribute(w,at)
        else:
            at = get_attribute(w,at)
    size = at-10000
    if length(o) < 64+size:
        return 4294967294
    header(o,3,code,0,0,0,2,size)
    i = 0
    while i < size:
        store(o,64+i,byte(w,10000+i))
        i = i+1
    return 64+size
