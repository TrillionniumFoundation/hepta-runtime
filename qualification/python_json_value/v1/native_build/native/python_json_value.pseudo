def convert(w: mutbuf, source: u64, n: u64) -> u64:
    if n == 0 or n > 8388608:
        return 4294967295
    if length(w) < 8192:
        return 4294967293
    small(w, 0, 0)
    small(w, 1040, 1)
    put(w, 3120, 0)
    put(w, 3128, 0)
    put(w, 3136, 0)
    index = 0
    sign = 0
    if byte(w, source + 0) == 45:
        sign = 9223372036854775808
        index = 1
    if index >= n:
        return 4294967295
    ch = byte(w, source + index)
    if ch == 48:
        index = index + 1
    else:
        if ch < 49 or ch > 57:
            return 4294967295
        going = True
        while going and index < n:
            ch = byte(w, source + index)
            if ch >= 48 and ch <= 57:
                if digit(w, ch - 48) != 0:
                    return 4294967293
                index = index + 1
            else:
                going = False
    fraction = 0
    if index < n and byte(w, source + index) == 46:
        index = index + 1
        begin = index
        going = True
        while going and index < n:
            ch = byte(w, source + index)
            if ch >= 48 and ch <= 57:
                if digit(w, ch - 48) != 0:
                    return 4294967293
                fraction = fraction + 1
                index = index + 1
            else:
                going = False
        if index == begin:
            return 4294967295
    exponent = 0
    negative_exponent = False
    if index < n and (byte(w, source + index) == 69 or byte(w, source + index) == 101):
        index = index + 1
        if index < n and (byte(w, source + index) == 43 or byte(w, source + index) == 45):
            negative_exponent = byte(w, source + index) == 45
            index = index + 1
        begin = index
        going = True
        while going and index < n:
            ch = byte(w, source + index)
            if ch >= 48 and ch <= 57:
                if exponent < 33554432:
                    exponent = exponent * 10 + ch - 48
                    if exponent > 33554432:
                        exponent = 33554432
                index = index + 1
            else:
                going = False
        if index == begin:
            return 4294967295
    if index != n:
        return 4294967295
    significant = get(w, 3120)
    if significant == 0:
        put(w, 8192, sign)
        return 8
    order = 67108864 + significant - fraction - 1
    if negative_exponent:
        order = order - exponent
    else:
        order = order + exponent
    if order > 67109172:
        return 4294967292
    if order < 67108540:
        put(w, 8192, sign)
        return 8
    power = order + 1 - get(w, 3128)
    if power >= 67108864:
        count = power - 67108864
        base = 0
    else:
        count = 67108864 - power
        base = 1040
    i = 0
    while i < count:
        if multiply(w, base, 10, 0) != 0:
            return 4294967293
        i = i + 1
    binary = 4096 + bits(w, 0) - bits(w, 1040)
    if binary >= 4096:
        copy_big(w, 1040, 2080)
        if shift(w, 2080, binary - 4096) != 0:
            return 4294967293
        relation = compare_big(w, 0, 2080)
    else:
        copy_big(w, 0, 2080)
        if shift(w, 2080, 4096 - binary) != 0:
            return 4294967293
        relation = compare_big(w, 2080, 1040)
    if relation == 1:
        binary = binary - 1
    if binary > 5119:
        return 4294967292
    normal = binary >= 3074
    if normal:
        scale = 12340 - binary
    else:
        scale = 9266
    if scale >= 8192:
        if shift(w, 0, scale - 8192) != 0:
            return 4294967293
    elif shift(w, 1040, 8192 - scale) != 0:
        return 4294967293
    numerator_bits = bits(w, 0)
    denominator_bits = bits(w, 1040)
    quotient = 0
    if numerator_bits >= denominator_bits:
        step = numerator_bits - denominator_bits + 1
        if step > 54:
            return 4294967293
        while step > 0:
            step = step - 1
            copy_big(w, 1040, 2080)
            if shift(w, 2080, step) != 0:
                return 4294967293
            if compare_big(w, 0, 2080) != 1:
                subtract(w, 0, 2080)
                quotient = quotient | 1 << step
    if shift(w, 0, 1) != 0:
        return 4294967293
    relation = compare_big(w, 0, 1040)
    if relation == 2 or (relation == 0 and (quotient & 1 != 0 or get(w, 3136) != 0)):
        quotient = quotient + 1
    if normal:
        if quotient == 9007199254740992:
            quotient = quotient >> 1
            binary = binary + 1
        if binary > 5119:
            return 4294967292
        result = binary - 3073 << 52 | quotient - 4503599627370496
    else:
        result = quotient
    put(w, 8192, result | sign)
    return 8

def format_binary64(w: mutbuf, original: u64, destination: u64) -> u64:
    if length(w) < 8192:
        return 4294967293
    magnitude = original & 9223372036854775807
    negative = original >> 63 != 0
    exponent = magnitude >> 52 & 2047
    mantissa = magnitude & 4503599627370495
    if exponent == 2047:
        return 4294967295
    cursor = 0
    if negative:
        cursor = emit(w, cursor, 45)
    if magnitude == 0:
        cursor = emit(w, cursor, 48)
        cursor = emit(w, cursor, 46)
        cursor = emit(w, cursor, 48)
    else:
        if exponent != 0:
            mantissa = mantissa | 4503599627370496
        set64(w, 0, mantissa << 2)
        set64(w, 1040, 4)
        set64(w, 2080, 2)
        set64(w, 3120, 2)
        if exponent > 1 and mantissa == 4503599627370496:
            set64(w, 2080, 1)
        if exponent == 0:
            shift(w, 1040, 1074)
            binary = 3021 + bits(w, 0) - 2
        else:
            binary = exponent + 3073
            if exponent >= 1075:
                shift(w, 0, exponent - 1075)
                shift(w, 2080, exponent - 1075)
                shift(w, 3120, exponent - 1075)
            else:
                shift(w, 1040, 1075 - exponent)
        order = 815 + (binary * 1233 >> 12)
        if order_relation(w, order) == 1:
            order = order - 1
        if order_relation(w, order + 1) != 1:
            order = order + 1
        if order >= 2048:
            count = order - 2048
            i = 0
            while i < count:
                if multiply(w, 1040, 10, 0) != 0:
                    return 4294967293
                i = i + 1
        else:
            count = 2048 - order
            i = 0
            while i < count:
                if multiply(w, 0, 10, 0) != 0 or multiply(w, 2080, 10, 0) != 0 or multiply(w, 3120, 10, 0) != 0:
                    return 4294967293
                i = i + 1
        inclusive = mantissa & 1 == 0
        digits = 0
        done = False
        round_up = False
        while digits < 17 and done == False:
            value = 0
            while compare_big(w, 0, 1040) != 1:
                subtract(w, 0, 1040)
                value = value + 1
            if value > 9:
                return 4294967293
            store(w, 6200 + digits, value + 48)
            digits = digits + 1
            relation = compare_big(w, 0, 2080)
            low = relation == 1 or (relation == 0 and inclusive)
            copy_big(w, 0, 4160)
            if add_big(w, 4160, 3120) != 0:
                return 4294967293
            relation = compare_big(w, 4160, 1040)
            high = relation == 2 or (relation == 0 and inclusive)
            if low or high:
                done = True
                if low and high:
                    multiply(w, 0, 2, 0)
                    relation = compare_big(w, 0, 1040)
                    round_up = relation == 2 or (relation == 0 and value & 1 != 0)
                else:
                    round_up = high
            elif multiply(w, 0, 10, 0) != 0 or multiply(w, 2080, 10, 0) != 0 or multiply(w, 3120, 10, 0) != 0:
                return 4294967293
        if done == False:
            return 4294967293
        if round_up:
            at = digits
            carry = True
            while at > 0 and carry:
                at = at - 1
                value = byte(w, 6200 + at)
                if value == 57:
                    store(w, 6200 + at, 48)
                else:
                    store(w, 6200 + at, value + 1)
                    carry = False
            if carry:
                store(w, 6200, 49)
                digits = 1
                order = order + 1
        while digits > 1 and byte(w, 6200 + digits - 1) == 48:
            digits = digits - 1
        if order < 2044 or order >= 2064:
            cursor = emit(w, cursor, byte(w, 6200))
            if digits > 1:
                cursor = emit(w, cursor, 46)
                i = 1
                while i < digits:
                    cursor = emit(w, cursor, byte(w, 6200 + i))
                    i = i + 1
            cursor = emit(w, cursor, 101)
            if order < 2048:
                cursor = emit(w, cursor, 45)
                power = 2048 - order
            else:
                cursor = emit(w, cursor, 43)
                power = order - 2048
            hundreds = 0
            while power >= 100:
                hundreds = hundreds + 1
                power = power - 100
            if hundreds != 0:
                cursor = emit(w, cursor, hundreds + 48)
            tens = 0
            while power >= 10:
                tens = tens + 1
                power = power - 10
            cursor = emit(w, cursor, tens + 48)
            cursor = emit(w, cursor, power + 48)
        elif order >= 2048:
            integer_digits = order - 2048 + 1
            i = 0
            while i < integer_digits:
                value = 48
                if i < digits:
                    value = byte(w, 6200 + i)
                cursor = emit(w, cursor, value)
                i = i + 1
            cursor = emit(w, cursor, 46)
            if digits <= integer_digits:
                cursor = emit(w, cursor, 48)
            else:
                while i < digits:
                    cursor = emit(w, cursor, byte(w, 6200 + i))
                    i = i + 1
        else:
            cursor = emit(w, cursor, 48)
            cursor = emit(w, cursor, 46)
            i = order + 1
            while i < 2048:
                cursor = emit(w, cursor, 48)
                i = i + 1
            i = 0
            while i < digits:
                cursor = emit(w, cursor, byte(w, 6200 + i))
                i = i + 1
    i = 0
    while i < cursor:
        store(w, destination + i, byte(w, 6144 + i))
        i = i + 1
    return cursor

def digit(w: mutbuf, value: u64) -> u64:
    count = get(w, 3120)
    if count == 0 and value == 0:
        return 0
    put(w, 3120, count + 1)
    kept = get(w, 3128)
    if kept < 800:
        put(w, 3128, kept + 1)
        return multiply(w, 0, 10, value)
    if value != 0:
        put(w, 3136, 1)
    return 0

def small(w: mutbuf, at: u64, value: u64) -> u64:
    put(w, at, 1)
    put(w, at + 8, value)
    return 0

def multiply(w: mutbuf, at: u64, factor: u64, carry: u64) -> u64:
    count = get(w, at)
    i = 0
    while i < count:
        value = get(w, at + 8 + i * 8) * factor + carry
        put(w, at + 8 + i * 8, value & 4294967295)
        carry = value >> 32
        i = i + 1
    if carry != 0:
        if count >= 128:
            return 1
        put(w, at + 8 + count * 8, carry)
        put(w, at, count + 1)
    return 0

def bits(w: mutbuf, at: u64) -> u64:
    count = get(w, at)
    value = get(w, at + count * 8)
    result = (count - 1) * 32
    while value != 0:
        result = result + 1
        value = value >> 1
    return result

def copy_big(w: mutbuf, source: u64, target: u64) -> u64:
    count = get(w, source)
    i = 0
    while i <= count:
        put(w, target + i * 8, get(w, source + i * 8))
        i = i + 1
    return 0

def normalize(w: mutbuf, at: u64) -> u64:
    count = get(w, at)
    while count > 1 and get(w, at + count * 8) == 0:
        count = count - 1
    put(w, at, count)
    return 0

def shift(w: mutbuf, at: u64, amount: u64) -> u64:
    words = amount >> 5
    rest = amount & 31
    count = get(w, at)
    total = count + words
    if rest != 0:
        total = total + 1
    if total > 128:
        return 1
    i = total
    while i > 0:
        i = i - 1
        value = 0
        if i >= words:
            index = i - words
            if index < count:
                value = get(w, at + 8 + index * 8) << rest & 4294967295
            if rest != 0 and index > 0 and (index - 1 < count):
                value = value | get(w, at + index * 8) >> 32 - rest
        put(w, at + 8 + i * 8, value)
    put(w, at, total)
    normalize(w, at)
    return 0

def compare_big(w: mutbuf, left: u64, right: u64) -> u64:
    a = get(w, left)
    b = get(w, right)
    if a < b:
        return 1
    if a > b:
        return 2
    i = a
    while i > 0:
        x = get(w, left + i * 8)
        y = get(w, right + i * 8)
        if x < y:
            return 1
        if x > y:
            return 2
        i = i - 1
    return 0

def subtract(w: mutbuf, left: u64, right: u64) -> u64:
    a = get(w, left)
    b = get(w, right)
    borrow = 0
    i = 0
    while i < a:
        y = 0
        if i < b:
            y = get(w, right + 8 + i * 8)
        value = 4294967296 + get(w, left + 8 + i * 8) - y - borrow
        put(w, left + 8 + i * 8, value & 4294967295)
        borrow = choose(value < 4294967296, 1, 0)
        i = i + 1
    normalize(w, left)
    return 0

def get(w: mutbuf, at: u64) -> u64:
    value = 0
    i = 0
    while i < 8:
        value = value | byte(w, at + i) << i * 8
        i = i + 1
    return value

def put(w: mutbuf, at: u64, value: u64) -> u64:
    i = 0
    while i < 8:
        store(w, at + i, value & 255)
        value = value >> 8
        i = i + 1
    return 0

def set64(w: mutbuf, at: u64, value: u64) -> u64:
    put(w, at, 2)
    put(w, at + 8, value & 4294967295)
    put(w, at + 16, value >> 32)
    normalize(w, at)
    return 0

def order_relation(w: mutbuf, power: u64) -> u64:
    if power >= 2048:
        copy_big(w, 1040, 4160)
        count = power - 2048
    else:
        copy_big(w, 0, 4160)
        count = 2048 - power
    i = 0
    while i < count:
        multiply(w, 4160, 10, 0)
        i = i + 1
    if power >= 2048:
        return compare_big(w, 0, 4160)
    return compare_big(w, 4160, 1040)

def add_big(w: mutbuf, left: u64, right: u64) -> u64:
    a = get(w, left)
    b = get(w, right)
    count = choose(a >= b, a, b)
    carry = 0
    i = 0
    while i < count:
        x = 0
        y = 0
        if i < a:
            x = get(w, left + 8 + i * 8)
        if i < b:
            y = get(w, right + 8 + i * 8)
        value = x + y + carry
        put(w, left + 8 + i * 8, value & 4294967295)
        carry = value >> 32
        i = i + 1
    if carry != 0:
        if count >= 128:
            return 1
        put(w, left + 8 + count * 8, carry)
        count = count + 1
    put(w, left, count)
    return 0

def emit(w: mutbuf, index: u64, value: u64) -> u64:
    store(w, 6144 + index, value)
    return index + 1
