def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(s) < 64 or load(s,0) != 3544422324912083016:
        return 4294967295
    command = load(s,8)
    count = load(s,16)
    extra = load(s,24)
    parse_budget = load(s,32)
    dump_budget = load(s,40)
    if command < 1 or command > 6 or count > 8388608 or extra > 8388608 or count+extra > 8388608 or load(s,48) != 0:
        return 4294967295
    if parse_budget == 0 or parse_budget > 2000 or dump_budget == 0 or dump_budget > 2000:
        return 4294967295
    if load(s,56) != (count+extra)*4 or length(s) != 64+(count+extra)*4:
        return 4294967295
    if (command == 1 or command == 3) and extra != 0:
        return 4294967295
    i = 0
    while i < count+extra:
        cp = character(s,i)
        if cp > 1114111:
            return 4294967295
        if (command == 2 or command == 6) and i >= count and (cp > 127 or extra > 96):
            return 4294967295
        i = i+1
    if length(w) < 16448+40*(count+extra):
        return 4294967293
    put(w,12288,16384)
    put(w,12296,length(w)&18446744073709551608)
    put(w,12328,0)
    put(w,12352,dump_budget)
    root = parse(s,w,0,count,parse_budget)
    if root == 0:
        return report_error(s,o,w)
    if command == 2 or command == 6:
        root = lookup(s,w,root,count,extra,command == 6)
        if get(w,12328) != 0:
            return report_error(s,o,w)
    if command == 4 or command == 5:
        other = parse(s,w,count,extra,parse_budget)
        if other == 0:
            return report_error(s,o,w)
        if command == 5:
            equal = equal_values(s,w,root,other)
            if get(w,12328) != 0:
                return 4294967295
            if length(o) < 64:
                return 4294967294
            header(o,2,2,choose(equal,1,0),0,0,0,0)
            return 64
        if get(w,root) != 7:
            put(w,12328,15)
            put(w,12344,get(w,root))
            return report_error(s,o,w)
        if get(w,other) != 7:
            return 4294967295
        merge_update(w,root,other)
    if command == 3 or command == 4:
        amount = serialize(s,o,w,root,False)
        if get(w,12328) != 0:
            return report_error(s,o,w)
        if length(o) < 64+amount:
            return 4294967294
        header(o,1,get(w,root),scalar_truth(s,w,root),0,amount,2,amount)
        if serialize(s,o,w,root,True) != amount:
            return 4294967295
        return 64+amount
    return value_result(s,o,w,root)

def parse(s:readbuf,w:mutbuf,begin:u64,count:u64,budget:u64) -> u64:
    put(w,12304,begin)
    put(w,12312,begin+count)
    put(w,12320,space(s,begin,begin+count))
    root = value(s,w,0,budget)
    if root == 0:
        return 0
    parent = 0
    depth = 0
    if get(w,root) >= 6:
        parent = root
        depth = 1
    while parent != 0:
        at = space(s,get(w,12320),get(w,12312))
        put(w,12320,at)
        tag = get(w,parent)
        phase = get(w,parent+40)&255
        key = 0
        closed = False
        if tag == 6:
            if (phase == 0 or phase == 2) and at < get(w,12312) and character(s,at) == 93:
                closed = True
            elif phase == 2:
                if at == get(w,12312) or character(s,at) != 44:
                    return error(w,4,at)
                at = space(s,at+1,get(w,12312))
                put(w,12320,at)
                put(w,parent+40,(get(w,parent+40)&18446744073709551360)|1)
        else:
            if (phase == 0 or phase == 4) and at < get(w,12312) and character(s,at) == 125:
                closed = True
            else:
                if phase == 4:
                    if at == get(w,12312) or character(s,at) != 44:
                        return error(w,4,at)
                    at = space(s,at+1,get(w,12312))
                    put(w,12320,at)
                if at == get(w,12312) or character(s,at) != 34:
                    return error(w,2,at)
                key = string(s,w)
                if key == 0:
                    return 0
                at = space(s,get(w,12320),get(w,12312))
                if at == get(w,12312) or character(s,at) != 58:
                    return error(w,3,at)
                put(w,12320,space(s,at+1,get(w,12312)))
        if closed:
            put(w,parent+56,(get(w,parent+56)&4294967295)|((at+1)<<32))
            put(w,12320,at+1)
            if tag == 7:
                sort_object(w,parent)
            parent = get(w,parent+8)
            depth = depth-1
        else:
            child = value(s,w,depth,budget)
            if child == 0:
                return 0
            put(w,child+8,parent)
            put(w,child+32,key)
            if get(w,parent+24) == 0:
                put(w,parent+24,child)
            else:
                put(w,(get(w,parent+40)>>8)+16,child)
            put(w,parent+48,get(w,parent+48)+1)
            if tag == 6:
                put(w,parent+40,(child<<8)|2)
            else:
                put(w,parent+40,(child<<8)|4)
            if get(w,child) >= 6:
                parent = child
                depth = depth+1
    at = space(s,get(w,12320),get(w,12312))
    if at != get(w,12312):
        return error(w,9,at)
    return root

def value(s:readbuf,w:mutbuf,depth:u64,budget:u64) -> u64:
    at = get(w,12320)
    end = get(w,12312)
    if at >= end:
        return error(w,1,at)
    cp = character(s,at)
    if cp == 34:
        return string(s,w)
    if cp == 91 or cp == 123:
        if depth >= budget:
            return error(w,choose(cp == 91,11,12),at)
        node = allocate(w)
        put(w,node,choose(cp == 91,6,7))
        put(w,node+56,at)
        put(w,12320,at+1)
        return node
    if cp == 110 and matches(s,at,end,1819047278,4):
        return scalar(w,0,at,at+4,0)
    if cp == 102 and matches(s,at,end,435728179558,5):
        return scalar(w,1,at,at+5,0)
    if cp == 116 and matches(s,at,end,1702195828,4):
        return scalar(w,2,at,at+4,1)
    if cp == 78 and matches(s,at,end,5136718,3):
        return scalar(w,4,at,at+3,9221120237041090560)
    if cp == 73 and matches(s,at,end,8751735898823355977,8):
        return scalar(w,4,at,at+8,9218868437227405312)
    if cp == 45 and at+1 < end and character(s,at+1) == 73 and matches(s,at+1,end,8751735898823355977,8):
        return scalar(w,4,at,at+9,18442240474082181120)
    return number(s,w)

def scalar(w:mutbuf,tag:u64,begin:u64,end:u64,bits:u64) -> u64:
    node = allocate(w)
    put(w,node,tag)
    put(w,node+40,bits)
    put(w,node+56,begin|(end<<32))
    put(w,12320,end)
    return node

def allocate(w:mutbuf) -> u64:
    at = get(w,12288)
    put(w,12288,at+64)
    fill_range(w,at,64,0)
    return at

def number(s:readbuf,w:mutbuf) -> u64:
    start = get(w,12320)
    end = get(w,12312)
    at = start
    if character(s,at) == 45:
        at = at+1
    if at >= end:
        return error(w,1,start)
    digits = at
    cp = character(s,at)
    if cp == 48:
        at = at+1
    elif cp >= 49 and cp <= 57:
        at = at+1
        while at < end and is_digit(character(s,at)):
            at = at+1
    else:
        return error(w,1,start)
    integer_end = at
    floating = False
    if at+1 < end and character(s,at) == 46 and is_digit(character(s,at+1)):
        floating = True
        at = at+2
        while at < end and is_digit(character(s,at)):
            at = at+1
    if at < end and (character(s,at) == 101 or character(s,at) == 69):
        exponent_start = at
        next = at+1
        if next < end and (character(s,next) == 43 or character(s,next) == 45):
            next = next+1
        if next < end and is_digit(character(s,next)):
            floating = True
            at = next+1
            while at < end and is_digit(character(s,at)):
                at = at+1
    if floating:
        text = get(w,12296)-(at-start)
        i = start
        while i < at:
            store(w,text+i-start,character(s,i))
            i = i+1
        status = convert(w,text,at-start)
        if status == 4294967292:
            bits = 9218868437227405312
            if character(s,start) == 45:
                bits = bits|9223372036854775808
        elif status == 8:
            bits = get(w,8192)
        else:
            return error(w,16,start)
        return scalar(w,4,start,at,bits)
    if integer_end-digits > 4300:
        put(w,12344,integer_end-digits)
        return error(w,10,start)
    node = scalar(w,3,start,at,0)
    put(w,node+40,digits)
    put(w,node+48,integer_end-digits)
    return node

def string(s:readbuf,w:mutbuf) -> u64:
    start = get(w,12320)
    at = start+1
    end = get(w,12312)
    top = get(w,12296)
    count = 0
    finished = False
    while at < end and finished == False:
        cp = character(s,at)
        if cp == 34:
            finished = True
            at = at+1
        else:
            if cp < 32:
                return error(w,6,at)
            if cp == 92:
                escape = at
                at = at+1
                if at >= end:
                    return error(w,5,start)
                cp = character(s,at)
                if cp == 117:
                    unicode_at = at
                    if at+5 >= end:
                        return error(w,8,at)
                    cp = hex4(s,w,at+1,at)
                    if get(w,12328) != 0:
                        return 0
                    at = at+5
                    if cp >= 55296 and cp <= 56319 and at+6 < end and character(s,at) == 92 and character(s,at+1) == 117:
                        low = hex4(s,w,at+2,at+1)
                        if get(w,12328) != 0:
                            return 0
                        if low >= 56320 and low <= 57343:
                            cp = 65536+((cp-55296)<<10)+low-56320
                            at = at+6
                else:
                    if cp == 34 or cp == 92 or cp == 47:
                        cp = cp
                    elif cp == 98:
                        cp = 8
                    elif cp == 102:
                        cp = 12
                    elif cp == 110:
                        cp = 10
                    elif cp == 114:
                        cp = 13
                    elif cp == 116:
                        cp = 9
                    else:
                        return error(w,7,escape)
                    at = at+1
            else:
                at = at+1
            count = count+1
            put32(w,top-count*4,cp)
    if finished == False:
        return error(w,5,start)
    bottom = top-count*4
    put(w,12296,bottom)
    i = 0
    while i < count>>1:
        a = get32(w,bottom+i*4)
        b = get32(w,top-(i+1)*4)
        put32(w,bottom+i*4,b)
        put32(w,top-(i+1)*4,a)
        i = i+1
    node = scalar(w,5,start,at,bottom)
    put(w,node+48,count)
    return node

def hex4(s:readbuf,w:mutbuf,at:u64,position:u64) -> u64:
    value = 0
    i = 0
    while i < 4:
        cp = character(s,at+i)
        if cp >= 48 and cp <= 57:
            digit = cp-48
        elif cp >= 65 and cp <= 70:
            digit = cp-55
        elif cp >= 97 and cp <= 102:
            digit = cp-87
        else:
            return error(w,8,position)
        value = (value<<4)|digit
        i = i+1
    return value

def matches(s:readbuf,at:u64,end:u64,literal:u64,size:u64) -> bool:
    if at+size > end:
        return False
    i = 0
    while i < size:
        if character(s,at+i) != ((literal>>(i*8))&255):
            return False
        i = i+1
    return True

def is_digit(cp:u64) -> bool:
    return cp >= 48 and cp <= 57

def space(s:readbuf,at:u64,end:u64) -> u64:
    going = True
    while at < end and going:
        cp = character(s,at)
        if cp == 32 or cp == 9 or cp == 10 or cp == 13:
            at = at+1
        else:
            going = False
    return at

def error(w:mutbuf,code:u64,position:u64) -> u64:
    put(w,12328,code)
    put(w,12336,position)
    return 0

def character(s:readbuf,index:u64) -> u64:
    at = 64+index*4
    return byte(s,at)|(byte(s,at+1)<<8)|(byte(s,at+2)<<16)|(byte(s,at+3)<<24)

def get32(w:mutbuf,at:u64) -> u64:
    return byte(w,at)|(byte(w,at+1)<<8)|(byte(w,at+2)<<16)|(byte(w,at+3)<<24)

def put32(w:mutbuf,at:u64,value:u64) -> u64:
    store(w,at,value&255)
    store(w,at+1,(value>>8)&255)
    store(w,at+2,(value>>16)&255)
    store(w,at+3,(value>>24)&255)
    return 0

def load(s:readbuf,at:u64) -> u64:
    value = 0
    i = 0
    while i < 8:
        value = value|(byte(s,at+i)<<(i*8))
        i = i+1
    return value

def header(o:mutbuf,kind:u64,tag:u64,truth_value:u64,bits:u64,count:u64,encoding:u64,size:u64) -> u64:
    put(o,0,3544423424423710792)
    put(o,8,kind)
    put(o,16,tag)
    put(o,24,truth_value)
    put(o,32,bits)
    put(o,40,count)
    put(o,48,encoding)
    put(o,56,size)
    return 0


def string_compare(w:mutbuf,left:u64,right:u64) -> u64:
    a = get(w,left+40)
    b = get(w,right+40)
    an = get(w,left+48)
    bn = get(w,right+48)
    n = choose(an < bn,an,bn)
    i = 0
    while i < n:
        x = get32(w,a+i*4)
        y = get32(w,b+i*4)
        if x < y:
            return 1
        if x > y:
            return 2
        i = i+1
    if an < bn:
        return 1
    if an > bn:
        return 2
    return 0

def merge_pair(w:mutbuf,left:u64,right:u64,left_count:u64,right_count:u64) -> u64:
    while left_count > 0 or (right_count > 0 and right != 0):
        if left_count == 0:
            chosen = right
            right = get(w,right+16)
            right_count = right_count-1
        elif right_count == 0 or right == 0:
            chosen = left
            left = get(w,left+16)
            left_count = left_count-1
        elif string_compare(w,get(w,left+32),get(w,right+32)) != 2:
            chosen = left
            left = get(w,left+16)
            left_count = left_count-1
        else:
            chosen = right
            right = get(w,right+16)
            right_count = right_count-1
        tail = get(w,12384)
        if tail == 0:
            put(w,12376,chosen)
        else:
            put(w,tail+16,chosen)
        put(w,12384,chosen)
    return right

def sort_object(w:mutbuf,node:u64) -> u64:
    if get(w,node+48) < 2:
        return 0
    width = 1
    head = get(w,node+24)
    going = True
    while going:
        put(w,12376,0)
        put(w,12384,0)
        left = head
        merges = 0
        while left != 0:
            merges = merges+1
            right = left
            count = 0
            while count < width and right != 0:
                count = count+1
                right = get(w,right+16)
            left = merge_pair(w,left,right,count,width)
        put(w,get(w,12384)+16,0)
        head = get(w,12376)
        if merges <= 1:
            going = False
        else:
            width = width<<1
    cursor = head
    head = 0
    tail = 0
    count = 0
    while cursor != 0:
        selected = cursor
        cursor = get(w,cursor+16)
        while cursor != 0 and string_compare(w,get(w,selected+32),get(w,cursor+32)) == 0:
            selected = cursor
            cursor = get(w,cursor+16)
        if head == 0:
            head = selected
        else:
            put(w,tail+16,selected)
        tail = selected
        count = count+1
    put(w,tail+16,0)
    put(w,node+24,head)
    put(w,node+40,(tail<<8)|(get(w,node+40)&255))
    put(w,node+48,count)
    return 0

def merge_update(w:mutbuf,node:u64,other:u64) -> u64:
    child = get(w,other+24)
    if child == 0:
        return 0
    if get(w,node+24) == 0:
        put(w,node+24,child)
    else:
        put(w,(get(w,node+40)>>8)+16,child)
    tail = 0
    while child != 0:
        put(w,child+8,node)
        tail = child
        child = get(w,child+16)
    put(w,node+40,(tail<<8)|(get(w,node+40)&255))
    put(w,node+48,get(w,node+48)+get(w,other+48))
    sort_object(w,node)
    return 0

def lookup(s:readbuf,w:mutbuf,node:u64,begin:u64,size:u64,optional:bool) -> u64:
    tag = get(w,node)
    if tag != 7:
        put(w,12344,tag)
        put(w,12328,choose(optional,18,14))
        return 0
    item = get(w,node+24)
    while item != 0:
        key = get(w,item+32)
        if get(w,key+48) == size:
            i = 0
            same = True
            while i < size and same:
                same = get32(w,get(w,key+40)+i*4) == character(s,begin+i)
                i = i+1
            if same:
                return item
        item = get(w,item+16)
    if optional == False:
        put(w,12328,13)
        put(w,12360,begin)
        put(w,12368,size)
    return 0

def truth(w:mutbuf,node:u64) -> u64:
    if node == 0:
        return 0
    tag = get(w,node)
    if tag == 0 or tag == 1:
        return 0
    if tag == 2:
        return 1
    if tag == 4:
        return choose((get(w,node+40)&9223372036854775807) != 0,1,0)
    if tag >= 5:
        return choose(get(w,node+48) != 0,1,0)
    return 1

def integer_zero(s:readbuf,w:mutbuf,node:u64) -> bool:
    tag = get(w,node)
    if tag == 1:
        return True
    if tag == 2:
        return False
    return get(w,node+48) == 1 and character(s,get(w,node+40)) == 48

def integer_negative(s:readbuf,w:mutbuf,node:u64) -> bool:
    if get(w,node) != 3:
        return False
    return get(w,node+40) != (get(w,node+56)&4294967295) and integer_zero(s,w,node) == False

def integer_size(w:mutbuf,node:u64) -> u64:
    if get(w,node) == 3:
        return get(w,node+48)
    return 1

def integer_digit(s:readbuf,w:mutbuf,node:u64,index:u64) -> u64:
    if get(w,node) == 1:
        return 48
    if get(w,node) == 2:
        return 49
    return character(s,get(w,node+40)+index)

def scalar_truth(s:readbuf,w:mutbuf,node:u64) -> u64:
    if node != 0 and get(w,node) == 3:
        return choose(integer_zero(s,w,node),0,1)
    return truth(w,node)

def value_result(s:readbuf,o:mutbuf,w:mutbuf,node:u64) -> u32:
    if node == 0:
        if length(o) < 64:
            return 4294967294
        header(o,0,0,0,0,0,0,0)
        return 64
    tag = get(w,node)
    size = 0
    units = 0
    encoding = 0
    bits = 0
    if tag == 3:
        units = integer_size(w,node)+choose(integer_negative(s,w,node),1,0)
        size = units
        encoding = 2
    elif tag == 4:
        bits = get(w,node+40)
    elif tag == 5:
        units = get(w,node+48)
        size = units*4
        encoding = 1
    elif tag >= 6:
        span = get(w,node+56)
        units = (span>>32)-(span&4294967295)
        size = units*4
        encoding = 1
    if length(o) < 64+size:
        return 4294967294
    header(o,0,tag,scalar_truth(s,w,node),bits,units,encoding,size)
    if tag == 3:
        integer_output(s,o,w,node,0,True)
    elif tag == 5:
        i = 0
        while i < size:
            store(o,64+i,byte(w,get(w,node+40)+i))
            i = i+1
    elif tag >= 6:
        at = get(w,node+56)&4294967295
        i = 0
        while i < size:
            store(o,64+i,byte(s,64+at*4+i))
            i = i+1
    return 64+size

def integer_output(s:readbuf,o:mutbuf,w:mutbuf,node:u64,at:u64,writing:bool) -> u64:
    if integer_negative(s,w,node):
        at = pemit(o,at,45,writing)
    i = 0
    while i < integer_size(w,node):
        at = pemit(o,at,integer_digit(s,w,node,i),writing)
        i = i+1
    return at

def pemit(o:mutbuf,at:u64,cp:u64,writing:bool) -> u64:
    if writing:
        store(o,64+at,cp)
    return at+1

def small_text(o:mutbuf,at:u64,value:u64,size:u64,writing:bool) -> u64:
    i = 0
    while i < size:
        at = pemit(o,at,(value>>(i*8))&255,writing)
        i = i+1
    return at

def hex_digit(value:u64) -> u64:
    if value < 10:
        return value+48
    return value+87

def escape_unit(o:mutbuf,at:u64,cp:u64,writing:bool) -> u64:
    at = pemit(o,at,92,writing)
    at = pemit(o,at,117,writing)
    at = pemit(o,at,hex_digit((cp>>12)&15),writing)
    at = pemit(o,at,hex_digit((cp>>8)&15),writing)
    at = pemit(o,at,hex_digit((cp>>4)&15),writing)
    return pemit(o,at,hex_digit(cp&15),writing)

def string_output(o:mutbuf,w:mutbuf,node:u64,at:u64,writing:bool) -> u64:
    at = pemit(o,at,34,writing)
    i = 0
    while i < get(w,node+48):
        cp = get32(w,get(w,node+40)+i*4)
        if cp >= 32 and cp <= 126 and cp != 34 and cp != 92:
            at = pemit(o,at,cp,writing)
        elif cp == 34 or cp == 92:
            at = pemit(o,at,92,writing)
            at = pemit(o,at,cp,writing)
        elif cp == 8 or cp == 9 or cp == 10 or cp == 12 or cp == 13:
            code = 98
            if cp == 9:
                code = 116
            elif cp == 10:
                code = 110
            elif cp == 12:
                code = 102
            elif cp == 13:
                code = 114
            at = pemit(o,at,92,writing)
            at = pemit(o,at,code,writing)
        elif cp >= 65536:
            at = escape_unit(o,at,55296+((cp-65536)>>10),writing)
            at = escape_unit(o,at,56320+((cp-65536)&1023),writing)
        else:
            at = escape_unit(o,at,cp,writing)
        i = i+1
    return pemit(o,at,34,writing)

def number_output(o:mutbuf,w:mutbuf,node:u64,at:u64,writing:bool) -> u64:
    bits = get(w,node+40)
    magnitude = bits&9223372036854775807
    if magnitude > 9218868437227405312:
        return small_text(o,at,5136718,3,writing)
    if magnitude == 9218868437227405312:
        if bits>>63 != 0:
            at = pemit(o,at,45,writing)
        return small_text(o,at,8751735898823355977,8,writing)
    size = format_binary64(w,bits,8336)
    if size > 64:
        put(w,12328,16)
        return 0
    i = 0
    while i < size:
        at = pemit(o,at,byte(w,8336+i),writing)
        i = i+1
    return at

def serialize(s:readbuf,o:mutbuf,w:mutbuf,root:u64,writing:bool) -> u64:
    node = root
    at = 0
    depth = 0
    while node != 0:
        tag = get(w,node)
        complete = True
        if tag == 0:
            at = small_text(o,at,1819047278,4,writing)
        elif tag == 1:
            at = small_text(o,at,435728179558,5,writing)
        elif tag == 2:
            at = small_text(o,at,1702195828,4,writing)
        elif tag == 3:
            at = integer_output(s,o,w,node,at,writing)
        elif tag == 4:
            at = number_output(o,w,node,at,writing)
            if get(w,12328) != 0:
                return 0
        elif tag == 5:
            at = string_output(o,w,node,at,writing)
        else:
            if depth >= get(w,12352):
                put(w,12328,17)
                return 0
            depth = depth+1
            at = pemit(o,at,choose(tag == 6,91,123),writing)
            child = get(w,node+24)
            if child == 0:
                at = pemit(o,at,choose(tag == 6,93,125),writing)
                depth = depth-1
            else:
                if tag == 7:
                    at = string_output(o,w,get(w,child+32),at,writing)
                    at = pemit(o,at,58,writing)
                    at = pemit(o,at,32,writing)
                node = child
                complete = False
        while complete and node != 0:
            if node == root:
                node = 0
            else:
                parent = get(w,node+8)
                sibling = get(w,node+16)
                if sibling != 0:
                    at = pemit(o,at,44,writing)
                    at = pemit(o,at,32,writing)
                    if get(w,parent) == 7:
                        at = string_output(o,w,get(w,sibling+32),at,writing)
                        at = pemit(o,at,58,writing)
                        at = pemit(o,at,32,writing)
                    node = sibling
                    complete = False
                else:
                    at = pemit(o,at,choose(get(w,parent) == 6,93,125),writing)
                    depth = depth-1
                    node = parent
    return at


def is_numeric(tag:u64) -> bool:
    return tag >= 1 and tag <= 4

def equal_integer(s:readbuf,w:mutbuf,left:u64,right:u64) -> bool:
    if integer_negative(s,w,left) != integer_negative(s,w,right):
        return False
    size = integer_size(w,left)
    if size != integer_size(w,right):
        return False
    i = 0
    while i < size:
        if integer_digit(s,w,left,i) != integer_digit(s,w,right,i):
            return False
        i = i+1
    return True

def float_integer_digits(w:mutbuf,bits:u64) -> u64:
    exponent = (bits>>52)&2047
    mantissa = (bits&4503599627370495)|4503599627370496
    if exponent < 1023 or exponent == 2047:
        return 0
    shift = 0
    if exponent < 1075:
        down = 1075-exponent
        if (mantissa&((1<<down)-1)) != 0:
            return 0
        mantissa = mantissa>>down
    else:
        shift = exponent-1075
    size = 0
    while mantissa >= 10:
        quotient = divide10(mantissa)
        store(w,9500+size,mantissa-quotient*10)
        size = size+1
        mantissa = quotient
    store(w,9500+size,mantissa)
    size = size+1
    i = 0
    while i < shift:
        j = 0
        carry = 0
        while j < size:
            value = byte(w,9500+j)*2+carry
            carry = 0
            if value >= 10:
                carry = 1
                value = value-10
            store(w,9500+j,value)
            j = j+1
        if carry != 0:
            store(w,9500+size,carry)
            size = size+1
        i = i+1
    return size

def equal_float_integer(s:readbuf,w:mutbuf,floating:u64,integer:u64) -> bool:
    bits = get(w,floating+40)
    magnitude = bits&9223372036854775807
    if magnitude == 0:
        return integer_zero(s,w,integer)
    if magnitude >= 9218868437227405312:
        return False
    if (bits>>63 != 0) != integer_negative(s,w,integer):
        return False
    size = float_integer_digits(w,bits)
    if size == 0 or size != integer_size(w,integer):
        return False
    i = 0
    while i < size:
        if byte(w,9500+size-i-1)+48 != integer_digit(s,w,integer,i):
            return False
        i = i+1
    return True

def equal_numeric(s:readbuf,w:mutbuf,left:u64,right:u64,nested:bool) -> bool:
    a = get(w,left)
    b = get(w,right)
    if a != 4 and b != 4:
        return equal_integer(s,w,left,right)
    if a == 4 and b != 4:
        return equal_float_integer(s,w,left,right)
    if b == 4 and a != 4:
        return equal_float_integer(s,w,right,left)
    x = get(w,left+40)
    y = get(w,right+40)
    xm = x&9223372036854775807
    ym = y&9223372036854775807
    if xm > 9218868437227405312 or ym > 9218868437227405312:
        return nested and xm > 9218868437227405312 and ym > 9218868437227405312
    if xm == 0 and ym == 0:
        return True
    return x == y

def equal_values(s:readbuf,w:mutbuf,left:u64,right:u64) -> bool:
    end = get(w,12296)
    stack = end-24
    put(w,stack,left)
    put(w,stack+8,right)
    put(w,stack+16,0)
    while stack < end:
        a = get(w,stack)
        b = get(w,stack+8)
        nested = get(w,stack+16) != 0
        stack = stack+24
        atype = get(w,a)
        btype = get(w,b)
        if is_numeric(atype) and is_numeric(btype):
            if equal_numeric(s,w,a,b,nested) == False:
                return False
        elif atype != btype:
            return False
        elif atype == 5:
            if string_compare(w,a,b) != 0:
                return False
        elif atype >= 6:
            if get(w,a+48) != get(w,b+48):
                return False
            x = get(w,a+24)
            y = get(w,b+24)
            while x != 0:
                if atype == 7 and string_compare(w,get(w,x+32),get(w,y+32)) != 0:
                    return False
                if stack < get(w,12288)+24:
                    put(w,12328,16)
                    return False
                stack = stack-24
                put(w,stack,x)
                put(w,stack+8,y)
                put(w,stack+16,1)
                x = get(w,x+16)
                y = get(w,y+16)
    return True

def divide10(value:u64) -> u64:
    step = 64
    remainder = 0
    quotient = 0
    while step > 0:
        step = step-1
        remainder = (remainder<<1)|((value>>step)&1)
        if remainder >= 10:
            remainder = remainder-10
            quotient = quotient|(1<<step)
    return quotient

def diagnostic_decimal(w:mutbuf,at:u64,value:u64) -> u64:
    count = 0
    while value >= 10:
        quotient = divide10(value)
        store(w,9000+count,48+value-quotient*10)
        value = quotient
        count = count+1
    store(w,9000+count,48+value)
    count = count+1
    while count > 0:
        count = count-1
        store(w,at,byte(w,9000+count))
        at = at+1
    return at

def key_repr(s:readbuf,w:mutbuf,at:u64) -> u64:
    begin = get(w,12360)
    size = get(w,12368)
    single = False
    double = False
    i = 0
    while i < size:
        cp = character(s,begin+i)
        single = single or cp == 39
        double = double or cp == 34
        i = i+1
    quote = choose(single and double == False,34,39)
    store(w,at,quote)
    at = at+1
    i = 0
    while i < size:
        cp = character(s,begin+i)
        if cp == quote or cp == 92:
            store(w,at,92)
            store(w,at+1,cp)
            at = at+2
        elif cp == 9 or cp == 10 or cp == 13:
            store(w,at,92)
            store(w,at+1,choose(cp == 9,116,choose(cp == 10,110,114)))
            at = at+2
        elif cp < 32 or cp == 127:
            store(w,at,92)
            store(w,at+1,120)
            store(w,at+2,hex_digit(cp>>4))
            store(w,at+3,hex_digit(cp&15))
            at = at+4
        else:
            store(w,at,cp)
            at = at+1
        i = i+1
    store(w,at,quote)
    return at+1

def type_name(w:mutbuf,at:u64,tag:u64) -> u64:
    if tag == 0:
        return type_none(w,at)
    if tag == 1 or tag == 2:
        return type_bool(w,at)
    if tag == 3:
        return type_int(w,at)
    if tag == 4:
        return type_float(w,at)
    if tag == 5:
        return type_str(w,at)
    if tag == 6:
        return type_list(w,at)
    return type_dict(w,at)

def report_error(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    code = get(w,12328)
    if code == 0 or code == 16:
        return 4294967295
    at = 10000
    if code <= 9:
        at = json_error_prefix(w,at)
        if code == 1:
            at = expecting_value(w,at)
        elif code == 2:
            at = property_name(w,at)
        elif code == 3:
            at = colon(w,at)
        elif code == 4:
            at = comma(w,at)
        elif code == 5:
            at = unterminated(w,at)
        elif code == 6:
            at = control_character(w,at)
        elif code == 7:
            at = invalid_escape(w,at)
        elif code == 8:
            at = invalid_unicode(w,at)
        else:
            at = extra_data(w,at)
        position = get(w,12336)
        base = get(w,12304)
        line = 1
        last_line = base
        i = base
        while i < position:
            if character(s,i) == 10:
                line = line+1
                last_line = i+1
            i = i+1
        at = line_prefix(w,at)
        at = diagnostic_decimal(w,at,line)
        at = column_prefix(w,at)
        at = diagnostic_decimal(w,at,position-last_line+1)
        at = char_prefix(w,at)
        at = diagnostic_decimal(w,at,position-base)
        store(w,at,41)
        at = at+1
    elif code == 10:
        at = integer_limit(w,at)
        at = diagnostic_decimal(w,at,get(w,12344))
        at = integer_limit_tail(w,at)
    elif code == 11:
        at = recursion_array(w,at)
    elif code == 12:
        at = recursion_object(w,at)
    elif code == 13:
        at = key_error(w,at)
        at = key_repr(s,w,at)
    elif code == 17:
        at = recursion_encode(w,at)
    elif code == 14:
        tag = get(w,12344)
        if tag == 5:
            at = string_indices(w,at)
        elif tag == 6:
            at = list_indices(w,at)
        else:
            at = type_error(w,at)
            at = type_name(w,at,tag)
            at = not_subscriptable(w,at)
    else:
        at = attribute_error(w,at)
        at = type_name(w,at,get(w,12344))
        at = no_attribute(w,at)
        if code == 15:
            at = update_attribute(w,at)
        else:
            at = get_attribute(w,at)
    size = at-10000
    if length(o) < 64+size:
        return 4294967294
    header(o,3,code,0,0,0,2,size)
    i = 0
    while i < size:
        store(o,64+i,byte(w,10000+i))
        i = i+1
    return 64+size

