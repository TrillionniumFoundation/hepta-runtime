def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(s)!=64 or load(s,0)!=REQUEST:
        return INVALID
    size=load(s,8)
    if size==0 or size>=LIMIT:
        return INVALID
    at=16
    while at<64:
        if load(s,at)!=0:
            return INVALID
        at=at+8
    if length(w)<4096:
        return WORK_SHORT
    put(w,0,64)
    put(w,8,0)
    command(o,w,size)
    needed=get(w,0)
    if length(o)<needed:
        return OUTPUT_SHORT
    fill_range(o,0,64,0)
    put(o,0,RESPONSE)
    put(o,8,size)
    put(o,16,size>>16)
    put(o,24,size&65535)
    put(o,56,needed-64)
    put(w,0,64)
    put(w,8,1)
    command(o,w,size)
    return needed

def command(o:mutbuf,w:mutbuf,size:u64) -> u64:
    literal(o,w,1)
    number(o,w,size>>16)
    literal(o,w,2)
    remainder=size&65535
    if remainder!=0:
        literal(o,w,3)
        number(o,w,remainder)
        literal(o,w,4)
    literal(o,w,5)
    number(o,w,size)
    literal(o,w,6)
    return 0

def load(s:readbuf,at:u64) -> u64:
    value=0
    index=0
    while index<8:
        value=value|(byte(s,at+index)<<(index*8))
        index=index+1
    return value

def get(w:mutbuf,at:u64) -> u64:
    value=0
    index=0
    while index<8:
        value=value|(byte(w,at+index)<<(index*8))
        index=index+1
    return value

def put(w:mutbuf,at:u64,value:u64) -> u64:
    index=0
    while index<8:
        store(w,at+index,value>>(index*8))
        index=index+1
    return 0

def emit(o:mutbuf,w:mutbuf,value:u64) -> u64:
    at=get(w,0)
    if get(w,8)!=0:
        store(o,at,value)
    put(w,0,at+1)
    return 0

def emit_word(o:mutbuf,w:mutbuf,value:u64) -> u64:
    at=get(w,0)
    if get(w,8)!=0:
        put(o,at,value)
    put(w,0,at+8)
    return 0

def number(o:mutbuf,w:mutbuf,value:u64) -> u64:
    at=0
    started=0
    while at<10:
        power=power10(at)
        digit=0
        while value>=power:
            value=value-power
            digit=digit+1
        if digit!=0 or started!=0 or at==9:
            emit(o,w,48+digit)
            started=1
        at=at+1
    return 0
