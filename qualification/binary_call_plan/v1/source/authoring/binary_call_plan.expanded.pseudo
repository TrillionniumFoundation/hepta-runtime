
def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(o)<64:
        return 4294967294
    if valid_frame(s)==0:
        return 4294967295
    if length(w)<512:
        return grow(o,1,512)
    put(w,0,64)
    put(w,8,0)
    plan(s,o,w)
    needed=get(w,0)
    if needed>=4294901760:
        return 4294967295
    if needed>length(o):
        return grow(o,2,needed)
    fill_range(o,0,64,0)
    put(w,0,64)
    put(w,8,1)
    plan(s,o,w)
    put(o,0,3544386036766360136)
    put(o,8,get(w,16))
    put(o,16,load(s,64))
    put(o,24,get(w,24))
    put(o,32,get(w,32))
    put(o,40,get(w,40))
    put(o,48,get(w,48))
    put(o,56,get(w,0)-64)
    return get(w,0)

def load(s:readbuf,at:u64) -> u64:
    value=0
    index=0
    while index<8:
        value=value|(byte(s,at+index)<<(index*8))
        index=index+1
    return value

def get(w:mutbuf,at:u64) -> u64:
    value=0
    index=0
    while index<8:
        value=value|(byte(w,at+index)<<(index*8))
        index=index+1
    return value

def put(w:mutbuf,at:u64,value:u64) -> u64:
    index=0
    while index<8:
        store(w,at+index,value>>(index*8))
        index=index+1
    return 0

def grow(o:mutbuf,kind:u64,needed:u64) -> u32:
    put(o,0,3616443635283937096)
    put(o,8,kind)
    put(o,16,needed)
    put(o,24,0)
    return 4294967248

def span_start(s:readbuf,index:u64) -> u64:
    at=304
    count=0
    while count<index:
        at=at+load(s,136+count*8)
        count=count+1
    return at

def span_size(s:readbuf,index:u64) -> u64:
    return load(s,136+index*8)

def optional_mask(kind:u64) -> u64:
    if kind==2:
        return 1552
    if kind==4:
        return 2648
    if kind==5:
        return 792
    return 0

def allowed_string(kind:u64,index:u64) -> u64:
    if index<2:
        return 1
    if kind==2 and index==3:
        return 1
    if kind==3 and index<4:
        return 1
    if kind==4 and index<6:
        return 1
    if kind==5 and (index==2 or index==3 or index==6 or index==7):
        return 1
    return 0

def option_string_bit(kind:u64,index:u64) -> u64:
    if kind==2 and index==3:
        return 16
    if kind==4 or kind==5:
        if index==2:
            return 8
        if index==3:
            return 16
        if kind==4 and index==5:
            return 64
        if kind==5 and index==7:
            return 256
    return 0

def valid_typed(s:readbuf,size:u64) -> u64:
    if size<256 or load(s,48)!=3544386036867023432 or load(s,56)!=0:
        return 0
    kind=load(s,64)
    action=load(s,72)
    mask=load(s,80)
    flags=load(s,88)
    if kind<1 or kind>5 or (mask&optional_mask(kind))!=mask:
        return 0
    if kind<4 and action!=0:
        return 0
    if kind>=4 and (action<1 or action>3):
        return 0
    if (kind!=5 and flags!=0) or flags>3:
        return 0
    if load(s,120)!=0 or load(s,128)!=0:
        return 0
    index=200
    while index<304:
        if byte(s,index)!=0:
            return 0
        index=index+1
    index=0
    remaining=size-256
    at=304
    while index<8:
        count=span_size(s,index)
        if count>remaining:
            return 0
        if allowed_string(kind,index)==0 and count!=0:
            return 0
        bit=option_string_bit(kind,index)
        if bit!=0 and (mask&bit)==0 and count!=0:
            return 0
        if utf8(s,at,count)==0:
            return 0
        at=at+count
        remaining=remaining-count
        index=index+1
    if remaining!=0:
        return 0
    if (mask&512)==0 and load(s,96)!=0:
        return 0
    if (mask&1024)==0 and load(s,104)!=0:
        return 0
    if (mask&2048)==0 and load(s,112)!=0:
        return 0
    return 1

def valid_feedback(s:readbuf,at:u64,size:u64,phase:u64) -> u64:
    if size<32 or load(s,at)!=3544417875257414216:
        return 0
    status=load(s,at+8)
    if status>1 or load(s,at+16)!=0 or load(s,at+24)!=size-32:
        return 0
    if phase==1 and status==0 and size!=32:
        return 0
    return utf8(s,at+32,size-32)

def valid_frame(s:readbuf) -> u64:
    if length(s)<304 or length(s)>=4294901760:
        return 0
    if load(s,0)!=3544386032471392840 or load(s,8)>2 or load(s,16)>1 or load(s,40)!=0:
        return 0
    size=load(s,24)
    if size>length(s)-48:
        return 0
    feedback=load(s,32)
    if feedback!=length(s)-48-size or valid_typed(s,size)==0:
        return 0
    phase=load(s,8)
    if phase==0:
        if feedback!=0:
            return 0
        return 1
    if phase==1 and load(s,64)!=5:
        return 0
    return valid_feedback(s,48+size,feedback,phase)

def emit(w:mutbuf,o:mutbuf,value:u64) -> u64:
    at=get(w,0)
    if get(w,8)!=0:
        store(o,at,value)
    put(w,0,at+1)
    return 0

def emit_word(w:mutbuf,o:mutbuf,value:u64) -> u64:
    at=get(w,0)
    if get(w,8)!=0:
        put(o,at,value)
    put(w,0,at+8)
    return 0

def emit_span(s:readbuf,w:mutbuf,o:mutbuf,at:u64,count:u64) -> u64:
    destination=get(w,0)
    if get(w,8)!=0:
        copy_span(o,s,destination,at,count)
    put(w,0,destination+count)
    return 0

def hex_digit(value:u64) -> u64:
    if value<10:
        return value+48
    return value+87

def json_string(s:readbuf,o:mutbuf,w:mutbuf,at:u64,count:u64) -> u64:
    emit(w,o,34)
    index=0
    start=0
    while index<count:
        value=byte(s,at+index)
        if value<32 or value==34 or value==92:
            emit_span(s,w,o,at+start,index-start)
            emit(w,o,92)
            if value==34 or value==92:
                emit(w,o,value)
            elif value==8:
                emit(w,o,98)
            elif value==9:
                emit(w,o,116)
            elif value==10:
                emit(w,o,110)
            elif value==12:
                emit(w,o,102)
            elif value==13:
                emit(w,o,114)
            else:
                emit(w,o,117)
                emit(w,o,48)
                emit(w,o,48)
                emit(w,o,hex_digit(value>>4))
                emit(w,o,hex_digit(value&15))
            start=index+1
        index=index+1
    emit_span(s,w,o,at+start,count-start)
    emit(w,o,34)
    return 0

def number(o:mutbuf,w:mutbuf,value:u64) -> u64:
    index=0
    started=0
    while index<20:
        power=decimal_power(index)
        digit=0
        while value>=power:
            value=value-power
            digit=digit+1
        if digit!=0 or started!=0 or index==19:
            emit(w,o,48+digit)
            started=1
        index=index+1
    return 0

def boolean(o:mutbuf,w:mutbuf,value:u64) -> u64:
    if value==0:
        literal(o,w,101)
    else:
        literal(o,w,102)
    return 0

def string_field(s:readbuf,o:mutbuf,w:mutbuf,index:u64,optional:u64) -> u64:
    if optional!=0 and (load(s,80)&optional)==0:
        literal(o,w,100)
    else:
        json_string(s,o,w,span_start(s,index),span_size(s,index))
    return 0

def number_field(s:readbuf,o:mutbuf,w:mutbuf,at:u64,optional:u64) -> u64:
    if optional!=0 and (load(s,80)&optional)==0:
        literal(o,w,100)
    else:
        number(o,w,load(s,at))
    return 0

def identifier(s:readbuf,at:u64,count:u64) -> u64:
    if count<8 or count>96:
        return 0
    index=0
    while index<count:
        value=byte(s,at+index)
        if value!=45 and value!=95 and (value<48 or value>57) and (value<65 or value>90) and (value<97 or value>122):
            return 0
        index=index+1
    return 1

def hex_hash(s:readbuf,at:u64,count:u64) -> u64:
    if count!=64:
        return 0
    index=0
    while index<count:
        value=byte(s,at+index)
        if (value<48 or value>57) and (value<65 or value>70) and (value<97 or value>102):
            return 0
        index=index+1
    return 1

def precondition(s:readbuf) -> u64:
    kind=load(s,64)
    if kind==3 and span_size(s,2)>1398104:
        return 1
    if kind==4:
        if identifier(s,span_start(s,4),span_size(s,4))==0:
            return 2
        action=load(s,72)
        mask=load(s,80)
        if action==1 and ((mask&16)==0 or (mask&8)==0 or span_size(s,2)>1398104):
            return 3
        if action==2 and ((mask&2048)==0 or (mask&64)==0 or hex_hash(s,span_start(s,5),span_size(s,5))==0):
            return 4
    if kind==5 and (load(s,88)&1)==0:
        return 5
    return 0

def apply_precondition(s:readbuf) -> u64:
    mask=load(s,80)
    if load(s,72)==1 and ((mask&16)==0 or (mask&256)==0 or (mask&8)==0 or span_size(s,2)>87384):
        return 6
    return 0

def error_literal(o:mutbuf,w:mutbuf,code:u64) -> u64:
    put(w,16,1)
    literal(o,w,code)
    return 0

def error_feedback(s:readbuf,o:mutbuf,w:mutbuf) -> u64:
    put(w,16,1)
    emit_span(s,w,o,80+load(s,24),load(s,32)-32)
    return 0

def config_request(s:readbuf,o:mutbuf,w:mutbuf,operation:u64,write:u64,next_phase:u64) -> u64:
    put(w,16,2)
    put(w,24,next_phase)
    put(w,32,operation)
    put(w,40,write)
    emit_word(w,o,3544422273303925320)
    emit_word(w,o,operation)
    emit_word(w,o,40+span_size(s,0)+span_size(s,1))
    emit_word(w,o,0)
    emit_word(w,o,0)
    emit_word(w,o,write)
    emit_word(w,o,span_size(s,0))
    emit_word(w,o,span_size(s,1))
    emit_span(s,w,o,304,span_size(s,0)+span_size(s,1))
    return 0

def operation_code(s:readbuf) -> u64:
    kind=load(s,64)
    if kind<4:
        return kind
    if kind==4:
        return 3+load(s,72)
    return 7

def plan(s:readbuf,o:mutbuf,w:mutbuf) -> u64:
    fill_range(w,16,48,0)
    code=precondition(s)
    if code!=0:
        return error_literal(o,w,code)
    kind=load(s,64)
    phase=load(s,8)
    if kind==5:
        if phase==0:
            return config_request(s,o,w,8,0,1)
        if phase==1 and load(s,56+load(s,24))!=0:
            return error_feedback(s,o,w)
        code=apply_precondition(s)
        if code!=0:
            return error_literal(o,w,code)
    if phase<2:
        return config_request(s,o,w,9,choose(kind>=3,1,0),2)
    if load(s,56+load(s,24))!=0:
        return error_feedback(s,o,w)
    put(w,16,3)
    put(w,32,operation_code(s))
    put(w,40,choose(kind>=3,1,0))
    if kind<3:
        put(w,48,load(s,16))
    return query_json(s,o,w)

def query_json(s:readbuf,o:mutbuf,w:mutbuf) -> u64:
    kind=load(s,64)
    emit(w,o,123)
    if kind==1:
        literal(o,w,110)
        literal(o,w,201)
    elif kind==2:
        literal(o,w,111)
        string_field(s,o,w,3,16)
        literal(o,w,112)
        limit=load(s,104)
        if (load(s,80)&1024)==0:
            limit=32768
        if limit<1:
            limit=1
        if limit>65536:
            limit=65536
        number(o,w,limit)
        literal(o,w,113)
        number_field(s,o,w,96,512)
        literal(o,w,114)
        literal(o,w,202)
    elif kind==3:
        literal(o,w,115)
        string_field(s,o,w,2,0)
        literal(o,w,116)
        string_field(s,o,w,3,0)
        literal(o,w,114)
        literal(o,w,203)
    elif kind==4:
        literal(o,w,115)
        string_field(s,o,w,2,8)
        literal(o,w,116)
        string_field(s,o,w,3,16)
        literal(o,w,113)
        number_field(s,o,w,96,512)
        literal(o,w,114)
        literal(o,w,200+operation_code(s))
    else:
        literal(o,w,117)
        boolean(o,w,load(s,88)&1)
        literal(o,w,118)
        literal(o,w,210+load(s,72))
        literal(o,w,119)
        string_field(s,o,w,2,8)
        literal(o,w,120)
        string_field(s,o,w,7,256)
        literal(o,w,116)
        string_field(s,o,w,3,16)
        literal(o,w,121)
        string_field(s,o,w,0,0)
        literal(o,w,113)
        number_field(s,o,w,96,0)
        literal(o,w,114)
        literal(o,w,207)
    literal(o,w,122)
    string_field(s,o,w,1,0)
    if kind==5:
        literal(o,w,123)
        boolean(o,w,load(s,88)&2)
    literal(o,w,124)
    json_string(s,o,w,80+load(s,24),load(s,32)-32)
    if kind==4:
        literal(o,w,125)
        string_field(s,o,w,5,64)
        literal(o,w,126)
        number_field(s,o,w,112,2048)
        literal(o,w,127)
        string_field(s,o,w,4,0)
    if kind==5:
        literal(o,w,128)
        string_field(s,o,w,6,0)
    emit(w,o,125)
    return 0

