def decimal_power(index:u64) -> u64:
    if index==0:
        return 10000000000000000000
    if index==1:
        return 1000000000000000000
    if index==2:
        return 100000000000000000
    if index==3:
        return 10000000000000000
    if index==4:
        return 1000000000000000
    if index==5:
        return 100000000000000
    if index==6:
        return 10000000000000
    if index==7:
        return 1000000000000
    if index==8:
        return 100000000000
    if index==9:
        return 10000000000
    if index==10:
        return 1000000000
    if index==11:
        return 100000000
    if index==12:
        return 10000000
    if index==13:
        return 1000000
    if index==14:
        return 100000
    if index==15:
        return 10000
    if index==16:
        return 1000
    if index==17:
        return 100
    if index==18:
        return 10
    if index==19:
        return 1
    return 1
