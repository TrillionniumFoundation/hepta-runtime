def error_literal(w:mutbuf,at:u64,code:u64) -> u64:
    if code==1:
        return error_1(w,at)
    if code==2:
        return error_2(w,at)
    if code==3:
        return error_3(w,at)
    if code==4:
        return error_4(w,at)
    if code==5:
        return error_5(w,at)
    if code==6:
        return error_6(w,at)
    if code==7:
        return error_7(w,at)
    if code==8:
        return error_8(w,at)
    if code==9:
        return error_9(w,at)
    return at
