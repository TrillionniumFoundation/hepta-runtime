def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(s)>=8:
        if load(s,0)==COMPLETE_ERROR:
            if length(s)<64 or length(s)>=LIMIT or length(w)<WORK_SIZE:
                return INVALID
            if load(s,8)!=3 or load(s,16)!=0 or load(s,24)!=0:
                return INVALID
            if load(s,32)!=0 or load(s,40)!=0 or load(s,48)!=0:
                return INVALID
            size=load(s,56)
            if size==0 or size!=length(s)-64:
                return INVALID
            if utf8(s,64,size)==0:
                return INVALID
            if length(o)<size:
                return CAPACITY
            copy_in(s,o,64,0,size)
            return size
    return previous_formatter(s,o,w)
