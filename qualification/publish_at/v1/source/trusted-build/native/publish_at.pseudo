        put(w,104,18446744073709551615)
        put(w,112,18446744073709551615)
        put(w,120,18446744073709551615)
        put(w,184,publish_error_capacity(get(w,64),get(w,72)))
        put(w,192,needed)
        put(w,200,8192+get(w,64)+1)
        put(w,208,get(w,200)+get(w,72)+1)
        put(w,216,get(w,208)+get(w,80))
        put(w,224,get(w,216)+get(w,184))
        copy_in(s,w,96,8192,get(w,64))
        store(w,8192+get(w,64),0)
        copy_in(s,w,96+get(w,64),get(w,200),get(w,72))
        store(w,get(w,200)+get(w,72),0)
        copy_in(s,w,96+get(w,64)+get(w,72),get(w,208),get(w,80))
    else:
        if length(w)<8192 or get(w,0)!=3544386058073755720:
            return 4294967295
        if length(w)<get(w,192):
            return publish_short(o,4,get(w,192))
        if load(s,32)!=0 or load(s,40)!=0 or load(s,48)!=0 or load(s,56)!=0:
            return 4294967295
        if load(s,64)!=0 or load(s,72)!=0 or load(s,80)!=0:
            return 4294967295
        if length(s)-96>1048576:
            return 4294967295
        if negative(load(s,24))!=0:
            if length(s)!=96 or load(s,24)<18446744073709551615-4094:
                return 4294967295
        sequence=load(s,16)
        if get(w,24)!=0:
            if sequence!=get(w,24):
                return 4294967295
            copy_in(s,w,96,get(w,224),length(s)-96)
            put(w,32,sequence)
            put(w,40,load(s,24))
            put(w,48,length(s)-96)
            put(w,24,0)
        else:
            if sequence!=get(w,32) or load(s,24)!=get(w,40) or length(s)-96!=get(w,48):
                return 4294967295
            at=0
            while at<get(w,48):
                if byte(s,96+at)!=byte(w,get(w,224)+at):
                    return 4294967295
                at=at+1
    status=4294967293
    while status==4294967293:
        phase=get(w,8)
        if phase>=100 and phase<120:
            status=regular_flow(o,w)
        else:
            if phase>=210 and phase<220:
                status=expected_flow(o,w)
            else:
                if phase>=90 and phase<=99:
                    status=publish_finish(o,w)
                else:
                    if phase<=50:
                        status=publish_before(o,w)
                    else:
                        status=publish_after(o,w)
    return status

def valid_publish_start(s:readbuf) -> u64:
    if load(s,16)!=0 or load(s,24)!=1 or load(s,32)>2147483647:
        return 0
    if load(s,64)>1 or load(s,72)!=0 or load(s,80)!=0:
        return 0
    name=load(s,40)
    temp=load(s,48)
    prior=load(s,56)
    left=length(s)-96
    if name>left:
        return 0
    left=left-name
    if temp>left or prior!=left-temp:
        return 0
    if load(s,64)==0 and prior!=0:
        return 0
    if utf8(s,96,name)==0 or utf8(s,96+name,temp)==0 or utf8(s,96+name+temp,prior)==0:
        return 0
    at=0
    while at<name+temp:
        if byte(s,96+at)==47:
            return 0
        at=at+1
    return 1

def publish_error_capacity(name:u64,temp:u64) -> u64:
    return name+temp+1024

def publish_required(name:u64,temp:u64,prior:u64) -> u64:
    return 8192+name+1+temp+1+prior+publish_error_capacity(name,temp)+1048576

def publish_short(o:mutbuf,kind:u64,size:u64) -> u32:
    fill_range(o,0,64,0)
    put(o,0,3544386036598919240)
    put(o,8,kind)
    put(o,32,size)
    return 64

def publish_request(w:mutbuf,o:mutbuf,phase:u64,kind:u64,op:u64,a:u64,b:u64,c:u64,at:u64,size:u64) -> u64:
    if size>length(w) or at>length(w)-size:
        return 4294967295
    if length(o)<64+size:
        return publish_short(o,5,64+size)
    sequence=get(w,16)+1
    if sequence==0:
        return 4294967295
    fill_range(o,0,64,0)
    put(o,0,3544386036598919240)
    put(o,8,kind)
    put(o,16,sequence)
    put(o,24,op)
    put(o,32,a)
    put(o,40,b)
    put(o,48,c)
    put(o,56,size)
    copy_out(w,o,at,64,size)
    put(w,16,sequence)
    put(w,24,sequence)
    put(w,8,phase)
    return 64

def error_class(number:u64) -> u64:
    if number==1 or number==13:
        return 2
    if number==2:
        return 4
    if number==20:
        return 5
    if number==21:
        return 6
    if number==17:
        return 7
    if number==4:
        return 8
    if number==11 or number==114 or number==115:
        return 9
    if number==32 or number==108:
        return 10
    if number==110:
        return 11
    if number==104:
        return 12
    if number==103:
        return 13
    if number==111:
        return 14
    return 3

def error_header(w:mutbuf,tag:u64,klass:u64,number:u64,literal:u64,named:u64,size:u64) -> u64:
