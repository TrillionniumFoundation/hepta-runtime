        size=get(w,72)
        copy_within(w,get(w,216)+64,get(w,200),size)
    if named==3:
        size=get(w,72)+get(w,64)
        copy_within(w,get(w,216)+64,get(w,200),get(w,72))
        copy_within(w,get(w,216)+64+get(w,72),8192,get(w,64))
        error_header(w,3544386036649119560,error_class(number),number,get(w,72),3,size)
    else:
        kind=0
        if named!=0:
            kind=1
        error_header(w,3544386040927240776,error_class(number),number,0,kind,size)
    put(w,8,90)
    return 4294967293

def is_absent(w:mutbuf) -> u64:
    if get(w,80)!=6:
