    if command==1:
        if valid_publish_start(s)==0:
            return 4294967295
        needed=publish_required(load(s,40),load(s,48),load(s,56))
        if needed>=4294901760:
            return 4294967295
        if length(w)<needed:
            return publish_short(o,4,needed)
