    if phase==91 or phase==92:
        if get(w,48)!=0:
            return 4294967295
        if phase==91:
            put(w,112,18446744073709551615)
        else:
            put(w,120,18446744073709551615)
        if negative(result)!=0:
            return publish_os_error(w,0-result,0)
        if result!=0:
            return 4294967295
        put(w,8,90)
        return 4294967293
    if phase==99:
        size=get(w,176)
        if length(o)<64+size:
            return publish_short(o,5,64+size)
        fill_range(o,0,64,0)
        put(o,0,3544386036598919240)
        put(o,16,get(w,16))
        if size!=0:
            put(o,8,3)
        put(o,56,size)
        copy_out(w,o,get(w,216),64,size)
        return 64
    return 4294967295

def copy_within(w:mutbuf,dst:u64,src:u64,size:u64) -> u64:
    if dst>src and dst<src+size:
        at=size
        while at!=0:
            at=at-1
            store(w,dst+at,byte(w,src+at))
    else:
        at=0
        while size-at>=8:
            put(w,dst+at,get(w,src+at))
            at=at+8
        while at<size:
            store(w,dst+at,byte(w,src+at))
            at=at+1
    return size

