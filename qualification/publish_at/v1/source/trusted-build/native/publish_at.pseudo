    put(w,get(w,216),tag)
    put(w,get(w,216)+8,3)
    put(w,get(w,216)+16,get(w,16))
    put(w,get(w,216)+24,klass)
    put(w,get(w,216)+32,number)
    put(w,get(w,216)+40,literal)
    put(w,get(w,216)+48,named)
    put(w,get(w,216)+56,size)
    put(w,176,64+size)
    return 0

def publish_literal(w:mutbuf,code:u64) -> u64:
    at=get(w,216)+64
    end=at
    if code==1:
        end=literal_embedded(w,at)
    if code==2:
        end=literal_regular(w,at)
    if code==3:
        end=literal_destination(w,at)
    if code==4:
        end=literal_source(w,at)
    if end==at:
        return 4294967295
    error_header(w,3544386040927240776,1,0,end-at,0,end-at)
    put(w,8,90)
    return 4294967293

def publish_os_error(w:mutbuf,number:u64,named:u64) -> u64:
    if number==0 or number>4095 or named>3:
        return 4294967295
    size=0
