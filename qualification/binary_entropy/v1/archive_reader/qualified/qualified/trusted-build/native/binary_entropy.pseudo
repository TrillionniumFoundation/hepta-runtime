def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(s)<96 or length(s)>=4294901760:
        return 4294967295
    if load(s,0)!=3544386032605480264 or load(s,88)!=length(s)-96:
        return 4294967295
    command=load(s,8)
    if command!=1 and command!=2:
        return 4294967295
    if load(s,32)!=0 or load(s,40)!=0 or load(s,48)!=0 or load(s,56)!=0:
        return 4294967295
    if load(s,64)!=0 or load(s,72)!=0 or load(s,80)!=0:
        return 4294967295
    if length(o)<64:
        return 4294967294
    if command==1:
        if length(s)!=96 or load(s,16)!=0:
            return 4294967295
        if load(s,24)!=1 and load(s,24)!=2:
            return 4294967295
        if length(w)<1024:
            return entropy_short(o,4,1024)
        if get(w,0)==3544386058375284040:
            if get(w,8)!=0 and get(w,8)!=99:
                return 4294967295
        else:
            fill_range(w,0,1024,0)
            put(w,0,3544386058375284040)
            put(w,64,1)
            put(w,72,18446744073709551615)
        fill_range(w,8,56,0)
        fill_range(w,96,96,0)
        put(w,96,18446744073709551615)
        put(w,104,18446744073709551615)
        put(w,56,load(s,24))
        put(w,8,1)
    else:
        if length(w)<1024 or get(w,0)!=3544386058375284040:
            return 4294967295
        if length(s)>240:
            return 4294967295
        if negative(load(s,24))!=0:
            if length(s)!=96 or load(s,24)<18446744073709551615-4094:
                return 4294967295
        sequence=load(s,16)
        if get(w,24)!=0:
            if sequence!=get(w,24):
                return 4294967295
            copy_in(s,w,96,512,length(s)-96)
            put(w,32,sequence)
            put(w,40,load(s,24))
            put(w,48,length(s)-96)
            put(w,24,0)
        else:
            if sequence!=get(w,32) or load(s,24)!=get(w,40) or length(s)-96!=get(w,48):
                return 4294967295
            at=0
            while at<get(w,48):
                if byte(s,96+at)!=byte(w,512+at):
                    return 4294967295
                at=at+1
    status=4294967293
    while status==4294967293:
        phase=get(w,8)
        if phase<10:
            status=random_flow(o,w)
        else:
            if phase<30:
                status=cache_flow(o,w)
            else:
                if phase<50:
                    status=device_flow(o,w)
                else:
                    status=entropy_finish(o,w)
    return status

def entropy_short(o:mutbuf,kind:u64,size:u64) -> u32:
    fill_range(o,0,64,0)
    put(o,0,3544386036900447560)
    put(o,8,kind)
    put(o,32,size)
    return 64

def entropy_request(w:mutbuf,o:mutbuf,phase:u64,op:u64,a:u64,b:u64,c:u64) -> u64:
    sequence=get(w,16)+1
    if sequence==0:
        return 4294967295
    fill_range(o,0,64,0)
    put(o,0,3544386036900447560)
    put(o,8,1)
    put(o,16,sequence)
    put(o,24,op)
    put(o,32,a)
    put(o,40,b)
    put(o,48,c)
    put(w,16,sequence)
    put(w,24,sequence)
    put(w,8,phase)
    return 64

def error_class(number:u64) -> u64:
    if number==1 or number==13:
        return 2
    if number==2:
        return 4
    if number==20:
        return 5
    if number==21:
        return 6
    if number==17:
        return 7
    if number==4:
        return 8
    if number==11 or number==114 or number==115:
        return 9
    if number==32 or number==108:
        return 10
    if number==110:
        return 11
    if number==104:
        return 12
    if number==103:
        return 13
    if number==111:
        return 14
    return 3

def entropy_os_error(w:mutbuf,number:u64,named:u64) -> u64:
    if number==0 or number>4095 or named>1:
        return 4294967295
    put(w,128,error_class(number))
    put(w,136,number)
    put(w,144,named)
    put(w,152,0)
    put(w,8,99)
    return 4294967293

def entropy_literal(w:mutbuf,code:u64) -> u64:
    if code!=1 and code!=2:
        return 4294967295
    klass=16
    if code==2:
        klass=17
    put(w,128,klass)
    put(w,136,0)
    put(w,144,0)
    put(w,152,code)
    put(w,8,99)
    return 4294967293

def random_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==1:
        if get(w,64)==0:
            put(w,8,10)
        else:
            put(w,8,2)
        return 4294967293
    if phase==2:
        return entropy_request(w,o,3,1,16-get(w,112),0,0)
    if phase==3:
        if result==18446744073709551615-3:
            put(w,8,2)
            return 4294967293
        if result==18446744073709551615 or result==18446744073709551615-37:
            put(w,64,0)
            put(w,112,0)
            put(w,8,10)
            return 4294967293
        if negative(result)!=0:
            return entropy_os_error(w,0-result,0)
        if result>16-get(w,112) or result!=get(w,48):
            return 4294967295
        copy_within(w,256+get(w,112),512,result)
        put(w,112,get(w,112)+result)
        if get(w,112)==16:
            put(w,8,99)
        else:
            put(w,8,2)
        return 4294967293
    return 4294967295

def cache_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==10:
        if get(w,72)==18446744073709551615:
            put(w,8,20)
            return 4294967293
        return entropy_request(w,o,11,3,get(w,72),0,0)
    if phase==11:
        forget=0
        if negative(result)!=0:
            forget=1
        else:
            if result!=0 or get(w,48)!=144:
                return 4294967295
            if get(w,512)!=get(w,80) or get(w,512+8)!=get(w,88):
                forget=1
        if forget!=0:
            put(w,8,12)
        else:
            put(w,8,30)
        return 4294967293
    if phase==12:
        return entropy_request(w,o,13,6,get(w,72),0,0)
    if phase==13:
        if result!=0 or get(w,48)!=0:
            return 4294967295
        put(w,72,18446744073709551615)
        put(w,80,0)
        put(w,88,0)
        put(w,8,20)
        return 4294967293
    if phase==20:
        return entropy_request(w,o,21,2,0,0,0)
    if phase==21:
        if result==18446744073709551615-3:
            put(w,8,20)
            return 4294967293
        if negative(result)!=0:
            number=0-result
            if number==2 or number==6 or number==19 or number==13:
                return entropy_literal(w,1)
            return entropy_os_error(w,number,1)
        if result>2147483647 or get(w,48)!=0:
            return 4294967295
        put(w,96,result)
        put(w,8,22)
        return 4294967293
    if phase==22:
        return entropy_request(w,o,23,3,get(w,96),0,0)
    if phase==23:
        if negative(result)!=0:
            entropy_os_error(w,0-result,0)
            put(w,8,24)
            return 4294967293
        if result!=0 or get(w,48)!=144:
            return 4294967295
        if get(w,72)!=18446744073709551615:
            return 4294967295
        put(w,72,get(w,96))
        put(w,96,18446744073709551615)
        put(w,80,get(w,512))
        put(w,88,get(w,512+8))
        put(w,8,30)
        return 4294967293
    if phase==24:
        return entropy_request(w,o,25,4,get(w,96),0,0)
    if phase==25:
        if get(w,48)!=0:
            return 4294967295
        if negative(result)==0 and result!=0:
            return 4294967295
        put(w,96,18446744073709551615)
        put(w,8,99)
        return 4294967293
    return 4294967295

def device_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==30:
        return entropy_request(w,o,31,5,get(w,72),16-get(w,112),0)
    if phase==31:
        if result==18446744073709551615-3:
            put(w,8,30)
            return 4294967293
        if negative(result)!=0:
            return entropy_os_error(w,0-result,0)
        if result>16-get(w,112) or result!=get(w,48):
            return 4294967295
        if result==0:
            return entropy_literal(w,2)
        copy_within(w,256+get(w,112),512,result)
        put(w,112,get(w,112)+result)
        if get(w,112)==16:
            put(w,8,99)
        else:
            put(w,8,30)
        return 4294967293
    return 4294967295

def entropy_finish(o:mutbuf,w:mutbuf) -> u64:
    if get(w,8)!=99 or get(w,96)!=18446744073709551615:
        return 4294967295
    size=16
    message=0
    name=0
    if get(w,56)==2:
        size=32
    if get(w,128)!=0:
        message=0
        if get(w,152)==1:
            message=38
        if get(w,152)==2:
            message=15+24+1
            if 16-get(w,112)>=10:
                message=message+1
        name=0
        if get(w,144)!=0:
            name=12
        size=64+message+name
    if length(o)<64+size:
        return entropy_short(o,5,64+size)
    fill_range(o,0,64,0)
    put(o,0,3544386036900447560)
    put(o,16,get(w,16))
    put(o,56,size)
    if get(w,128)!=0:
        put(o,8,3)
        fill_range(o,64,64,0)
        put(o,64,3544386040927240776)
        put(o,72,3)
        put(o,80,get(w,16))
        put(o,88,get(w,128))
        put(o,96,get(w,136))
        put(o,104,message)
        put(o,112,get(w,144))
        put(o,120,message+name)
        if get(w,152)==1:
            literal_missing(o,128)
        if get(w,152)==2:
            end=literal_eof_prefix(o,128)
            number=16-get(w,112)
            if number>=10:
                store(o,end,49)
                end=end+1
                number=number-10
            store(o,end,48+number)
            literal_eof_suffix(o,end+1)
        if name!=0:
            literal_urandom(o,128+message)
        return 64
    if get(w,112)!=16:
        return 4294967295
    if get(w,56)==1:
        copy_out(w,o,256,64,16)
    else:
        at=0
        while at<16:
            value=byte(w,256+at)
            if at==6:
                value=(value&15)|64
            if at==8:
                value=(value&63)|128
            store(o,64+at*2,hex_digit(value>>4))
            store(o,65+at*2,hex_digit(value&15))
            at=at+1
    return 64

def hex_digit(value:u64) -> u64:
    if value<10:
        return 48+value
    return 87+value

def copy_within(w:mutbuf,dst:u64,src:u64,size:u64) -> u64:
    if dst>src and dst<src+size:
        at=size
        while at!=0:
            at=at-1
            store(w,dst+at,byte(w,src+at))
    else:
        at=0
        while at<size:
            store(w,dst+at,byte(w,src+at))
            at=at+1
    return size

def literal_missing(w:mutbuf,at:u64) -> u64:
    store(w,at+0,47)
    store(w,at+1,100)
    store(w,at+2,101)
    store(w,at+3,118)
    store(w,at+4,47)
    store(w,at+5,117)
    store(w,at+6,114)
    store(w,at+7,97)
    store(w,at+8,110)
    store(w,at+9,100)
    store(w,at+10,111)
    store(w,at+11,109)
    store(w,at+12,32)
    store(w,at+13,40)
    store(w,at+14,111)
    store(w,at+15,114)
    store(w,at+16,32)
    store(w,at+17,101)
    store(w,at+18,113)
    store(w,at+19,117)
    store(w,at+20,105)
    store(w,at+21,118)
    store(w,at+22,97)
    store(w,at+23,108)
    store(w,at+24,101)
    store(w,at+25,110)
    store(w,at+26,116)
    store(w,at+27,41)
    store(w,at+28,32)
    store(w,at+29,110)
    store(w,at+30,111)
    store(w,at+31,116)
    store(w,at+32,32)
    store(w,at+33,102)
    store(w,at+34,111)
    store(w,at+35,117)
    store(w,at+36,110)
    store(w,at+37,100)
    return at+38

def literal_eof_prefix(w:mutbuf,at:u64) -> u64:
    store(w,at+0,70)
    store(w,at+1,97)
    store(w,at+2,105)
    store(w,at+3,108)
    store(w,at+4,101)
    store(w,at+5,100)
    store(w,at+6,32)
    store(w,at+7,116)
    store(w,at+8,111)
    store(w,at+9,32)
    store(w,at+10,114)
    store(w,at+11,101)
    store(w,at+12,97)
    store(w,at+13,100)
    store(w,at+14,32)
    return at+15

def literal_eof_suffix(w:mutbuf,at:u64) -> u64:
    store(w,at+0,32)
    store(w,at+1,98)
    store(w,at+2,121)
    store(w,at+3,116)
    store(w,at+4,101)
    store(w,at+5,115)
    store(w,at+6,32)
    store(w,at+7,102)
    store(w,at+8,114)
    store(w,at+9,111)
    store(w,at+10,109)
    store(w,at+11,32)
    store(w,at+12,47)
    store(w,at+13,100)
    store(w,at+14,101)
    store(w,at+15,118)
    store(w,at+16,47)
    store(w,at+17,117)
    store(w,at+18,114)
    store(w,at+19,97)
    store(w,at+20,110)
    store(w,at+21,100)
    store(w,at+22,111)
    store(w,at+23,109)
    return at+24

def literal_urandom(w:mutbuf,at:u64) -> u64:
    store(w,at+0,47)
    store(w,at+1,100)
    store(w,at+2,101)
    store(w,at+3,118)
    store(w,at+4,47)
    store(w,at+5,117)
    store(w,at+6,114)
    store(w,at+7,97)
    store(w,at+8,110)
    store(w,at+9,100)
    store(w,at+10,111)
    store(w,at+11,109)
    return at+12
