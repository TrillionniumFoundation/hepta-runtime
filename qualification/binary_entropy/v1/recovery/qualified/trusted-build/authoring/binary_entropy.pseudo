def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(s)<96 or length(s)>=LIMIT:
        return INVALID
    if load(s,0)!=ENTROPY_REQUEST or load(s,88)!=length(s)-96:
        return INVALID
    command=load(s,8)
    if command!=1 and command!=2:
        return INVALID
    if load(s,32)!=0 or load(s,40)!=0 or load(s,48)!=0 or load(s,56)!=0:
        return INVALID
    if load(s,64)!=0 or load(s,72)!=0 or load(s,80)!=0:
        return INVALID
    if length(o)<64:
        return CAPACITY
    if command==1:
        if length(s)!=96 or load(s,16)!=0:
            return INVALID
        if load(s,24)!=1 and load(s,24)!=2:
            return INVALID
        if length(w)<1024:
            return entropy_short(o,4,1024)
        if get(w,0)==ENTROPY_WORK:
            if get(w,8)!=0 and get(w,8)!=99:
                return INVALID
        else:
            fill_range(w,0,1024,0)
            put(w,0,ENTROPY_WORK)
            put(w,64,1)
            put(w,72,MAXIMUM)
        fill_range(w,8,56,0)
        fill_range(w,96,96,0)
        put(w,96,MAXIMUM)
        put(w,104,MAXIMUM)
        put(w,56,load(s,24))
        put(w,8,1)
    else:
        if length(w)<1024 or get(w,0)!=ENTROPY_WORK:
            return INVALID
        if length(s)>240:
            return INVALID
        if negative(load(s,24))!=0:
            if length(s)!=96 or load(s,24)<MAXIMUM-4094:
                return INVALID
        sequence=load(s,16)
        if get(w,24)!=0:
            if sequence!=get(w,24):
                return INVALID
            copy_in(s,w,96,ENTROPY_REPLY,length(s)-96)
            put(w,32,sequence)
            put(w,40,load(s,24))
            put(w,48,length(s)-96)
            put(w,24,0)
        else:
            if sequence!=get(w,32) or load(s,24)!=get(w,40) or length(s)-96!=get(w,48):
                return INVALID
            at=0
            while at<get(w,48):
                if byte(s,96+at)!=byte(w,ENTROPY_REPLY+at):
                    return INVALID
                at=at+1
    status=NEXT
    while status==NEXT:
        phase=get(w,8)
        if phase<10:
            status=random_flow(o,w)
        else:
            if phase<30:
                status=cache_flow(o,w)
            else:
                if phase<50:
                    status=device_flow(o,w)
                else:
                    status=entropy_finish(o,w)
    return status

def entropy_short(o:mutbuf,kind:u64,size:u64) -> u32:
    fill_range(o,0,64,0)
    put(o,0,ENTROPY_RESPONSE)
    put(o,8,kind)
    put(o,32,size)
    return 64

def entropy_request(w:mutbuf,o:mutbuf,phase:u64,op:u64,a:u64,b:u64,c:u64) -> u64:
    sequence=get(w,16)+1
    if sequence==0:
        return INVALID
    fill_range(o,0,64,0)
    put(o,0,ENTROPY_RESPONSE)
    put(o,8,1)
    put(o,16,sequence)
    put(o,24,op)
    put(o,32,a)
    put(o,40,b)
    put(o,48,c)
    put(w,16,sequence)
    put(w,24,sequence)
    put(w,8,phase)
    return 64

def error_class(number:u64) -> u64:
    if number==1 or number==13:
        return 2
    if number==2:
        return 4
    if number==20:
        return 5
    if number==21:
        return 6
    if number==17:
        return 7
    if number==4:
        return 8
    if number==11 or number==114 or number==115:
        return 9
    if number==32 or number==108:
        return 10
    if number==110:
        return 11
    if number==104:
        return 12
    if number==103:
        return 13
    if number==111:
        return 14
    return 3

def entropy_os_error(w:mutbuf,number:u64,named:u64) -> u64:
    if number==0 or number>4095 or named>1:
        return INVALID
    put(w,128,error_class(number))
    put(w,136,number)
    put(w,144,named)
    put(w,152,0)
    put(w,8,99)
    return NEXT

def entropy_literal(w:mutbuf,code:u64) -> u64:
    if code!=1 and code!=2:
        return INVALID
    klass=16
    if code==2:
        klass=17
    put(w,128,klass)
    put(w,136,0)
    put(w,144,0)
    put(w,152,code)
    put(w,8,99)
    return NEXT

def random_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==1:
        if get(w,64)==0:
            put(w,8,10)
        else:
            put(w,8,2)
        return NEXT
    if phase==2:
        return entropy_request(w,o,3,1,16-get(w,112),0,0)
    if phase==3:
        if result==MAXIMUM-3:
            put(w,8,2)
            return NEXT
        if result==MAXIMUM or result==MAXIMUM-37:
            put(w,64,0)
            put(w,112,0)
            put(w,8,10)
            return NEXT
        if negative(result)!=0:
            return entropy_os_error(w,0-result,0)
        if result>16-get(w,112) or result!=get(w,48):
            return INVALID
        copy_within(w,RANDOM+get(w,112),ENTROPY_REPLY,result)
        put(w,112,get(w,112)+result)
        if get(w,112)==16:
            put(w,8,99)
        else:
            put(w,8,2)
        return NEXT
    return INVALID

def cache_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==10:
        if get(w,72)==MAXIMUM:
            put(w,8,20)
            return NEXT
        return entropy_request(w,o,11,3,get(w,72),0,0)
    if phase==11:
        forget=0
        if negative(result)!=0:
            forget=1
        else:
            if result!=0 or get(w,48)!=144:
                return INVALID
            if get(w,ENTROPY_REPLY)!=get(w,80) or get(w,ENTROPY_REPLY+8)!=get(w,88):
                forget=1
        if forget!=0:
            put(w,8,12)
        else:
            put(w,8,30)
        return NEXT
    if phase==12:
        return entropy_request(w,o,13,6,get(w,72),0,0)
    if phase==13:
        if result!=0 or get(w,48)!=0:
            return INVALID
        put(w,72,MAXIMUM)
        put(w,80,0)
        put(w,88,0)
        put(w,8,20)
        return NEXT
    if phase==20:
        return entropy_request(w,o,21,2,0,0,0)
    if phase==21:
        if result==MAXIMUM-3:
            put(w,8,20)
            return NEXT
        if negative(result)!=0:
            number=0-result
            if number==2 or number==6 or number==19 or number==13:
                return entropy_literal(w,1)
            return entropy_os_error(w,number,1)
        if result>2147483647 or get(w,48)!=0:
            return INVALID
        put(w,96,result)
        put(w,8,22)
        return NEXT
    if phase==22:
        return entropy_request(w,o,23,3,get(w,96),0,0)
    if phase==23:
        if negative(result)!=0:
            entropy_os_error(w,0-result,0)
            put(w,8,24)
            return NEXT
        if result!=0 or get(w,48)!=144:
            return INVALID
        if get(w,72)!=MAXIMUM:
            return INVALID
        put(w,72,get(w,96))
        put(w,96,MAXIMUM)
        put(w,80,get(w,ENTROPY_REPLY))
        put(w,88,get(w,ENTROPY_REPLY+8))
        put(w,8,30)
        return NEXT
    if phase==24:
        return entropy_request(w,o,25,4,get(w,96),0,0)
    if phase==25:
        if get(w,48)!=0:
            return INVALID
        if negative(result)==0 and result!=0:
            return INVALID
        put(w,96,MAXIMUM)
        put(w,8,99)
        return NEXT
    return INVALID

def device_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==30:
        return entropy_request(w,o,31,5,get(w,72),16-get(w,112),0)
    if phase==31:
        if result==MAXIMUM-3:
            put(w,8,30)
            return NEXT
        if negative(result)!=0:
            return entropy_os_error(w,0-result,0)
        if result>16-get(w,112) or result!=get(w,48):
            return INVALID
        if result==0:
            return entropy_literal(w,2)
        copy_within(w,RANDOM+get(w,112),ENTROPY_REPLY,result)
        put(w,112,get(w,112)+result)
        if get(w,112)==16:
            put(w,8,99)
        else:
            put(w,8,30)
        return NEXT
    return INVALID

def entropy_finish(o:mutbuf,w:mutbuf) -> u64:
    if get(w,8)!=99 or get(w,96)!=MAXIMUM:
        return INVALID
    size=16
    message=0
    name=0
    if get(w,56)==2:
        size=32
    if get(w,128)!=0:
        message=0
        if get(w,152)==1:
            message=URANDOM_MISSING_LENGTH
        if get(w,152)==2:
            message=URANDOM_EOF_PREFIX_LENGTH+URANDOM_EOF_SUFFIX_LENGTH+1
            if 16-get(w,112)>=10:
                message=message+1
        name=0
        if get(w,144)!=0:
            name=12
        size=64+message+name
    if length(o)<64+size:
        return entropy_short(o,5,64+size)
    fill_range(o,0,64,0)
    put(o,0,ENTROPY_RESPONSE)
    put(o,16,get(w,16))
    put(o,56,size)
    if get(w,128)!=0:
        put(o,8,3)
        fill_range(o,64,64,0)
        put(o,64,RESPONSE)
        put(o,72,3)
        put(o,80,get(w,16))
        put(o,88,get(w,128))
        put(o,96,get(w,136))
        put(o,104,message)
        put(o,112,get(w,144))
        put(o,120,message+name)
        if get(w,152)==1:
            literal_missing(o,128)
        if get(w,152)==2:
            end=literal_eof_prefix(o,128)
            number=16-get(w,112)
            if number>=10:
                store(o,end,49)
                end=end+1
                number=number-10
            store(o,end,48+number)
            literal_eof_suffix(o,end+1)
        if name!=0:
            literal_urandom(o,128+message)
        return 64
    if get(w,112)!=16:
        return INVALID
    if get(w,56)==1:
        copy_out(w,o,RANDOM,64,16)
    else:
        at=0
        while at<16:
            value=byte(w,RANDOM+at)
            if at==6:
                value=(value&15)|64
            if at==8:
                value=(value&63)|128
            store(o,64+at*2,hex_digit(value>>4))
            store(o,65+at*2,hex_digit(value&15))
            at=at+1
    return 64

def hex_digit(value:u64) -> u64:
    if value<10:
        return 48+value
    return 87+value

def copy_within(w:mutbuf,dst:u64,src:u64,size:u64) -> u64:
    if dst>src and dst<src+size:
        at=size
        while at!=0:
            at=at-1
            store(w,dst+at,byte(w,src+at))
    else:
        at=0
        while at<size:
            store(w,dst+at,byte(w,src+at))
            at=at+1
    return size
