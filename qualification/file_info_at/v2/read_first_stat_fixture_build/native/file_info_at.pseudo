def entry(s:readbuf,o:mutbuf,w:mutbuf) -> u32:
    if length(s)<96 or length(s)>=4294901760:
        return 4294967295
    if load(s,0)!=3544386032370600264 or load(s,88)!=length(s)-96:
        return 4294967295
    command=load(s,8)
    if command!=1 and command!=2:
        return 4294967295
    if length(o)<64:
        return 4294967294
    if command==1:
        if load(s,16)!=0 or load(s,24)!=1 or load(s,32)>2147483647:
            return 4294967295
        if load(s,56)!=0 or load(s,64)!=0 or load(s,72)!=0 or load(s,80)!=0:
            return 4294967295
        count=load(s,40)
        path=load(s,48)
        if count>length(s)-96 or path!=length(s)-96-count:
            return 4294967295
        if utf8(s,96,count)==0 or utf8(s,96+count,path)==0:
            return 4294967295
        at=0
        while at<count:
            if byte(s,96+at)==47:
                return 4294967295
            at=at+1
        needed=required(count,path)
        if needed>=4294901760:
            return 4294967295
        if length(w)<needed:
            return short_header(o,4,needed)
        if get(w,0)==3544386058140404040 and get(w,8)!=99:
            return 4294967295
        fill_range(w,0,4096,0)
        layout(w,count,path)
        put(w,0,3544386058140404040)
        put(w,8,1)
        put(w,56,load(s,32))
        put(w,64,count)
        put(w,72,path)
        put(w,80,18446744073709551615)
        copy_in(s,w,96,get(w,336),count)
        store(w,get(w,336)+count,0)
        copy_in(s,w,96+count,get(w,344),path)
    else:
        if length(w)<4096 or get(w,0)!=3544386058140404040:
            return 4294967295
        if length(w)<get(w,384):
            return short_header(o,4,get(w,384))
        if load(s,32)!=0 or load(s,40)!=0 or load(s,48)!=0 or load(s,56)!=0:
            return 4294967295
        if load(s,64)!=0 or load(s,72)!=0 or load(s,80)!=0:
            return 4294967295
        if length(s)-96>get(w,392):
            return 4294967295
        if negative(load(s,24))!=0 and length(s)!=96:
            return 4294967295
        sequence=load(s,16)
        if get(w,24)!=0:
            if sequence!=get(w,24):
                return 4294967295
            copy_in(s,w,96,get(w,312),length(s)-96)
            put(w,32,sequence)
            put(w,40,load(s,24))
            put(w,48,length(s)-96)
            put(w,24,0)
        else:
            if sequence!=get(w,32) or load(s,24)!=get(w,40) or length(s)-96!=get(w,48):
                return 4294967295
            at=0
            while at<get(w,48):
                if byte(s,96+at)!=byte(w,get(w,312)+at):
                    return 4294967295
                at=at+1
    status=4294967293
    while status==4294967293:
        phase=get(w,8)
        if phase<10:
            status=fingerprint_flow(o,w)
        else:
            if phase<20:
                status=regular_flow(o,w)
            else:
                if phase<30:
                    status=version_flow(o,w)
                else:
                    if phase<90:
                        status=metadata_flow(o,w)
                    else:
                        status=finish(o,w)
    return status

def request_capacity(count:u64) -> u64:
    if count>4268160:
        return count+96
    return 4268160+96

def reply_capacity(count:u64) -> u64:
    if count>4268160:
        return count+64
    return 4268160+64

def error_capacity(count:u64) -> u64:
    if count>448:
        return count+64
    return 512

def required(count:u64,path:u64) -> u64:
    return 4096+count+1+path+request_capacity(count)+reply_capacity(count)+error_capacity(count)+path*6+901024

def layout(w:mutbuf,count:u64,path:u64) -> u64:
    at=4096
    put(w,336,at)
    at=at+count+1
    put(w,344,at)
    at=at+path
    put(w,304,at)
    at=at+request_capacity(count)
    put(w,312,at)
    at=at+reply_capacity(count)
    put(w,320,at)
    at=at+error_capacity(count)
    put(w,328,at)
    put(w,384,required(count,path))
    put(w,392,reply_capacity(count))
    return 0

def short_header(o:mutbuf,kind:u64,needed:u64) -> u32:
    fill_range(o,0,64,0)
    put(o,0,3544386036665567560)
    put(o,8,kind)
    put(o,32,needed)
    return 64

def request(w:mutbuf,o:mutbuf,phase:u64,kind:u64,op:u64,a:u64,b:u64,c:u64,at:u64,size:u64) -> u64:
    if size>length(w) or at>length(w)-size:
        return 4294967295
    if length(o)<64+size:
        return short_header(o,5,64+size)
    sequence=get(w,16)+1
    if sequence==0:
        return 4294967295
    fill_range(o,0,64,0)
    put(o,0,3544386036665567560)
    put(o,8,kind)
    put(o,16,sequence)
    put(o,24,op)
    put(o,32,a)
    put(o,40,b)
    put(o,48,c)
    put(o,56,size)
    copy_out(w,o,at,64,size)
    put(w,16,sequence)
    put(w,24,sequence)
    put(w,8,phase)
    return 64

def fingerprint_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    if phase==1:
        fill_range(w,get(w,304),96,0)
        put(w,get(w,304),3544407975325221448)
        put(w,get(w,304)+8,1)
        put(w,get(w,304)+24,2)
        put(w,get(w,304)+40,get(w,64))
        put(w,get(w,304)+88,get(w,64))
        copy_within(w,get(w,304)+96,get(w,336),get(w,64))
        put(w,8,2)
        return 4294967293
    if phase==2:
        return request(w,o,3,2,1,get(w,56),0,0,get(w,304),96+get(w,64))
    if phase==3:
        if child_frame(w,3544386040927240776,0)==0:
            return 4294967295
        if get(w,get(w,312)+8)==3:
            return nested_error(w,3544386040927240776)
        size=get(w,get(w,312)+56)
        if size>512:
            return 4294967295
        copy_within(w,1024,get(w,312)+64,size)
        put(w,88,size)
        if fingerprint_json(w)==0:
            return 4294967295
        put(w,8,10)
        return 4294967293
    return 4294967295

def number_end(w:mutbuf,at:u64,end:u64,maximum:u64) -> u64:
    if at>=end or byte(w,at)<48 or byte(w,at)>57:
        return 18446744073709551615
    if byte(w,at)==48:
        if at+1<end and byte(w,at+1)>=48 and byte(w,at+1)<=57:
            return 18446744073709551615
        return at+1
    value=0
    while at<end and byte(w,at)>=48 and byte(w,at)<=57:
        digit=byte(w,at)-48
        if value>1844674407370955161:
            return 18446744073709551615
        if value==1844674407370955161 and digit>5:
            return 18446744073709551615
        value=value*10+digit
        if value>maximum:
            return 18446744073709551615
        at=at+1
    return at

def fingerprint_json(w:mutbuf) -> u64:
    end=1024+get(w,88)
    at=match_mode(w,1024,end)
    if at==18446744073709551615:
        return 0
    at=number_end(w,at,end,4095)
    if at==18446744073709551615:
        return 0
    at=match_sha(w,at,end)
    if at==18446744073709551615 or end-at<65:
        return 0
    i=0
    while i<64:
        c=byte(w,at+i)
        if (c<48 or c>57) and (c<97 or c>102):
            return 0
        i=i+1
    at=at+64
    at=match_size(w,at,end)
    if at==18446744073709551615:
        return 0
    at=number_end(w,at,end,18446744073709551615)
    if at==18446744073709551615:
        return 0
    at=match_version(w,at,end)
    if at==18446744073709551615 or end-at<3 or end-at>124:
        return 0
    size=end-at-2
    if byte(w,end-2)!=34 or byte(w,end-1)!=125:
        return 0
    i=0
    while i<size:
        c=byte(w,at+i)
        if c!=45 and c!=58 and (c<48 or c>57):
            return 0
        i=i+1
    copy_within(w,1536,at,size)
    put(w,96,size)
    return 1

def regular_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    result=get(w,40)
    if phase==10:
