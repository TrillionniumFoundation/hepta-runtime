def child_frame(w:mutbuf,magic:u64,op:u64) -> u64:
    size=get(w,48)
    if size<64 or get(w,40)!=size:
        return 0
    if get(w,get(w,312))!=magic or get(w,get(w,312)+56)!=size-64:
        return 0
    kind=get(w,get(w,312)+8)
    if kind==3:
        return 1
    if kind!=0 or get(w,get(w,312)+24)!=op:
        return 0
    if get(w,get(w,312)+32)!=0 or get(w,get(w,312)+40)!=0 or get(w,get(w,312)+48)!=0:
        return 0
    return 1

def nested_error(w:mutbuf,magic:u64) -> u64:
    size=get(w,get(w,312)+56)
    if size+64>error_capacity(get(w,64)):
        return 4294967295
    code=get(w,get(w,312)+24)
    number=get(w,get(w,312)+32)
    message=get(w,get(w,312)+40)
    named=get(w,get(w,312)+48)
    if code<1 or code>14 or number>4095 or message>size:
        return 4294967295
    if named==0:
        if message!=size:
            return 4294967295
    else:
        if magic==3544386040927240776:
            if named!=1 or number==0 or message!=0 or size!=get(w,64):
                return 4294967295
            if equal(w,get(w,312)+64,get(w,336),size)==0:
                return 4294967295
        else:
            if magic!=3544386036883017032 or named!=2 or size-message!=8:
                return 4294967295
            if get(w,get(w,312)+64+message)!=get(w,80):
