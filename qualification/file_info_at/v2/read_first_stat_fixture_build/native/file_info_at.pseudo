        put(w,1792,3544423364495168328)
        put(w,1792+8,1)
        put(w,1792+16,get(w,get(w,312)))
        put(w,1792+24,get(w,get(w,312)+8))
        put(w,1792+32,get(w,get(w,312)+48))
