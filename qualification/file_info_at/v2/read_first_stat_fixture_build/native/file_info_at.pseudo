    put(w,104,size+64)
    put(w,8,90)
    return 4294967293

def value_error(w:mutbuf,code:u64) -> u64:
    fill_range(w,get(w,320),64,0)
    put(w,get(w,320),3544386040927240776)
    put(w,get(w,320)+8,3)
    put(w,get(w,320)+24,1)
    size=0
    if code==1:
        size=literal_regular(w,get(w,320)+64)-get(w,320)-64
    if code==2:
        size=literal_changed(w,get(w,320)+64)-get(w,320)-64
    put(w,get(w,320)+40,size)
    put(w,get(w,320)+56,size)
    put(w,104,size+64)
    put(w,8,90)
    return 4294967293

def os_error(w:mutbuf,number:u64,named:u64) -> u64:
    fill_range(w,get(w,320),64,0)
    put(w,get(w,320),3544386040927240776)
    put(w,get(w,320)+8,3)
    put(w,get(w,320)+24,error_class(number))
    put(w,get(w,320)+32,number)
    put(w,get(w,320)+48,named)
    size=0
    if named!=0:
        size=get(w,64)
        copy_within(w,get(w,320)+64,get(w,336),size)
    put(w,get(w,320)+56,size)
    put(w,104,size+64)
    put(w,8,90)
    return 4294967293

def error_class(number:u64) -> u64:
    if number==1 or number==13:
        return 2
    if number==2:
        return 4
    if number==20:
        return 5
    if number==21:
        return 6
    if number==17:
        return 7
    if number==4:
        return 8
    if number==11 or number==114 or number==115:
        return 9
    if number==32 or number==108:
        return 10
    if number==110:
        return 11
    if number==104:
        return 12
    if number==103:
        return 13
    if number==111:
        return 14
    return 3

def render_result(w:mutbuf,size:u64) -> u64:
    at=wire_path(w,get(w,328))
    at=quoted(w,at,get(w,344),get(w,72))
    store(w,at,44)
    at=at+1
    copy_within(w,at,1024+1,get(w,88)-2)
    at=at+get(w,88)-2
    at=wire_metadata(w,at)
    copy_within(w,at,get(w,312)+64,size)
    at=at+size
    store(w,at,125)
    return at+1-get(w,328)

def finish(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    if phase==90:
        if get(w,80)!=18446744073709551615:
            return request(w,o,91,1,3,get(w,80),0,0,0,0)
        put(w,8,97)
        return 4294967293
    if phase==91:
        if get(w,48)!=0:
            return 4294967295
        put(w,80,18446744073709551615)
        result=get(w,40)
        if negative(result)!=0:
            ignored=os_error(w,0-result,0)
        else:
            if result!=0:
                return 4294967295
        put(w,8,97)
        return 4294967293
    if phase==97 or phase==99:
        size=get(w,112)
        at=get(w,328)
        kind=0
        if get(w,104)!=0:
            size=get(w,104)
            at=get(w,320)
            kind=3
        if length(o)<64+size:
            return short_header(o,5,64+size)
        fill_range(o,0,64,0)
        put(o,0,3544386036665567560)
        put(o,8,kind)
        put(o,16,get(w,16))
        put(o,56,size)
        copy_out(w,o,at,64,size)
        put(w,8,99)
        return 64
    return 4294967295

def negative(value:u64) -> u64:
    if value>=9223372036854775808:
        return 1
    return 0

def equal(w:mutbuf,a:u64,b:u64,size:u64) -> u64:
    at=0
    while at<size:
        if byte(w,a+at)!=byte(w,b+at):
            return 0
        at=at+1
    return 1

def load(s:readbuf,at:u64) -> u64:
    return byte(s,at)|(byte(s,at+1)<<8)|(byte(s,at+2)<<16)|(byte(s,at+3)<<24)|(byte(s,at+4)<<32)|(byte(s,at+5)<<40)|(byte(s,at+6)<<48)|(byte(s,at+7)<<56)

def get(w:mutbuf,at:u64) -> u64:
    return byte(w,at)|(byte(w,at+1)<<8)|(byte(w,at+2)<<16)|(byte(w,at+3)<<24)|(byte(w,at+4)<<32)|(byte(w,at+5)<<40)|(byte(w,at+6)<<48)|(byte(w,at+7)<<56)

def put(w:mutbuf,at:u64,value:u64) -> u64:
    store(w,at,value)
    store(w,at+1,value>>8)
    store(w,at+2,value>>16)
    store(w,at+3,value>>24)
    store(w,at+4,value>>32)
    store(w,at+5,value>>40)
    store(w,at+6,value>>48)
    store(w,at+7,value>>56)
    return 0

def u32_at(w:mutbuf,at:u64) -> u64:
    return byte(w,at)|(byte(w,at+1)<<8)|(byte(w,at+2)<<16)|(byte(w,at+3)<<24)

def copy_in(s:readbuf,w:mutbuf,src:u64,dst:u64,size:u64) -> u64:
    at=0
    while size-at>=8:
        put(w,dst+at,load(s,src+at))
        at=at+8
    while at<size:
        store(w,dst+at,byte(s,src+at))
        at=at+1
    return size

def copy_out(w:mutbuf,o:mutbuf,src:u64,dst:u64,size:u64) -> u64:
    at=0
    while size-at>=8:
        put(o,dst+at,get(w,src+at))
        at=at+8
    while at<size:
        store(o,dst+at,byte(w,src+at))
        at=at+1
    return size

def hex_digit(value:u64) -> u64:
    if value<10:
        return value+48
    return value+87

def quoted(w:mutbuf,at:u64,source:u64,size:u64) -> u64:
    store(w,at,34)
    at=at+1
    i=0
    while i<size:
        c=byte(w,source+i)
        if c==34 or c==92:
            store(w,at,92)
            store(w,at+1,c)
            at=at+2
        else:
            if c==8 or c==9 or c==10 or c==12 or c==13:
                escaped=98
                if c==9:
                    escaped=116
                if c==10:
                    escaped=110
                if c==12:
                    escaped=102
                if c==13:
                    escaped=114
                store(w,at,92)
                store(w,at+1,escaped)
                at=at+2
            else:
                if c<32:
                    store(w,at,92)
                    store(w,at+1,117)
                    store(w,at+2,48)
                    store(w,at+3,48)
                    store(w,at+4,hex_digit(c>>4))
                    store(w,at+5,hex_digit(c&15))
                    at=at+6
                else:
                    store(w,at,c)
                    at=at+1
        i=i+1
    store(w,at,34)
