            return value_error(w,1)
        put(w,8,20)
        return 4294967293
    if phase==14:
        return request(w,o,15,1,4,get(w,80),0,0,0,0)
    if phase==15:
        if result!=0 or get(w,48)!=0:
            return 4294967295
        put(w,80,18446744073709551615)
        put(w,8,97)
        return 4294967293
    return 4294967295

