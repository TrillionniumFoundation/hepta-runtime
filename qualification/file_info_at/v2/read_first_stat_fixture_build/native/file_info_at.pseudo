            return value_error(w,2)
        fill_range(w,get(w,304),96,0)
        put(w,get(w,304),3544386032604826952)
        put(w,get(w,304)+8,1)
        put(w,get(w,304)+24,1)
        put(w,8,30)
        return 4294967293
    return 4294967295

def metadata_flow(o:mutbuf,w:mutbuf) -> u64:
    phase=get(w,8)
    if phase==30:
        return request(w,o,31,2,3,get(w,80),1,0,get(w,304),96)
