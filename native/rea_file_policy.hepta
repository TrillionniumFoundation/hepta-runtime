  v8:u64 = const() {"value":8}
  v9:bool = compare.lt(v7,v8)
  branch v9 b2(v4,v5,v6,v7) b3(v4)
block b2(v10:mutbuf,v11:u64,v12:u64,v13:u64)
  v18:u64 = int.add.wrap(v11,v13)
  v19:u64 = const() {"value":255}
  v20:u64 = bit.and(v12,v19)
  v21:usize = int.cast(v18) {"mode":"wrap"}
  v22:u8 = int.cast(v20) {"mode":"wrap"}
  _ = buffer.store(v10,v21,v22)
  v23:u64 = const() {"value":8}
  v24:u64 = int.shr.checked(v12,v23)
  v25:u64 = const() {"value":1}
  v26:u64 = int.add.wrap(v13,v25)
  jump b1(v10,v11,v24,v26)
block b3(v14:mutbuf)
  v27:u64 = const() {"value":0}
  ret(v27)
end
