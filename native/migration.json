  "native_components": [
    {
      "source": "native/runtime_bytes.hepta",
      "scope": "Byte hashes and line identifiers; strict/clamped signed line indices; log page windows; bounded identity predicates. Borrowed byte ABI; no filesystem or process effects.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/runtime_protocol.hepta",
      "scope": "Strict JSON parsing, MCP 2025-06-18 negotiation and initialization state, native JSON response serialization, runtime_native_info and original line-hash computation. Existing 125 production tool handlers are not provided by this service.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/text_budget.hepta",
      "scope": "Original token estimate, one-decimal MiB formatting, line-ID range rendering and smart head/tail truncation under the retained Rust release semantics.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/line_endpoint.hepta",
      "scope": "Original line-endpoint parsing and exact error formatting at a typed serde Value boundary, including Unicode trim, signed/unsigned integer parsing and N:hh normalization. JSON classification/serialization remains the caller boundary.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/delta.hepta",
      "scope": "Original bounded Myers line diff and exact operation order, delta hunks with line IDs, removal markers, CRLF normalization and Rust line splitting. File access, path authorization and per-session view-cache state remain caller owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/editable_content.hepta",
      "scope": "Internal original EditableContent construction, normalized/rendered bytes, ordered insertion/replacement and trailing-newline preservation. Original complete methods and UTF-8/u64/5 MiB state histories are compared directly. File IO, locking, history, line-id validation and production handler replacement remain separate owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/view_render.hepta",
      "scope": "Internal original view range/render/prepare decisions over independent read snapshots, exact line IDs, cache plan, delta selection and 8 MiB result gate. Complete 5 MiB file and maximum-line workspace domains use an explicit transport profile; actual file reads, session cache storage and production handler replacement remain separate owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/view_filter_packer.hepta",
      "scope": "Static opaque-byte filter for the named view-render.v1 capacity profile: 16 MiB input/output and 256 MiB workspace. Exact native image binding, frame/output refusal and no interpreter/libc dependency; no new OS effect authority or public MCP route.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/binary_codec.hepta",
      "scope": "SHA256 raw/hex and portable incremental state using unchanged pinned HIA compression, canonical Base64 encoding and explicit legacy/current/canonical decode policies. File descriptors, versions, authorization and upload transactions remain original owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/operation_kdf.hepta",
      "scope": "Internal HMAC/HKDF-SHA256, original verified-token key derivation, private request/idempotency/policy bindings and per-record key bytes with workspace clearing. Caller verification, canonical context, non-exportable scope, AEAD, nonce custody, replay and ledger owners remain original; no public MCP key output or production handler replacement.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/operation_aead.hepta",
      "scope": "Internal ChaCha20-Poly1305 encrypt/authenticate-before-decrypt byte primitive with bounded AAD and original inner-payload ceiling. Workspace clearing, unchanged failure output and original seal/open fixture interoperability are explicit test domains. Trusted scope, nonce uniqueness, entropy, record admission, persistence and production call-site replacement remain separate owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/operation_nonce.hepta",
      "scope": "Internal serial NonceLedger reservation over a private persistent workspace: exact 16384-use scope budget, original SHA256 identity namespace and 12-byte nonce keys, bounded collision handling, duplicate refusal and trusted lifecycle clearing. Direct calls and a test-only persistent two-image ELF are separately counted. Entropy, production serialization, shared-clone custody, key lifetime and call-site replacement remain original owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/operation_record.hepta",
      "scope": "Internal trusted-scope result binding and canonical AAD over the complete u128 domain, original bounded seal/open byte composition through existing KDF/SHA/AEAD images, authenticated inner-record validation and declared workspace cleanup. Test-only five-image ELF, typed transport refusals and actual original semantic-owner comparisons are separately counted. Scope capability custody, entropy, nonce reservation, cloning/concurrency and production call-site replacement remain separate owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/entropy_policy.hepta",
      "scope": "Internal Linux x86-64 entropy fill with the original ring/getrandom default backend probe, cached serial direct/device backend, partial-fill advancement, retry/error rules and complete-output publication for 0..128 bytes. Per-workspace custody is serial; cross-thread sharing, whole-runtime dependency-lock identity and production call-site replacement remain separate owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/entropy_packer.hepta",
      "scope": "Static native entropy ELF boundary: fixed 24-byte input frames, checked HIA continuations, opaque fixed-device descriptor cache, output-length admission and explicit EOF cleanup. No raw caller-supplied paths or file descriptors; no MCP registration or production activation.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/operation_scope.hepta",
      "scope": "Internal private serial ResultCryptoScope construction, private bindings, seal/open ordering, shared reference lifetime and joint key/nonce destruction using unchanged HIA KDF/record/nonce owners. Separately mandatory eight-image profiles cover deterministic fixture entropy and actual Linux SystemEntropy; caller authentication, concurrent capability admission and production call-site replacement remain separate owners. Entire predefined fixture fault histories and real OS trace/cleanup domains are accounted independently.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/policy.hepta",
      "scope": "Original deterministic config policy for permission and protection order, executable/environment checks, remote lexical paths, local normalization and path containment. Host/config loading, filesystem canonicalization and effect authorization remain caller owners.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/stat_version.hepta",
      "scope": "Exact original five-field file-version formatting over full stat integer/timestamp domains plus a canonical inverse validated through the unchanged Python formatter. No file I/O, authorization or MCP dispatch.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/io_policy.hepta",
      "scope": "Read-only descriptor custody, bounded chunk/full-file continuations, and complete-file fingerprint/Linux metadata capture with original ordering, separate version intervals, typed guard start/finish and cleanup precedence. A fixed owned-process watchdog supplies the local 30-second deadline. Persistent startup-root custody and local error diagnostics remain explicit differences; no original configured-host or write owner is replaced.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/io_packer.hepta",
      "scope": "HIA construction of a static Linux x86-64 ELF with checked syscall effect records, opaque descriptor handles, bounds validation and persistent binary framing for the read-only IO primitive.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/multi_read_service.hepta",
      "scope": "Native batch-read controller for the explicit native-local profile: original typed validation order, policy-before-effects, independent complete-file results, strict UTF-8, exact nested MCP text budget and redacted failures. Synthetic controller IO controls are distinguished from actual full-read/MCP filesystem comparisons; remote configured-host and production parity remain incomplete.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/file_info_service.hepta",
      "scope": "Explicit native-local file_info controller: original typed parameter and host/path ordering, complete Linux fingerprint/metadata results, exact stat version and compact MCP text, bounded response validation and continuation/capacity refusal. Synthetic IO completions are distinct from actual file, xattr, ACL, deadline and original-helper comparisons. Remote SSH and full production handler parity remain unported.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/local_service.hepta",
      "scope": "Strict JSON MCP controller for explicit administrator-owned native-local host_list, binary_read, read_multiple_files and file_info delegation through a fixed seven-image table. Full original configured-host, SSH, authorization and 125-tool production parity remain incomplete.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/composition_packer.hepta",
      "scope": "Native closed image tables with fixed call authority, private workspaces, bounded child/OS continuations and fixed owned-worker file inspection deadlines. Real entropy effects require the exact eight-image scope profile, native SHA256 binding of every actual image and an exclusive slot-seven policy; ordinary profiles retain their existing authority. No public raw entropy or production scope activation.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/stdio_packer.hepta",
      "scope": "Native ELF construction for persistent LF-delimited stdio framing and Linux system-call transport.",
      "legacy_call_sites_replaced": false
    },
    {
      "source": "native/filter_packer.hepta",
      "scope": "Native ELF construction for a single binary input/output invocation.",
      "legacy_call_sites_replaced": false
    }
