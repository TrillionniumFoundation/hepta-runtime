{"authoring_source":"def get(w:mutbuf, at:u64) -> u64:\n    value = byte(w, at)\n    value = value | (byte(w, at + 1) << 8)\n    value = value | (byte(w, at + 2) << 16)\n    value = value | (byte(w, at + 3) << 24)\n    value = value | (byte(w, at + 4) << 32)\n    value = value | (byte(w, at + 5) << 40)\n    value = value | (byte(w, at + 6) << 48)\n    value = value | (byte(w, at + 7) << 56)\n    return value\n\ndef read64(s:readbuf, at:u64) -> u64:\n    value = byte(s, at)\n    value = value | (byte(s, at + 1) << 8)\n    value = value | (byte(s, at + 2) << 16)\n    value = value | (byte(s, at + 3) << 24)\n    value = value | (byte(s, at + 4) << 32)\n    value = value | (byte(s, at + 5) << 40)\n    value = value | (byte(s, at + 6) << 48)\n    value = value | (byte(s, at + 7) << 56)\n    return value\n\ndef put(w:mutbuf, at:u64, value:u64) -> u64:\n    store(w, at + 0, value >> 0)\n    store(w, at + 1, value >> 8)\n    store(w, at + 2, value >> 16)\n    store(w, at + 3, value >> 24)\n    store(w, at + 4, value >> 32)\n    store(w, at + 5, value >> 40)\n    store(w, at + 6, value >> 48)\n    store(w, at + 7, value >> 56)\n    return 0\n","authoring_source_sha256":"bf36384525d36d05f29f21937c712b477b643456f907bcba73ef7460b281614e","functions":[{"after_sha256":"2145efcbf9dd8aa3401dab33257d0a856fad1281efc82a69225ad642e17c6452","alias":"get","before_sha256":"af852f0d755fe549c717d930685a7147f9b83f80045adf6bec0b60c9bea196cb","function":"f14"},{"after_sha256":"3334e3d57a4c713ddea2e41c64911d7522325cd9f6728145913b2eb7ffa5ba8c","alias":"read64","before_sha256":"6ba6a07df5687b660eaa484d8348dbee8f07e10fe1501e5fb8b4f539860f1c02","function":"f21"},{"after_sha256":"85a579aaab4ea13ba86d67f3e8c6efb72d086fe1e445c02c82c1a9650a3e88c2","alias":"put","before_sha256":"c19d4741ac2927a559a1d0af8444653f7c6361f6015bdb01a49ed331e7761485","function":"f15"}],"input_output_workspace_limits_unchanged":true,"original_allocation_and_error_order_unchanged":true,"original_source":"native/serde_json.hepta"